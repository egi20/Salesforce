# Copy to .env and fill in. Never commit .env.
# Names and meanings only - no real values belong in this file.

NODE_ENV=development
PORT=3000
APP_NAME=Salesforce Hub
APP_BASE_URL=http://localhost:3000
SUPPORT_EMAIL=support@example.com

# --- Database -----------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=salesforce_hub
DB_CONNECTION_LIMIT=10
# TLS to the database. Leave unset for the bundled docker-compose. Set DB_SSL=true for a
# managed MySQL (Aiven and similar) that refuses plain connections, and paste the
# provider's CA certificate into DB_SSL_CA; on one line, write each newline as \n.
# The certificate is always verified: there is no option to skip that.
DB_SSL=
DB_SSL_CA=

# --- Sessions -----------------------------------------------------------------------
# REQUIRED in production. config/config.js refuses to start if this is unset or left at
# the placeholder, because a default-signed session cookie is an account-takeover primitive.
SESSION_SECRET=

# --- Security -----------------------------------------------------------------------
# Cost factor for password hashing. Defaults to 10 in development, 12 in production.
BCRYPT_ROUNDS=

# Cloudflare Turnstile on the registration form. OPT-IN: leave both unset to disable
# the check entirely. Setting only one of the two does not enable it.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Email --------------------------------------------------------------------------
# Resend, over HTTPS, because many hosts block outbound SMTP ports.
# With no key set, emails are logged to stdout instead of sent - fine for development.
RESEND_API_KEY=
EMAIL_FROM=Salesforce Hub <noreply@example.com>

# --- Who is legally responsible for personal data ------------------------------------
# REQUIRED before this site takes real users. The privacy policy has to name a controller —
# a real person or company with an address somebody can write to — and nothing can invent
# that for you. Unset, the policy and the contact page say so plainly and the boot warns.
LEGAL_CONTROLLER_NAME=
LEGAL_CONTROLLER_ADDRESS=
LEGAL_CONTROLLER_COUNTRY=
LEGAL_CONTROLLER_REGISTRATION=
# Where a privacy request goes. Falls back to SUPPORT_EMAIL, because one address somebody
# actually reads beats a second one nobody has set up.
LEGAL_PRIVACY_EMAIL=
# The data protection authority a complaint goes to. Depends on where the controller is.
LEGAL_SUPERVISORY_AUTHORITY=

# --- Finance ------------------------------------------------------------------------
# The legal entity printed on invoices. Env vars rather than an editable settings row:
# an invoice carries a legal entity and a tax number, and changing either should have an
# author and a diff. Address may contain \n for line breaks.
FINANCE_SELLER_NAME=
FINANCE_SELLER_ADDRESS=
FINANCE_SELLER_TAX_ID=
FINANCE_SELLER_EMAIL=
FINANCE_SELLER_IBAN=

# --- Tax advisory -------------------------------------------------------------------
# Where a new advisory enquiry is announced. Unset means nobody is emailed and the enquiry
# waits in /admin/tax-advisory - degraded, not broken. The notice carries an ID and a link
# only, never the enquiry itself: the record has a stated retention period on it, and an
# email copy would be the one copy nobody can delete.
TAX_ADVISORY_NOTIFY=

# --- Rate index ---------------------------------------------------------------------
# Minimum distinct contributors before an aggregate is published. Lowering this below 3
# weakens the privacy floor; do not do it to make a sparse index look fuller.
RATE_MIN_SAMPLE=3

# --- Uploads ------------------------------------------------------------------------
# Scratch directory only. Durable bytes live in MySQL because the host disk is ephemeral.
UPLOAD_TMP_DIR=uploads

# --- Payments -----------------------------------------------------------------------
# Stripe. All three unset means payments are switched OFF: the routes exist, but every
# checkout offers a "not available yet" path instead, exactly as email degrades to
# logging without a Resend key. That is what keeps local development and CI working
# without credentials.
#
# STRIPE_WEBHOOK_SECRET is NOT optional once the other two are set. Without it the
# webhook refuses every delivery rather than trusting an unsigned body, which is the
# right way round: a webhook that trusts its body is an unauthenticated write to the
# money tables. Get it from `stripe listen` locally, or from the endpoint you register
# in the Stripe dashboard.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- In-site assistant --------------------------------------------------------------
# Anthropic. With no key the assistant is switched OFF completely: the widget is not
# rendered into any page and /assistant/chat answers 503. That is what keeps local
# development, CI and `npm run validate-boot` working without credentials.
ANTHROPIC_API_KEY=
# Optional. Defaults to a Haiku model - this is site navigation help, not reasoning work,
# and a larger model costs several times more per answer for a question whose answer is
# already in docs/assistant-knowledge.md.
ASSISTANT_MODEL=

# The spend circuit-breaker, month to date, in USD. 0 disables a cap.
#
# THE GLOBAL CAP IS THE ONLY THING THAT BOUNDS THE BILL. The endpoint is public, because
# most of what it answers is asked before anyone signs up, and rate limiting bounds
# requests per address - five hundred addresses each staying under the per-IP limit still
# produce five hundred times that many paid calls. Set this to a number you would be
# willing to see on an invoice.
AI_MONTHLY_BUDGET_USD=25
# Per signed-in account, so one account cannot eat the global budget on its own.
# Anonymous visitors face the global cap and the rate limiters only.
AI_USER_MONTHLY_BUDGET_USD=2

# List price per MILLION tokens, in USD. These exist to be CHECKED against an invoice,
# not trusted forever: a price that moved makes the circuit-breaker cut off early or late,
# and either way silently. Leave unset to use the values in config/assistant.js.
ASSISTANT_PRICE_INPUT_USD=
ASSISTANT_PRICE_OUTPUT_USD=

# --- AI drafting for quote narratives ------------------------------------------------
# Uses the same ANTHROPIC_API_KEY and the same AI_MONTHLY_BUDGET_USD cap as the assistant:
# one key, one ledger, one number to reconcile with an invoice.
#
# The model defaults to Claude Opus 5 rather than the Haiku the assistant uses. The
# assistant answers "where is the rate index"; this writes paragraphs a consultant puts in
# front of a client under their own name, and it runs a handful of times per quote rather
# than once per page view.
DRAFTING_MODEL=
# List price per MILLION tokens, USD. Here to be CHECKED against an invoice, not trusted.
DRAFTING_PRICE_INPUT_USD=
DRAFTING_PRICE_OUTPUT_USD=

# --- LinkedIn identity verification --------------------------------------------------
# Both unset disables it: no button, and the routes answer "not switched on". Setting only
# ONE of the two fails the boot deliberately - a half-configured integration sends the
# member to LinkedIn and then fails after they have already granted access.
#
# Register the app at https://www.linkedin.com/developers/apps, add the "Sign In with
# LinkedIn using OpenID Connect" product, and set the redirect URL to exactly
#   <APP_BASE_URL>/linkedin/callback
#
# Scopes requested: openid profile email. Deliberately NOT w_member_social - this site
# never posts to LinkedIn and asking for permission to publish as somebody, in order to
# check who they are, is far more than the task needs.
#
# WHAT THIS CAN AND CANNOT VERIFY: LinkedIn's userinfo response contains a subject, a name,
# a picture, a locale and an email. It does NOT contain the member's vanity URL, headline,
# positions or employer, and no scope available to an ordinary app returns them. So the
# badge confirms that someone controls a LinkedIn account and nothing more. Do not reword
# it into something broader.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
