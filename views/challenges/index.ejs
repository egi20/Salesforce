<%- include('../partials/layout-start') %>

<%
  /*
   * The challenges hub. Every card is the same engine — marked on the server, one attempt a
   * day, the same set for everybody — so a card only says what it covers and whether it has
   * been played today. The floating terms in the hero are decoration (aria-hidden), not
   * content.
   */
  const doneLabel = function (slug) {
    const p = played.get(slug);
    return p ? 'Done today · ' + p.score + '/' + p.total : null;
  };
  const featuredDone = doneLabel(featured.slug);
  const terms = ['Apex', 'LWC', 'Flow', 'SOQL', 'Data Cloud', 'Agentforce', 'CPQ', 'Omni-Channel', 'Sharing', 'Trust Layer'];
%>
<section class="hub-hero challenges-hero">
  <div class="container">
    <div class="row align-items-center g-4">
      <div class="col-lg-7">
        <span class="hub-hero-badge mb-3"><i class="bi bi-stars"></i> New challenges every day</span>
        <h1>Daily challenges</h1>
        <p class="lead">Test your Salesforce knowledge — the same set for everybody, a new one at midnight UTC.</p>
        <a class="btn btn-outline-light mt-2" href="/dashboard"><i class="bi bi-arrow-left"></i> Back to dashboard</a>
      </div>
      <div class="col-lg-5 d-none d-lg-block" aria-hidden="true">
        <div class="challenges-terms">
          <% terms.forEach(function (t, i) { %><span class="challenges-term t<%= i %>"><%= t %></span><% }); %>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="glass-section pb-5">
<div class="container">
  <%- include('../partials/flash') %>

  <div class="row g-4">
    <div class="col-lg-8">

      <%
        /*
         * Each card is a full gradient with white text, every stop held to 4.5:1 by a test.
         * The card is a flex column and its body grows, so the action row sits at the bottom
         * whether the description takes one line or two.
         */
      %>
      <article class="challenge-card challenge-tone-<%= featured.tone %> challenge-featured mb-4">
        <div class="challenge-card-body d-flex flex-wrap align-items-center gap-3">
          <span class="challenge-icon challenge-icon-lg"><i class="bi <%= featured.icon %>"></i></span>
          <div class="flex-grow-1 min-w-0">
            <span class="challenge-kicker">Featured</span>
            <h2 class="h4 mb-1"><%= featured.title %> — <%= questionsPerDay %> questions</h2>
            <p class="mb-0"><%= featured.blurb %> None of them is in today's topic sets.</p>
          </div>
          <div class="d-flex flex-wrap align-items-center gap-2">
            <% if (featuredDone) { %>
              <span class="challenge-done"><i class="bi bi-check2-circle"></i> <%= featuredDone %></span>
              <a class="btn btn-light btn-sm" href="/challenges/<%= featured.slug %>">See result</a>
            <% } else { %>
              <a class="btn btn-light" href="/challenges/<%= featured.slug %>"><i class="bi bi-play-fill"></i> Play</a>
            <% } %>
          </div>
        </div>
      </article>

      <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-3">
        <h2 class="h5 mb-0">Topic challenges</h2>
        <p class="small text-muted-2 mb-0"><%= questionsPerDay %> questions a day each · <%= pointsPerCorrect %> point per correct answer · one attempt</p>
      </div>
      <div class="row g-3">
        <% topics.forEach(function (t) { const done = doneLabel(t.slug); %>
          <div class="col-md-6">
            <article class="challenge-card challenge-tone-<%= t.tone %> h-100">
              <div class="challenge-card-body">
                <div class="d-flex align-items-center gap-3 mb-2">
                  <span class="challenge-icon"><i class="bi <%= t.icon %>"></i></span>
                  <h3 class="h6 mb-0"><%= t.title %></h3>
                </div>
                <p class="small mb-3"><%= t.blurb %></p>
                <div class="challenge-card-actions">
                  <% if (done) { %>
                    <span class="challenge-done"><i class="bi bi-check2-circle"></i> <%= done %></span>
                    <a class="btn btn-sm btn-light ms-auto" href="/challenges/<%= t.slug %>">See result</a>
                  <% } else { %>
                    <a class="btn btn-sm btn-light ms-auto" href="/challenges/<%= t.slug %>" aria-label="Play <%= t.title %>"><i class="bi bi-play-fill"></i> Play</a>
                  <% } %>
                </div>
              </div>
            </article>
          </div>
        <% }); %>
      </div>

      <div class="glass-card mt-4"><div class="card-body">
        <h2 class="h6 mb-2">How it works</h2>
        <p class="small text-muted-2 mb-0">
          Each set is chosen by the date from a bank of <%= bankSize %> questions, so it is the same
          for everyone and the same on a reload. Answers are marked on the server — the page you
          answer on does not know which option is correct — and the explanations are shown once
          you submit. Each correct answer is worth <%= pointsPerCorrect %> point, deliberately the
          smallest award on the site.
        </p>
      </div></div>
    </div>

    <div class="col-lg-4">
      <%- include('_sidebar', { showResources: true }) %>
    </div>
  </div>
</div>
</section>

<%- include('../partials/layout-end') %>
