<%- include('../partials/layout-start') %>

<div class="container py-4">
  <%- include('../partials/flash') %>

  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
        <div class="d-flex gap-3 align-items-center">
          <img class="avatar" src="<%= other && (other.profile_picture || other.logo) || '/images/avatar-placeholder.svg' %>" alt="">
          <div>
            <p class="text-muted-2 mb-1 small"><a href="/messages">Messages</a></p>
            <h1 class="h5 mb-0"><%= other ? other.display_name : 'Conversation' %></h1>
          </div>
        </div>
        <div class="text-end">
          <span class="badge-hub <%= conversation.kind === 'application' ? 'cloud' : '' %>"><%= conversation.kind %></span>
          <% if (conversation.application_status) { %>
            <span class="badge-hub status-<%= conversation.application_status %>"><%= conversation.application_status %></span>
          <% } %>
        </div>
      </div>

      <% if (conversation.job_slug) { %>
        <div class="glass-card mb-3">
          <div class="card-body py-2 d-flex justify-content-between align-items-center gap-2">
            <span class="small text-muted-2">
              About <a href="/jobs/<%= conversation.job_slug %>"><%= conversation.job_title %></a>
            </span>
            <% if (conversation.application_id) { %>
              <a class="btn btn-sm btn-outline-primary" href="/applications/<%= conversation.application_id %>">Open application</a>
            <% } %>
          </div>
        </div>
      <% } %>

      <div class="glass-card mb-3">
        <div class="card-body">
          <% if (messages.length === 0) { %>
            <div class="empty-state py-4"><i class="bi bi-chat"></i>No messages yet. Say hello.</div>
          <% } else { %>
            <% messages.forEach(function (m) { %>
              <% const mine = m.sender_user_id === currentUser.id; %>
              <div class="d-flex mb-3 <%= mine ? 'justify-content-end' : '' %>">
                <div class="msg-column">
                  <div class="small text-muted-2 mb-1 <%= mine ? 'text-end' : '' %>">
                    <%= mine ? 'You' : m.sender_name %> ·
                    <%= new Date(m.created_at).toISOString().slice(0, 16).replace('T', ' ') %>
                  </div>
                  <div class="msg-bubble <%= mine ? 'msg-bubble-mine' : '' %>">
                    <%= m.body %>
                  </div>
                </div>
              </div>
            <% }); %>
          <% } %>
        </div>
      </div>

      <form method="post" action="/messages/<%= conversation.id %>/reply" class="glass-card">
        <div class="card-body">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label class="form-label" for="body">Reply</label>
          <textarea class="form-control mb-2" id="body" name="body" rows="4" required
                    maxlength="<%= maxLength %>" placeholder="Write a message"></textarea>
          <div class="d-flex justify-content-between align-items-center">
            <p class="form-text mb-0">Plain text. Up to <%= maxLength.toLocaleString('en-GB') %> characters.</p>
            <button class="btn btn-primary" type="submit">Send</button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/layout-end') %>
