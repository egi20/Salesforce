<%- include('../partials/layout-start') %>

<%- include('../partials/page-header', { icon: 'bi-clock-history', heading: 'Your quotes', sub: 'Every estimate you have saved, each with its SOW pack.' }) %>

<%
  /*
   * A status is stored lower-case ('draft'); it is shown as a word ("Draft"). `hasAny` is
   * whether this account has saved a quote at all — the filters and the table mean nothing
   * before the first one, so that case gets a card that says what the page is for instead.
   */
  const statusLabel = (s) => String(s || '').charAt(0).toUpperCase() + String(s || '').slice(1);
  const hasAny = stats.length > 0;
%>
<section class="glass-section pb-5">
<div class="container">
  <%- include('../partials/flash') %>

  <% if (!hasAny) { %>
    <div class="glass-card mb-4"><div class="card-body d-flex flex-wrap align-items-center gap-3">
      <span class="icon-tile icon-navyblue"><i class="bi bi-calculator"></i></span>
      <div class="quotes-empty-text">
        <h2 class="h5 mb-1">You have not saved a quote yet</h2>
        <p class="text-muted-2 mb-0">Every estimate you save appears here with its man-days, budget and timeline, and the SOW pack — .docx, .xlsx and .pptx — is a click away from each one.</p>
      </div>
      <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-primary" href="/quotes/new#wizard"><i class="bi bi-plus-lg"></i> Start new quote</a>
        <a class="btn btn-outline-primary" href="/services/document-generator">What is in the SOW pack</a>
      </div>
    </div></div>
  <% } %>

  <% if (stats.length) { %>
    <div class="row g-3 mb-4">
      <% stats.forEach(function (s) { %>
        <div class="col-6 col-lg-3">
          <div class="stat-tile">
            <div class="value"><%= s.count %></div>
            <div class="label"><%= statusLabel(s.status) %> · <%= Math.round(Number(s.value)).toLocaleString('en-GB') %></div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>

  <% if (hasAny) { %>
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <ul class="nav nav-pills">
      <li class="nav-item"><a class="nav-link <%= status === '' ? 'active' : '' %>" href="/quotes">All</a></li>
      <% statuses.forEach(function (s) { %>
        <li class="nav-item"><a class="nav-link <%= status === s ? 'active' : '' %>" href="/quotes?status=<%= s %>"><%= statusLabel(s) %></a></li>
      <% }); %>
    </ul>
    <a class="btn btn-primary" href="/quotes/new#wizard"><i class="bi bi-plus-lg"></i> Start new quote</a>
  </div>

  <% if (quotes.length === 0) { %>
    <%# Only reachable through a status filter: with no quotes at all the card above shows instead. %>
    <div class="empty-state glass-card">
      <i class="bi bi-funnel"></i>
      <p class="fw-semibold mb-1">No quotes are <%= statusLabel(status) %>.</p>
      <a href="/quotes">Show all quotes</a>
    </div>
  <% } else { %>
    <div class="table-responsive glass-card">
      <table class="table align-middle mb-0">
        <thead>
          <tr>
            <th>Reference</th><th>Client</th><th>Project</th>
            <th class="text-end">Days</th><th class="text-end">Budget</th><th class="text-end">Weeks</th>
            <th>Status</th><th>Created</th>
          </tr>
        </thead>
        <tbody>
          <% quotes.forEach(function (q) { %>
            <tr>
              <td><a href="/quotes/<%= q.reference %>"><code><%= q.reference %></code></a></td>
              <td><%= q.client_company %></td>
              <td class="text-muted-2"><%= q.project_name %></td>
              <td class="text-end"><%= q.total_man_days %></td>
              <td class="text-end"><%= Math.round(Number(q.total_budget)).toLocaleString('en-GB') %> <%= q.currency %></td>
              <td class="text-end"><%= q.duration_weeks %></td>
              <td><span class="badge-hub <%= q.status === 'accepted' ? 'ok' : (q.status === 'declined' ? 'danger' : '') %>"><%= statusLabel(q.status) %></span></td>
              <td class="small text-muted-2"><%= new Date(q.created_at).toISOString().slice(0, 10) %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <%- include('../partials/pagination') %>
  <% } %>
  <% } %>
</div>
</section>

<%- include('../partials/layout-end') %>
