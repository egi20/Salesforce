<%- include('partials/layout-start') %>

<%
  /*
   * /about. Every claim on this page is checkable: the tiles are counts of rows that exist
   * (a zero is hidden, never printed), the stories are consented ones from this site's own
   * users, the team's bios show in production only once approved (config/team.js), and
   * "What we stand for" lists rules the code enforces. If one stops being true, this page is
   * wrong and changes with it.
   */
  const fmt = function (n) { return Number(n).toLocaleString('en-GB'); };
  const signedIn = typeof currentUser !== 'undefined' && currentUser;
%>

<section class="hub-hero about-hero">
  <div class="container">
    <div class="row align-items-center g-5">
      <div class="col-lg-7">
        <span class="hub-hero-badge mb-3"><i class="bi bi-info-circle"></i> ABOUT <%= appName.toUpperCase() %></span>
        <h1>Where Salesforce <span class="hero-accent">talent meets opportunity</span></h1>
        <p class="lead">
          <%= appName %> connects Salesforce consultants with the companies that need them — a specialist
          job board, a consultant directory, and tools for CVs, day rates and project quotes. All in one hub.
        </p>
        <div class="d-flex flex-wrap gap-2 mt-4">
          <a class="btn btn-light btn-lg" href="/jobs"><i class="bi bi-search"></i> Find Salesforce work</a>
          <a class="btn btn-outline-light btn-lg" href="/consultants"><i class="bi bi-people"></i> Hire Salesforce talent</a>
        </div>
      </div>
      <%# Decorative: the brand mark on its tile. Hidden from assistive tech. %>
      <div class="col-lg-5 d-none d-lg-flex justify-content-center" aria-hidden="true">
        <div class="hub-hero-art">
          <span class="hub-hero-glow"></span>
          <span class="hub-hero-tile"><img src="/images/logo-mark.svg" alt="" width="150" height="150"></span>
          <span class="hub-hero-chip chip-a"><i class="bi bi-briefcase"></i></span>
          <span class="hub-hero-chip chip-b"><i class="bi bi-person-badge"></i></span>
          <span class="hub-hero-chip chip-c"><i class="bi bi-graph-up-arrow"></i></span>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="glass-section pb-5">
<div class="container">

  <%# 2. Everything in one place %>
  <div class="text-center mb-4">
    <h2 class="h3 mb-1">Everything you need in one place</h2>
    <p class="text-muted-2 mb-0">For the people doing the work, the companies hiring them, and the projects in between.</p>
  </div>
  <div class="row g-4 mb-5">
    <% [
      { icon: 'bi-person-badge', tone: 'icon-blue', title: 'Consultant Hub', href: '/consultant-hub', items: ['Find jobs', 'Build your profile', 'CV Generator', 'Rate & Salary Index'] },
      { icon: 'bi-building', tone: 'icon-navy', title: 'Companies Hub', href: '/companies-hub', items: ['Browse talent', 'Post a role', 'Engagement models'] },
      { icon: 'bi-tools', tone: 'icon-violet', title: 'Tools & services', href: '/quotes/new', items: ['SOW quote & pack', 'Contract rate calculator', 'Tax optimization'] }
    ].forEach(function (c) { %>
      <div class="col-md-4">
        <div class="glass-card h-100"><div class="card-body p-4 d-flex flex-column">
          <span class="icon-tile <%= c.tone %> mb-3"><i class="bi <%= c.icon %>"></i></span>
          <h3 class="h5"><%= c.title %></h3>
          <ul class="list-unstyled about-checks mb-4">
            <% c.items.forEach(function (i) { %><li><i class="bi bi-check2-circle"></i> <%= i %></li><% }); %>
          </ul>
          <a class="btn btn-outline-primary mt-auto align-self-start" href="<%= c.href %>">Explore <i class="bi bi-arrow-right"></i></a>
        </div></div>
      </div>
    <% }); %>
  </div>

  <%# 3. Platform numbers — only tiles with something to count. %>
  <% if (tiles.length) { %>
    <div class="about-stats mb-5">
      <% tiles.forEach(function (t) { %>
        <% if (t.href) { %><a class="glass-card about-stat" href="<%= t.href %>"><% } else { %><div class="glass-card about-stat"><% } %>
          <i class="bi <%= t.icon %>"></i>
          <span class="about-stat-value"><%= fmt(t.value) %></span>
          <span class="about-stat-label"><%= t.label %></span>
        <% if (t.href) { %></a><% } else { %></div><% } %>
      <% }); %>
    </div>
  <% } %>

  <%# 4. How it works %>
  <div class="text-center mb-4"><h2 class="h3 mb-1">How it works</h2></div>
  <div class="row g-4 mb-5">
    <% [
      { who: 'For consultants', icon: 'bi-person-badge', steps: [
          ['Create your free profile', 'Fill it in, or import your CV and tick what to keep.'],
          ['Apply to Salesforce roles that fit', 'Each role shows how well it matches your profile, and your CV comes from what you entered.'],
          ['Get hired — and keep more of your rate', 'Optionally, through our Albania employment programme (Tax optimization).']
        ], cta: { label: 'Start free', href: signedIn ? '/profile/settings' : '/auth/register' } },
      { who: 'For companies', icon: 'bi-building', steps: [
          ['Post your role — free', 'Contract or permanent, with the clouds, seniority and rate you have in mind.'],
          ['Browse and message consultants', 'Filter by cloud, certification, availability and rate, then approach them about your role.'],
          ['Hire on your terms', 'Or scope the work first with a SOW quote and its document pack.']
        ], cta: { label: 'Browse talent', href: '/consultants' } }
    ].forEach(function (col) { %>
      <div class="col-lg-6">
        <div class="glass-card h-100"><div class="card-body p-4 d-flex flex-column">
          <h3 class="h5 mb-4"><i class="bi <%= col.icon %> text-primary"></i> <%= col.who %></h3>
          <ol class="list-unstyled about-steps mb-4">
            <% col.steps.forEach(function (s, i) { %>
              <li><span class="about-step-n"><%= i + 1 %></span><div><div class="fw-semibold"><%= s[0] %></div><p class="small text-muted-2 mb-0"><%= s[1] %></p></div></li>
            <% }); %>
          </ol>
          <a class="btn btn-primary mt-auto align-self-start" href="<%= col.cta.href %>"><%= col.cta.label %></a>
        </div></div>
      </div>
    <% }); %>
  </div>

  <%# 5. Real stories — consented, from this site's own users; nothing rendered without one. %>
  <% if (stories.length) { %>
    <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-3">
      <h2 class="h3 mb-0">Real stories</h2>
      <a class="small" href="/success-stories/reviews">Leave a review</a>
    </div>
    <div class="row g-4 mb-5">
      <% stories.forEach(function (s) { %>
        <div class="col-md-6 col-lg-4">
          <figure class="glass-card h-100 mb-0"><div class="card-body p-4">
            <% if (s.quote) { %><blockquote class="mb-3"><p class="mb-0">“<%= s.quote %>”</p></blockquote><% } %>
            <figcaption class="d-flex align-items-center gap-2">
              <span class="logo-initials tone-2" aria-hidden="true"><%= s.initials %></span>
              <span><span class="fw-semibold d-block"><%= s.name %></span><span class="small text-muted-2"><%= s.role %><% if (s.country) { %> · <%= s.country %><% } %></span></span>
            </figcaption>
          </div></figure>
        </div>
      <% }); %>
    </div>
  <% } %>

  <div class="row g-4 mb-5">
    <%# 6. Mission %>
    <div class="col-12">
      <div class="glass-card"><div class="card-body p-4">
        <h2 class="h4 mb-3">Our mission</h2>
        <p>
          <%= appName %> is the Salesforce sister platform of Dynamics Hub, built by the same team:
          specialist roles and talent for one ecosystem, honest data, and a legal, transparent way for
          consultants to keep more of what they earn.
        </p>
        <ul class="list-unstyled about-values row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-2 mb-0">
          <li class="col"><span class="about-value"><i class="bi bi-eye"></i> Transparency in every figure</span></li>
          <li class="col"><span class="about-value"><i class="bi bi-gem"></i> Quality over quantity</span></li>
          <li class="col"><span class="about-value"><i class="bi bi-person-check"></i> Independent professionals first</span></li>
          <li class="col"><span class="about-value"><i class="bi bi-shield-lock"></i> Your data stays yours</span></li>
        </ul>
      </div></div>
    </div>

    <%# 7. Founder & team — bios only once approved (config/team.js). %>
    <div class="col-12">
      <div class="glass-card"><div class="card-body p-4">
        <h2 class="h4 mb-3">Founder &amp; team</h2>
        <p class="small text-muted-2">The same people behind Dynamics Hub.</p>
        <div class="row row-cols-1 row-cols-md-2 g-4">
          <% team.forEach(function (m) { %>
            <div class="col d-flex gap-3 align-items-start about-member">
              <% if (m.photo) { %><img class="about-avatar" src="<%= m.photo %>" alt="<%= m.name %>" width="64" height="64">
              <% } else { %><span class="about-avatar about-avatar-initials" aria-hidden="true"><%= m.initials %></span><% } %>
              <div>
                <div class="fw-semibold"><%= m.name %>
                  <% if (m.linkedin) { %><a class="ms-1" href="<%= m.linkedin %>" target="_blank" rel="noopener noreferrer" aria-label="<%= m.name %> on LinkedIn"><i class="bi bi-linkedin"></i></a><% } %>
                </div>
                <div class="small text-primary fw-semibold mb-1"><%= m.role %></div>
                <% if (m.bio) { %>
                  <p class="small text-muted-2 mb-0"><%= m.bio %></p>
                  <% if (m.draft && showDevNotes) { %><span class="badge-hub warn mt-1">Draft — awaiting <%= m.name.split(' ')[0] %>'s approval; hidden in production</span><% } %>
                <% } %>
              </div>
            </div>
          <% }); %>
        </div>
      </div></div>
    </div>
  </div>

  <%
    /*
     * 8. What we stand for. Each one is a rule enforced in the code, and each is here because
     * the obvious alternative is what most sites in this shape do.
     */
    const stands = [
      ['We run an employment programme, but we don’t give tax advice',
       'Our Albania employment programme is a real payroll, and its calculator shows what that payroll would pay you — indicatively. It is not advice about your own tax: your home-country obligations still apply, and the people to ask are an advisor in your country.',
       'bi-slash-circle'],
      ['A rate bucket with fewer than three contributors is not published',
       'You see the contributor count and no figures. Every figure counts one person rather than one submission, and a month below the threshold is drawn as a gap rather than as a zero — interpolating across it would invent data about a small enough group to identify.',
       'bi-people'],
      ['Your CV is built from what you entered — nothing is invented in your name',
       'Your CV and rate card are formatted from your profile and nothing else: no generated summary, no rephrasing. Where a model does draft anything — the narrative sections of a quote — you edit it and accept it before a client ever sees it, and it is never handed a figure to repeat.',
       'bi-pencil'],
      ['CVs you upload are only passed, unchanged, to companies you apply to',
       'An uploaded CV is checked when you upload it and stored as you gave it. It is downloadable by you and by the company you send it with an application — nobody else. Import from CV is the one other use, and only when you ask: the file you choose there is read once to fill in your profile, its text goes to our AI provider, and the file is not kept.',
       'bi-file-earmark-lock'],
      ['We never send messages pretending to be you',
       'Emails from this site come from ' + appName + ', as ' + appName + ' — that somebody replied, or that an application moved. There is no outreach queue and no automated connection request; where a message is drafted, a person sends it from their own mail client and records that they did.',
       'bi-send-slash'],
      ['Moderation hides, it does not delete',
       'A hide is reversible and leaves an entry saying who did it and why. The exception is a support enquiry, where deletion is what was promised on the form — and that one is on a published retention clock.',
       'bi-eye-slash']
    ];
  %>
  <div class="glass-card mb-4"><div class="card-body p-4">
    <h2 class="h4 mb-4">What we stand for</h2>
    <div class="row g-4">
      <% stands.forEach(function (r) { %>
        <div class="col-md-6 d-flex gap-3">
          <span class="icon-tile icon-tile-sm icon-blue flex-shrink-0"><i class="bi <%= r[2] %>"></i></span>
          <div>
            <div class="fw-semibold"><%= r[0] %></div>
            <p class="small text-muted-2 mb-0"><%= r[1] %></p>
          </div>
        </div>
      <% }); %>
    </div>
  </div></div>

  <div class="row g-4 mb-4">
    <%# 9. Not affiliated — kept as it was. %>
    <div class="col-lg-6">
      <div class="glass-card h-100"><div class="card-body p-4">
        <h2 class="h5 mb-3">Not affiliated with Salesforce, Inc.</h2>
        <p class="mb-0">
          Salesforce, Sales Cloud, Service Cloud, Agentforce, MuleSoft, Tableau and the other
          product names used here are trademarks of Salesforce, Inc. This site is independent:
          it is not endorsed by, sponsored by or connected to Salesforce, Inc., and it carries
          none of their marks. The mark in the header is our own.
        </p>
      </div></div>
    </div>

    <%#
      10. Who runs it — from config/legal.js (LEGAL_CONTROLLER_* environment variables), never
      typed here. Unset: a warning in development, and nothing at all in production, because a
      placeholder company on a public page is worse than an absent one (the boot log warns).
    %>
    <% if (legal.isConfigured() || showDevNotes) { %>
      <div class="col-lg-6">
        <div class="glass-card h-100"><div class="card-body p-4">
          <h2 class="h5 mb-3">Who runs it</h2>
          <% if (legal.isConfigured()) { %>
            <p class="mb-1"><strong><%= legal.controller.name %></strong></p>
            <% if (legal.controller.address) { %><p class="small text-muted-2 mb-2 about-address"><%= legal.controller.address %><% if (legal.controller.country) { %>, <%= legal.controller.country %><% } %></p><% } %>
            <% if (legal.controller.registration) { %><p class="small mb-1"><span class="text-muted-2">Registration number (NIPT):</span> <%= legal.controller.registration %></p><% } %>
            <p class="small mb-0"><span class="text-muted-2">Contact:</span> <a href="mailto:<%= legal.controller.privacyEmail || supportEmail %>"><%= legal.controller.privacyEmail || supportEmail %></a></p>
          <% } else { %>
            <div class="alert alert-warning mb-0 small">
              <strong>Development only: the operator is not set.</strong>
              Set <code>LEGAL_CONTROLLER_NAME</code>, <code>LEGAL_CONTROLLER_ADDRESS</code>,
              <code>LEGAL_CONTROLLER_COUNTRY</code> and <code>LEGAL_CONTROLLER_REGISTRATION</code> (the NIPT)
              from the company's official documents. In production this card is left out until they are.
            </div>
          <% } %>
        </div></div>
      </div>
    <% } %>
  </div>

  <%# 11. Where to go next — kept. %>
  <div class="glass-card"><div class="card-body p-4">
    <h2 class="h5 mb-3">Where to go next</h2>
    <div class="d-flex flex-wrap gap-2">
      <a class="btn btn-primary" href="/auth/register">Create an account</a>
      <a class="btn btn-outline-primary" href="/faq">Frequently asked questions</a>
      <a class="btn btn-outline-primary" href="/contact">Contact</a>
      <a class="btn btn-outline-primary" href="/report-issue">Report a problem</a>
    </div>
  </div></div>

</div>
</section>

<%- include('partials/layout-end') %>
