<%
  /*
   * The in-site assistant.
   *
   * Rendered only when an API key is configured. Not hidden with CSS, not disabled with a
   * flag the client could flip — simply not emitted, so a deployment without credentials
   * has no launcher to click and no endpoint to discover from the markup.
   *
   * Behaviour is in /js/assistant.js. The one thing that MUST stay out of that file is
   * how a reply is rendered: model output is built from DOM nodes only, never innerHTML.
   *
   * The launcher is the Hub's own robot mascot (ported from SAP Hub's), with a small "AI"
   * tag on it so nobody mistakes it for decoration, and its head is the panel's avatar.
   * Both images are DECORATIVE — alt="" — because the button's aria-label already names
   * what it opens, and a screen reader announcing "robot" first says nothing useful. Each
   * URL carries `assetVersion`, so a new mascot is not hidden behind a week of cache.
   */
  const v = typeof assetVersion !== 'undefined' ? assetVersion : '';
%>
<div class="sf-assistant" data-assistant>
  <%# Dynamics Hub's first-visit greeting: shown once, so nobody takes the robot for decoration. %>
  <div class="sf-assistant-teaser" data-assistant-teaser hidden>
    <button type="button" class="sf-assistant-teaser-close" data-assistant-teaser-close aria-label="Dismiss">
      <i class="bi bi-x" aria-hidden="true"></i>
    </button>
    <strong>Hi, I'm Sorca!</strong><br>Salesforce Hub's AI assistant — ask me anything about the site.
  </div>
  <button type="button" class="sf-assistant-launcher" data-assistant-launcher
          aria-label="Open Sorca, the AI Hub Assistant" aria-expanded="false" aria-controls="sfAssistantPanel">
    <img class="sf-assistant-launcher-img" src="/images/sf-assistant.webp?v=<%= v %>" alt="" width="59" height="78" decoding="async">
    <span class="sf-assistant-launcher-tag" aria-hidden="true">AI</span>
  </button>

  <div class="sf-assistant-panel" id="sfAssistantPanel" data-assistant-panel role="dialog"
       aria-label="Sorca, the Hub Assistant" hidden>
    <div class="sf-assistant-header">
      <img class="sf-assistant-avatar" src="/images/sf-assistant-head.webp?v=<%= v %>" alt="" width="40" height="40">
      <span class="sf-assistant-title">
        Sorca <span class="sf-assistant-sub">Hub Assistant</span>
        <span class="badge-hub cloud">AI</span>
      </span>
      <button type="button" class="sf-assistant-close" data-assistant-close aria-label="Close Hub Assistant">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>

    <div class="sf-assistant-messages" data-assistant-messages aria-live="polite"></div>

    <div class="sf-assistant-chips" data-assistant-chips>
      <button type="button" class="sf-assistant-chip">How do I get started?</button>
      <button type="button" class="sf-assistant-chip">What does Salesforce Hub cost?</button>
      <button type="button" class="sf-assistant-chip">How does the SOW generator work?</button>
    </div>

    <%
      /*
       * data-no-guard: the global submit guard in /js/main.js disables the button and
       * relabels it "Working…" on submit, which is right for a page-navigating form and
       * wrong for one that stays put and sends many messages.
       */
    %>
    <form class="sf-assistant-form" data-assistant-form data-no-guard="true" autocomplete="off">
      <label class="visually-hidden" for="sfAssistantInput">Message Hub Assistant</label>
      <input class="sf-assistant-input" id="sfAssistantInput" data-assistant-input type="text"
             placeholder="Ask about Salesforce Hub..." maxlength="<%= assistantMaxChars %>">
      <button class="sf-assistant-send" type="submit" aria-label="Send message">
        <i class="bi bi-send-fill"></i>
      </button>
    </form>

    <%# Dynamics Hub's wording. It points at the Contact page rather than printing an address,
        so the one place the support address is shown is the page that explains how to ask. %>
    <p class="sf-assistant-footnote">AI assistant &mdash; may make mistakes. For account issues use <a href="/contact">Contact</a>.</p>
  </div>
</div>
