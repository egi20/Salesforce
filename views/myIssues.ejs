<%- include('partials/layout-start') %>
<%- include('partials/page-header', { icon: 'bi-list-check', heading: 'Your reports', sub: 'What you told us, and what was said back.' }) %>
<section class="glass-section pb-5"><div class="container">
  <div class="row justify-content-center"><div class="col-lg-8">
    <%- include('partials/flash') %>

    <div class="mb-3">
      <a class="btn btn-primary btn-sm" href="/report-issue">Report something new</a>
    </div>

    <% if (!issues.length) { %>
      <div class="glass-card"><div class="card-body">
        <p class="text-muted-2 mb-0">You have not reported anything.</p>
      </div></div>
    <% } else { %>
      <% const tone = { new: 'cloud', open: 'warn', closed: 'muted' }; %>
      <% issues.forEach(function (i) { %>
        <div class="glass-card mb-3"><div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-start mb-2">
            <h2 class="h6 mb-0"><%= i.summary %></h2>
            <span class="badge-hub <%= tone[i.status] || '' %>"><%= i.status %></span>
          </div>
          <p class="small text-muted-2 mb-2">
            <%= new Date(i.created_at).toISOString().slice(0, 10) %>
            <% if (i.page_path) { %> · <%= i.page_path %><% } %>
          </p>
          <p class="small mb-0" style="white-space: pre-line"><%= i.detail %></p>

          <% if (i.response) { %>
            <div class="mt-3 pt-3 border-top">
              <h3 class="h6 mb-1">Our reply</h3>
              <p class="small mb-0" style="white-space: pre-line"><%= i.response %></p>
            </div>
          <% } %>
        </div></div>
      <% }); %>
    <% } %>
  </div></div>
</div></section>
<%- include('partials/layout-end') %>
