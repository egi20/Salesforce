# Copy to deploy/.env on the server. Never commit it.

# The domain, without https:// — the same name you point at this server in GoDaddy DNS.
DOMAIN=salesforcehub.example
TLS_EMAIL=you@example.com

APP_NAME=Salesforce Hub
SUPPORT_EMAIL=support@example.com

# Database. Both passwords: openssl rand -hex 24
DB_ROOT_PASSWORD=
DB_USER=sfhub
DB_PASSWORD=
DB_NAME=salesforce_hub

# openssl rand -hex 32
SESSION_SECRET=

# --- All optional. Each feature switches itself off when its key is missing. ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=Salesforce Hub <noreply@example.com>
ANTHROPIC_API_KEY=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TAX_ADVISORY_NOTIFY=
RATE_MIN_SAMPLE=3
