<%- include('partials/layout-start') %>

<header class="page-header">
  <div class="container">
    <div class="row align-items-center g-4">
      <div class="col-lg-7">
        <h1 class="mb-3">The Salesforce ecosystem, in one place</h1>
        <p class="mb-4">
          Contract and permanent roles across Sales Cloud, Service Cloud, Revenue Cloud, Data Cloud,
          MuleSoft and Agentforce. Certified consultants you can filter by cloud, credential and
          availability. And day-rate benchmarks contributed by the people doing the work.
        </p>
        <div class="d-flex flex-wrap gap-2">
          <a class="btn btn-light fw-semibold" href="/jobs">Browse <%= totalJobs %> open role<%= totalJobs === 1 ? '' : 's' %></a>
          <a class="btn btn-outline-light fw-semibold" href="/consultants">Find consultants</a>
        </div>
      </div>
      <div class="col-lg-5">
        <form class="card-hub p-3" action="/jobs" method="get" role="search">
          <label class="form-label" for="home-q">Search roles</label>
          <input class="form-control mb-2" id="home-q" name="q" placeholder="e.g. CPQ, Apex, Data Cloud">
          <label class="form-label" for="home-role">Role</label>
          <select class="form-select mb-3" id="home-role" name="role">
            <option value="">Any role</option>
            <% roleCategories.forEach(function (cat) { %>
              <optgroup label="<%= cat.category %>">
                <% cat.roles.forEach(function (r) { %><option value="<%= r.value %>"><%= r.label %></option><% }); %>
              </optgroup>
            <% }); %>
          </select>
          <button class="btn btn-hub w-100" type="submit">Search jobs</button>
        </form>
      </div>
    </div>
  </div>
</header>

<div class="container">
  <%- include('partials/flash') %>

  <div class="row g-3 mb-5">
    <div class="col-6 col-lg-3">
      <div class="stat-tile"><div class="value"><%= totalJobs %></div><div class="label">Open roles</div></div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="stat-tile"><div class="value"><%= totalConsultants %></div><div class="label">Listed consultants</div></div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="stat-tile"><div class="value"><%= rateContributors %></div><div class="label">Rate contributors</div></div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="stat-tile"><div class="value"><%= cloudFamilies.length %></div><div class="label">Clouds covered</div></div>
    </div>
  </div>

  <section class="mb-5">
    <div class="d-flex justify-content-between align-items-end mb-3">
      <h2 class="mb-0">Latest roles</h2>
      <a href="/jobs">See all jobs <i class="bi bi-arrow-right"></i></a>
    </div>
    <% if (latestJobs.length === 0) { %>
      <div class="empty-state card-hub"><i class="bi bi-briefcase"></i>No roles posted yet.</div>
    <% } else { %>
      <div class="row g-3">
        <% latestJobs.forEach(function (job) { %>
          <div class="col-lg-6"><%- include('partials/job-card', { job: job }) %></div>
        <% }); %>
      </div>
    <% } %>
  </section>

  <section class="mb-5">
    <div class="d-flex justify-content-between align-items-end mb-3">
      <h2 class="mb-0">Available consultants</h2>
      <a href="/consultants">See all talent <i class="bi bi-arrow-right"></i></a>
    </div>
    <% if (featuredConsultants.length === 0) { %>
      <div class="empty-state card-hub"><i class="bi bi-people"></i>No public profiles yet.</div>
    <% } else { %>
      <div class="row g-3">
        <% featuredConsultants.forEach(function (c) { %>
          <div class="col-md-6 col-lg-4"><%- include('partials/consultant-card', { c: c }) %></div>
        <% }); %>
      </div>
    <% } %>
  </section>

  <section class="mb-5">
    <h2 class="mb-3">Browse by cloud</h2>
    <div class="row g-3">
      <% cloudFamilies.forEach(function (f) { %>
        <div class="col-6 col-md-4 col-lg-3">
          <a class="card-hub d-block h-100 text-reset" href="/jobs?module=<%= f.modules[0].value %>">
            <div class="card-body">
              <h3 class="h6 mb-1"><%= f.label %></h3>
              <p class="small text-muted-2 mb-0"><%= f.modules.length %> modules</p>
            </div>
          </a>
        </div>
      <% }); %>
    </div>
  </section>

  <section class="card-hub p-4 mb-5">
    <div class="row align-items-center g-3">
      <div class="col-lg-8">
        <h2 class="mb-2">Know what the work is worth</h2>
        <p class="mb-0 text-muted-2">
          The rate index is built from figures contributed by consultants, one per person per month.
          No bucket is published until at least three different people have contributed to it, so a
          small market cannot become a guessing game about one person's pay.
        </p>
      </div>
      <div class="col-lg-4 text-lg-end">
        <a class="btn btn-hub" href="/rates">Open the rate index</a>
      </div>
    </div>
  </section>
</div>

<%- include('partials/layout-end') %>
