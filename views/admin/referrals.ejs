<%- include('../partials/layout-start') %>

<%- include('../partials/page-header', { icon: 'bi-people', heading: 'Referrals and payouts', sub: 'Every figure here is a SUM over the ledger. Nothing is cached.' }) %>

<section class="glass-section pb-5">
<div class="container">
  <%- include('./_tabs', { current: 'referrals' }) %>
  <%- include('../partials/flash') %>

  <%# Two lists, as SAP Hub's referrals screen: people PAID per introduction, and the Hub's
      own people whose links are MEASURED. ?tab= links, so they work without scripting. %>
  <ul class="nav nav-tabs mb-4">
    <li class="nav-item"><a class="nav-link <%= tab === 'agents' ? '' : 'active' %>" href="/admin/referrals" <%- tab === 'agents' ? '' : 'aria-current="page"' %>><i class="bi bi-people me-1"></i>Referrers</a></li>
    <li class="nav-item"><a class="nav-link <%= tab === 'agents' ? 'active' : '' %>" href="/admin/referrals?tab=agents" <%- tab === 'agents' ? 'aria-current="page"' : '' %>><i class="bi bi-person-badge me-1"></i>Sales agents</a></li>
  </ul>

  <% if (tab === 'agents') { %>
    <%- include('./_sales-agents') %>
  <% } else { %>

  <div class="glass-card mb-4">
    <div class="card-body">
      <h2 class="h6">What these buttons do</h2>
      <ul class="small text-muted-2 mb-0">
        <li>
          <strong>Payout</strong> records that a transfer was made. It settles the whole unpaid
          balance — not an amount you type — so there is no remainder to explain. It does not move
          any money: you make the transfer, this writes it down.
        </li>
        <li>
          <strong>Adjust</strong> writes a compensating entry with a reason the referrer will see.
          It is the only way a commission is ever reversed. A refund does not claw one back
          automatically: a webhook silently debiting somebody's balance is how a referrer finds out
          from a dashboard that they owe money.
        </li>
        <li>
          <strong>Pausing</strong> a referrer stops new introductions being attributed. It does not
          touch existing attributions or anything already earned.
        </li>
        <li>
          <strong>A rate change</strong> applies to introductions made from then on. Existing ones
          keep the rate they were made under.
        </li>
      </ul>
    </div>
  </div>

  <%# Add an existing account at an agreed rate. Never creates an account. %>
  <div class="glass-card mb-4"><div class="card-body">
    <h2 class="h6 mb-1"><i class="bi bi-person-plus me-1"></i>Add a referrer</h2>
    <p class="small text-muted-2 mb-3">
      Put an existing account into the scheme at an agreed rate. Members can also join at
      <a href="/referrals">/referrals</a> themselves at the standard <%= defaultRateBps / 100 %>%.
      The person must already have an account.
    </p>
    <form method="post" action="/admin/referrals/add" class="row g-2 align-items-end">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="col-md-6">
        <label class="form-label small" for="add-email">Account email</label>
        <input class="form-control" id="add-email" name="email" type="email" required autocomplete="off">
      </div>
      <div class="col-6 col-md-3">
        <label class="form-label small" for="add-rate">Commission (%)</label>
        <input class="form-control" id="add-rate" name="rate_percent" type="number" min="0.01" max="30" step="any" placeholder="<%= defaultRateBps / 100 %>">
      </div>
      <div class="col-6 col-md-3"><button class="btn btn-primary w-100" type="submit">Add referrer</button></div>
    </form>
  </div></div>

  <% if (!referrers.length) { %>
    <div class="glass-card"><div class="card-body"><p class="text-muted-2 mb-0">Nobody has joined the scheme yet.</p></div></div>
  <% } %>

  <% referrers.forEach(function (r) { %>
    <div class="glass-card mb-3">
      <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
          <div>
            <h2 class="h6 mb-1">
              <%= r.name || r.email %>
              <% if (!r.is_active) { %><span class="badge-hub muted">paused</span><% } %>
            </h2>
            <p class="small text-muted-2 mb-0">
              <code><%= r.code %></code> · <%= r.rate_bps / 100 %>% ·
              <%= r.introductions %> introductions ·
              <%= r.payout_method ? r.payout_method.replace(/_/g, ' ') : 'no payout method set' %>
              <% if (r.payout_reference) { %> · <code><%= r.payout_reference %></code><% } %>
            </p>
          </div>
          <div class="text-end">
            <div class="invoice-total"><%= formatMinor(r.unpaid_minor) %></div>
            <div class="small text-muted-2">unpaid · <%= formatMinor(r.earned_minor) %> lifetime</div>
          </div>
        </div>

        <div class="row g-3">
          <div class="col-lg-5">
            <form method="post" action="/admin/referrals/<%= r.id %>/payout" class="d-flex flex-wrap gap-2 align-items-end">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div>
                <label class="form-label small" for="method-<%= r.id %>">Method</label>
                <select class="form-select form-select-sm" id="method-<%= r.id %>" name="method">
                  <% payoutMethods.forEach(function (m) { %>
                    <option value="<%= m %>" <%= r.payout_method === m ? 'selected' : '' %>><%= m.replace(/_/g, ' ') %></option>
                  <% }); %>
                </select>
              </div>
              <div class="flex-grow-1">
                <label class="form-label small" for="ref-<%= r.id %>">Transfer reference</label>
                <input class="form-control form-control-sm" id="ref-<%= r.id %>" name="reference" maxlength="255">
              </div>
              <button class="btn btn-sm btn-primary" type="submit"
                      <%= r.unpaid_minor < minPayoutMinor ? 'disabled' : '' %>>
                Pay <%= formatMinor(r.unpaid_minor) %>
              </button>
            </form>
            <% if (r.unpaid_minor < minPayoutMinor) { %>
              <p class="small text-muted-2 mt-1 mb-0">
                Below the <%= formatMinor(minPayoutMinor) %> minimum. The balance keeps accruing.
              </p>
            <% } %>
          </div>

          <div class="col-lg-4">
            <form method="post" action="/admin/referrals/<%= r.id %>/adjust" class="d-flex flex-wrap gap-2 align-items-end">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div style="width: 7rem;">
                <label class="form-label small" for="adj-<%= r.id %>">Adjust (EUR)</label>
                <input class="form-control form-control-sm" id="adj-<%= r.id %>" name="amount_eur"
                       type="number" step="0.01" placeholder="-149.00">
              </div>
              <div class="flex-grow-1">
                <label class="form-label small" for="adjnote-<%= r.id %>">Reason (shown to them)</label>
                <input class="form-control form-control-sm" id="adjnote-<%= r.id %>" name="note" maxlength="200" required>
              </div>
              <button class="btn btn-sm btn-outline-primary" type="submit">Record</button>
            </form>
          </div>

          <div class="col-lg-3">
            <div class="d-flex flex-wrap gap-2 align-items-end">
              <form method="post" action="/admin/referrals/<%= r.id %>/rate" class="d-flex gap-2 align-items-end">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div style="width: 6rem;">
                  <label class="form-label small" for="rate-<%= r.id %>">Rate (bps)</label>
                  <input class="form-control form-control-sm" id="rate-<%= r.id %>" name="rate_bps"
                         type="number" min="1" max="3000" value="<%= r.rate_bps %>">
                </div>
                <button class="btn btn-sm btn-outline-primary" type="submit">Set</button>
              </form>
              <form method="post" action="/admin/referrals/<%= r.id %>/active">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="is_active" value="<%= r.is_active ? 'false' : 'true' %>">
                <button class="btn btn-sm btn-outline-primary" type="submit">
                  <%= r.is_active ? 'Pause' : 'Resume' %>
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% }); %>

  <%- include('../partials/pagination') %>
  <% } %>
</div>
</section>

<%# The per-agent modals sit OUTSIDE the glass section: its z-index and the cards'
    backdrop-filter each make a stacking context that paints a modal under Bootstrap's
    backdrop — the page dims and no dialog appears. %>
<% if (tab === 'agents') { %><%- include('./_sales-agent-modals') %><% } %>

<%- include('../partials/layout-end') %>
