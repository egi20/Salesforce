<%- include('../partials/layout-start') %>
<%- include('../partials/page-header', {
  icon: 'bi-eye-slash',
  heading: 'Hide from companies',
  sub: 'For looking while you are still somewhere.'
}) %>
<section class="glass-section pb-5"><div class="container">
  <div class="row justify-content-center"><div class="col-lg-8">
    <%- include('../partials/flash') %>

    <div class="glass-card mb-4"><div class="card-body p-4">
      <h2 class="h6 mb-3">What this does, exactly</h2>
      <ul class="small text-muted-2 mb-0">
        <li><strong>A company with an account here</strong> — enforced. While they are signed
            in, your profile is not in their directory, not in their search results, and its
            page answers "not found".</li>
        <li><strong>An employer with no account</strong> — saved by name. It takes effect if
            they sign up under a name that matches. Worth setting now; it applies on its own
            later.</li>
        <li><strong>Somebody signed out</strong> — <strong>this cannot help.</strong> Your
            profile is public, so anyone browsing without an account can see it and no filter
            can tell who they work for. If that is what you need, make your profile
            <a href="/profile/consultant">not public</a> instead — that is the switch that
            actually answers it.</li>
      </ul>
    </div></div>

    <div class="glass-card mb-4"><div class="card-body p-4">
      <h2 class="h6 mb-3">Add a company</h2>

      <form method="post" action="/profile/hidden-companies" class="mb-3">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="form-label" for="company_user_id">A company on the Hub</label>
        <div class="d-flex flex-wrap gap-2">
          <select class="form-select" id="company_user_id" name="company_user_id" style="max-width: 360px">
            <option value="">Choose…</option>
            <% companies.forEach(function (c) { %>
              <option value="<%= c.user_id %>"><%= c.company_name %></option>
            <% }); %>
          </select>
          <button class="btn btn-primary" type="submit">Hide from them</button>
        </div>
      </form>

      <form method="post" action="/profile/hidden-companies">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="form-label" for="company_name">Or an employer that is not on the Hub</label>
        <div class="d-flex flex-wrap gap-2">
          <input class="form-control" id="company_name" name="company_name" maxlength="200"
                 placeholder="Their name, as they write it" style="max-width: 360px">
          <button class="btn btn-outline-primary" type="submit">Save the name</button>
        </div>
        <div class="form-text">Capitals and spacing do not matter.</div>
      </form>
    </div></div>

    <div class="glass-card"><div class="card-body p-4">
      <h2 class="h6 mb-3">
        Hidden from
        <span class="text-muted-2 fw-normal">(<%= blocks.length %> of <%= maxBlocks %>)</span>
      </h2>

      <% if (!blocks.length) { %>
        <p class="small text-muted-2 mb-0">Nobody yet. Your profile is visible to every company.</p>
      <% } else { %>
        <ul class="list-unstyled mb-0">
          <% blocks.forEach(function (b) { %>
            <li class="d-flex justify-content-between align-items-center border-top py-2">
              <span>
                <%= b.name %>
                <% if (b.isRegistered) { %>
                  <span class="badge-hub ok">enforced</span>
                <% } else { %>
                  <span class="badge-hub muted">by name</span>
                <% } %>
              </span>
              <form method="post" action="/profile/hidden-companies/<%= b.id %>/remove" class="d-inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-sm btn-outline-secondary" type="submit">Remove</button>
              </form>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </div></div>
  </div></div>
</div></section>
<%- include('../partials/layout-end') %>
