<%- include('../partials/layout-start') %>
<%- include('../partials/page-header', {
  icon: 'bi-receipt',
  heading: 'Invoices',
  sub: 'A draft can change. Everything after that is a statement made to a customer on a date.'
}) %>
<section class="glass-section pb-5"><div class="container">
  <%- include('../partials/flash') %>

  <%
    const fmt = (minor, cur) => (minor / 100).toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ' + cur;
    const day = (d) => (d ? new Date(d).toISOString().slice(0, 10) : '—');
    const tone = { draft: 'muted', issued: 'cloud', paid: 'ok', cancelled: 'danger' };
  %>

  <div class="d-flex flex-wrap gap-2 mb-3">
    <a class="btn btn-primary btn-sm" href="/admin/finance/invoices/new">New invoice</a>
    <a class="btn btn-outline-secondary btn-sm" href="/admin/finance">Back to finance</a>
    <a class="btn btn-outline-secondary btn-sm" href="/admin/finance/sequence">Numbering check</a>
  </div>

  <form class="row g-2 align-items-end mb-3" method="get" action="/admin/finance/invoices">
    <div class="col-md-4">
      <label class="form-label small" for="q">Search</label>
      <input class="form-control form-control-sm" id="q" name="q" value="<%= filters.q %>" maxlength="120"
             placeholder="Client, reference or number">
    </div>
    <div class="col-6 col-md-2">
      <label class="form-label small" for="status">Status</label>
      <select class="form-select form-select-sm" id="status" name="status">
        <option value="">Any</option>
        <% statuses.forEach(function (s) { %>
          <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option>
        <% }); %>
      </select>
    </div>
    <div class="col-6 col-md-2">
      <label class="form-label small" for="year">Year</label>
      <select class="form-select form-select-sm" id="year" name="year">
        <option value="">Any</option>
        <% years.forEach(function (y) { %>
          <option value="<%= y %>" <%= String(filters.year) === String(y) ? 'selected' : '' %>><%= y %></option>
        <% }); %>
      </select>
    </div>
    <div class="col-6 col-md-2">
      <div class="form-check">
        <input class="form-check-input" type="checkbox" name="overdue" value="1" id="overdue" <%= filters.overdue ? 'checked' : '' %>>
        <label class="form-check-label small" for="overdue">Overdue only</label>
      </div>
    </div>
    <div class="col-6 col-md-2">
      <button class="btn btn-primary btn-sm w-100" type="submit">Filter</button>
    </div>
  </form>

  <% if (!invoices.length) { %>
    <div class="glass-card"><div class="card-body">
      <p class="text-muted-2 mb-0">
        <% if (!clients.length) { %>
          No clients yet — <a href="/admin/finance/clients">add one</a> before writing an invoice.
        <% } else { %>
          Nothing matches.
        <% } %>
      </p>
    </div></div>
  <% } else { %>
    <div class="glass-card"><div class="card-body p-0"><div class="table-responsive">
      <table class="table table-sm align-middle mb-0">
        <thead>
          <tr>
            <th scope="col">No.</th>
            <th scope="col">Client</th>
            <th scope="col">Status</th>
            <th scope="col">Issued</th>
            <th scope="col">Due</th>
            <th scope="col" class="text-end">Net</th>
            <th scope="col" class="text-end">Total</th>
          </tr>
        </thead>
        <tbody>
          <% invoices.forEach(function (i) { %>
            <tr>
              <td>
                <a href="/admin/finance/invoices/<%= i.id %>">
                  <%= i.label || 'draft' %>
                </a>
                <% if (i.reference) { %><div class="small text-muted-2"><%= i.reference %></div><% } %>
              </td>
              <td class="small"><%= i.client_name %></td>
              <td><span class="badge-hub <%= tone[i.status] || '' %>"><%= i.status %></span></td>
              <td class="small text-muted-2"><%= day(i.issue_date) %></td>
              <td class="small text-muted-2">
                <%= day(i.due_date) %>
                <% if (i.status === 'issued' && i.due_date && new Date(i.due_date) < new Date()) { %>
                  <span class="badge-hub warn">overdue</span>
                <% } %>
              </td>
              <td class="text-end small"><%= fmt(i.net_minor, i.currency) %></td>
              <td class="text-end"><%= fmt(i.gross_minor, i.currency) %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div></div></div>
    <%- include('../partials/pagination', { pagination, pageUrl }) %>
  <% } %>

  <p class="small text-muted-2 mt-3 mb-0">
    There is no delete on this page, at any status. A draft can be discarded from its own
    page because it never held a number; an issued invoice is cancelled, which keeps the row
    and keeps the number used.
  </p>
</div></section>
<%- include('../partials/layout-end') %>
