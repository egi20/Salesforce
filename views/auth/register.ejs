<%- include('../partials/layout-start') %>

<section class="glass-section glass-section-tall py-5">
  <div class="container">
  <div class="row justify-content-center">
    <div class="col-lg-6">
      <%- include('../partials/flash') %>

      <div class="glass-card">
        <div class="card-body p-4">
          <h1 class="h4 mb-1">Create your account</h1>
          <p class="text-muted-2">Free for consultants and hiring companies.</p>

          <% if (errors.length) { %>
            <div class="alert alert-danger">
              <ul class="mb-0"><% errors.forEach(function (e) { %><li><%= e.msg %></li><% }); %></ul>
            </div>
          <% } %>

          <form method="post" action="/auth/register" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="redirect" value="<%= redirect %>">
            <%
              /*
               * The referral code carried through a failed validation, so someone who
               * mistypes their password does not lose the attribution. The session copy is
               * checked first server-side, so this field is a convenience, not the source
               * of truth.
               */
            %>
            <input type="hidden" name="ref" value="<%= values.ref || '' %>">

            <%
              /*
               * The roles, as cards rather than a column of small checkboxes.
               *
               * They ARE checkboxes — the input is the control, visually hidden but still
               * focusable and still in the tab order, with the label as its face. Nothing
               * here needs JavaScript: the page works with scripting off, which is the rule
               * this whole codebase holds client-side code to.
               *
               * Three, not the reference's two. `recruiter` is in `User.PUBLIC_ROLES` and can
               * be self-selected; `partner` is not, and must not appear here — it is the role
               * that carries a commission rate, and the reference's `user_types[]=partner`
               * POST was a real privilege escalation rather than a missing checkbox.
               */
              const ROLE_CARDS = [
                { value: 'consultant', icon: 'bi-person-badge', title: 'Consultant', note: 'Looking for Salesforce work' },
                { value: 'company', icon: 'bi-buildings', title: 'Company', note: 'Hiring Salesforce talent' },
                { value: 'recruiter', icon: 'bi-people', title: 'Recruiter', note: 'An agency or headhunter' }
              ];
              // What they picked before a failed submit, so a validation error does not reset
              // the first question on the form.
              const chosen = Array.isArray(values.user_types)
                ? values.user_types
                : (values.user_types ? [values.user_types] : ['consultant']);
            %>
            <fieldset class="mb-4">
              <legend class="form-label">I am <span class="text-muted-2 fw-normal">(pick all that apply)</span></legend>
              <div class="role-cards">
                <% ROLE_CARDS.forEach(function (r) { %>
                  <div class="role-card">
                    <input class="role-card-input" type="checkbox" name="user_types"
                           value="<%= r.value %>" id="t-<%= r.value %>"
                           <%= chosen.includes(r.value) ? 'checked' : '' %>>
                    <label class="role-card-face" for="t-<%= r.value %>">
                      <i class="bi <%= r.icon %>" aria-hidden="true"></i>
                      <span class="role-card-title"><%= r.title %></span>
                      <span class="role-card-note"><%= r.note %></span>
                    </label>
                  </div>
                <% }); %>
              </div>
              <p class="form-text mb-0">You can hold more than one role on one account.</p>
            </fieldset>

            <div class="mb-3">
              <label class="form-label" for="name">Full name</label>
              <input class="form-control" id="name" name="name" required value="<%= values.name || '' %>"
                     autocomplete="name" placeholder="First and last name">
            </div>

            <div class="mb-3">
              <label class="form-label" for="company_name">Company name <span class="text-muted-2">(if hiring)</span></label>
              <input class="form-control" id="company_name" name="company_name" value="<%= values.company_name || '' %>"
                     autocomplete="organization">
            </div>

            <div class="mb-3">
              <label class="form-label" for="email">Email</label>
              <input class="form-control" id="email" name="email" type="email" required
                     value="<%= values.email || '' %>" autocomplete="email">
            </div>

            <div class="row g-2 mb-3">
              <div class="col-md-6">
                <label class="form-label" for="password">Password</label>
                <input class="form-control" id="password" name="password" type="password" required
                     autocomplete="new-password" data-toggle-visibility>
                <p class="form-text">At least 8 characters, with upper case, lower case and a number.</p>
              </div>
              <div class="col-md-6">
                <label class="form-label" for="confirm_password">Confirm password</label>
                <input class="form-control" id="confirm_password" name="confirm_password" type="password" required
                     autocomplete="new-password" data-toggle-visibility>
              </div>
            </div>

            <details class="mb-3">
              <summary class="small text-muted-2">Optional demographic questions</summary>
              <div class="row g-2 mt-1">
                <div class="col-md-6">
                  <label class="form-label" for="gender">Gender</label>
                  <select class="form-select" id="gender" name="gender">
                    <option value="">Prefer not to say</option>
                    <option value="female">Female</option>
                    <option value="male">Male</option>
                    <option value="non_binary">Non-binary</option>
                    <option value="other">Other</option>
                  </select>
                </div>
                <div class="col-md-6">
                  <label class="form-label" for="date_of_birth">Date of birth</label>
                  <input class="form-control" id="date_of_birth" name="date_of_birth" type="date">
                </div>
              </div>
              <p class="form-text mt-1">
                Voluntary, and used only for aggregate diversity reporting. Never shown on your profile
                and never shared with employers.
              </p>
            </details>

            <div class="form-check mb-3">
              <input class="form-check-input" type="checkbox" id="terms" name="terms" required>
              <label class="form-check-label" for="terms">
                I accept the <a href="/legal/terms" target="_blank">terms</a> and
                <a href="/legal/privacy" target="_blank">privacy policy</a>.
              </label>
            </div>

            <button class="btn btn-primary w-100" type="submit">Create account</button>
          </form>

          <p class="text-center mt-3 mb-0 small">Already have an account? <a href="/auth/login">Sign in</a></p>
        </div>
      </div>
    </div>
  </div>
  </div>
</section>

<%- include('../partials/layout-end') %>
