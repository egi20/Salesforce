<%- include('../partials/layout-start') %>

<%
  /*
   * The application and the enquiry are ONE form ("Apply now" preselects the program topic),
   * styled as part of /tax-optimization: the same dark band, the same white cards, and beside
   * the form what happens next and what is deliberately not asked.
   */
  const applying = form.topic === programTopic;
%>
<section class="hub-hero tax-enquire-hero">
  <div class="container">
    <a class="tax-back-link" href="/tax-optimization"><i class="bi bi-arrow-left"></i> Tax optimization</a>
    <span class="hub-hero-badge mb-3 d-inline-flex"><i class="bi bi-graph-up-arrow"></i> TAX OPTIMIZATION</span>
    <h1><%= applying ? 'Apply to the Albania employment program' : 'Ask about your setup' %></h1>
    <p class="lead mb-0">
      <% if (applying) { %>Six questions, none of them about your pay. We read every application and come back to you.<% } else { %>Six questions, none of them about your pay. Tell us your situation and we will come back to you.<% } %>
    </p>
  </div>
</section>

<section class="glass-section tax-section">
<div class="container">
  <div class="row g-4 align-items-start">
    <div class="col-lg-7">
      <%- include('../partials/flash') %>

      <div class="tax-calc-card tax-enquire-card">
        <h2 class="h5 mb-1"><i class="bi bi-<%= applying ? 'send' : 'chat-dots' %> text-primary"></i> <%= applying ? 'Your application' : 'Your question' %></h2>
        <p class="small text-muted-2 mb-4">
          Whoever answers will ask what they need in the conversation, under their own terms —
          which is the only place a duty of confidentiality actually applies.
        </p>

          <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger"><%= error %></div>
          <% } %>

          <form method="post" action="/tax-optimization/enquire">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <label class="form-label" for="full_name">Your name</label>
                <input class="form-control" id="full_name" name="full_name" type="text" required
                       maxlength="<%= limits.name %>" value="<%= form.fullName %>">
              </div>
              <div class="col-md-6">
                <label class="form-label" for="email">Email</label>
                <input class="form-control" id="email" name="email" type="email" required
                       maxlength="<%= limits.email %>" value="<%= form.email %>">
              </div>
            </div>

            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <label class="form-label" for="phone">Phone <span class="text-muted-2">(optional)</span></label>
                <input class="form-control" id="phone" name="phone" type="tel"
                       maxlength="<%= limits.phone %>" value="<%= form.phone %>">
              </div>
              <div class="col-md-6">
                <label class="form-label" for="country">Where you are tax-resident</label>
                <select class="form-select" id="country" name="country" required>
                  <option value="">Choose</option>
                  <%
                    const groups = [
                      ['Where most consultants on the Hub live', countryGroups.top],
                      ['Europe and other common countries', countryGroups.relevant],
                      ['All other countries', countryGroups.rest]
                    ].filter(function (g) { return g[1].length; });
                  %>
                  <% groups.forEach(function (g) { %>
                    <optgroup label="<%= g[0] %>">
                      <% g[1].forEach(function (c) { %>
                        <option value="<%= c.code %>" <%= form.country === c.code ? 'selected' : '' %>><%= c.name %></option>
                      <% }); %>
                    </optgroup>
                  <% }); %>
                </select>
                <div class="form-text">It decides who can help you, and it is the only location we ask for.</div>
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label" for="arrangement">How you work at the moment</label>
              <select class="form-select" id="arrangement" name="arrangement" required>
                <option value="">Choose</option>
                <% arrangements.forEach(function (a) { %>
                  <option value="<%= a.value %>" <%= form.arrangement === a.value ? 'selected' : '' %>><%= a.label %></option>
                <% }); %>
              </select>
            </div>

            <div class="mb-3">
              <label class="form-label" for="topic">What you want to ask about</label>
              <select class="form-select" id="topic" name="topic" required>
                <option value="">Choose</option>
                <% topics.forEach(function (t) { %>
                  <option value="<%= t.value %>" <%= form.topic === t.value ? 'selected' : '' %>><%= t.label %></option>
                <% }); %>
              </select>
            </div>

            <div class="mb-3">
              <label class="form-label" for="question">Your situation, in your own words</label>
              <textarea class="form-control" id="question" name="question" rows="6" required
                        minlength="<%= limits.questionMin %>" maxlength="<%= limits.question %>"
                        placeholder="What you do, who your clients are, and what you are trying to work out."><%= form.question %></textarea>
              <div class="form-text">
                Please do not paste bank details, tax reference numbers or identity documents here.
                Nothing in this form needs them.
              </div>
            </div>

            <%
              /*
               * Consent is a real checkbox with a named purpose, not a line of small print
               * under a button. The reference collects somebody's salary, employer and
               * notice period with no consent record at all.
               *
               * Unticked posts nothing, so the server treats absence as refusal rather
               * than defaulting it — the same trap AppSetting.setMany avoids by iterating
               * declared keys instead of the submitted body.
               */
            %>
            <div class="form-check mb-4">
              <input class="form-check-input" type="checkbox" id="consent" name="consent" value="on" required>
              <label class="form-check-label small" for="consent">
                I agree that Salesforce Hub may read what I have written here, and pass it
                to a tax specialist or the program team in order to answer it, and may keep it for
                <%= retentionDays %> days. I understand Salesforce Hub is not giving me
                advice and is not an accountant.
                <a href="/legal/privacy" target="_blank" rel="noopener">Privacy notice</a>.
              </label>
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2">
              <button class="btn btn-primary btn-lg" type="submit"><i class="bi bi-send"></i> <%= applying ? 'Send my application' : 'Send my enquiry' %></button>
              <a class="btn btn-link" href="/tax-optimization">Back</a>
            </div>
          </form>
      </div>
    </div>

    <aside class="col-lg-5">
      <div class="sow-white-card mb-3">
        <h2 class="h6 mb-3">What happens next</h2>
        <ol class="tax-next list-unstyled mb-0">
          <li><span class="cv-step-n">1</span><div><strong>We read it</strong><p class="small text-muted-2 mb-0"><%= applying ? 'We check your application against who the program is for.' : 'We work out who should answer it.' %></p></div></li>
          <li><span class="cv-step-n">2</span><div><strong>We reply by email</strong><p class="small text-muted-2 mb-0"><%= applying ? 'If it fits, we explain the contract and what payroll withholds before you sign anything.' : 'We tell you who we think can help, and nothing happens without your yes.' %></p></div></li>
          <li><span class="cv-step-n">3</span><div><strong>You decide</strong><p class="small text-muted-2 mb-0">Check your home-country position with a tax advisor before you join anything.</p></div></li>
        </ol>
      </div>
      <div class="sow-white-card">
        <h2 class="h6 mb-3">What we do not ask</h2>
        <ul class="list-unstyled small mb-3">
          <li class="d-flex gap-2 mb-2"><i class="bi bi-x-circle-fill text-danger flex-shrink-0 mt-1"></i><span>Your salary, employer, notice period or day rate.</span></li>
          <li class="d-flex gap-2 mb-0"><i class="bi bi-x-circle-fill text-danger flex-shrink-0 mt-1"></i><span>Bank details, tax numbers or identity documents.</span></li>
        </ul>
        <p class="small text-muted-2 mb-0"><i class="bi bi-clock-history"></i> We keep what you send for <%= retentionDays %> days and then delete it.</p>
      </div>
    </aside>
  </div>
</div>
</section>

<%- include('../partials/layout-end') %>
