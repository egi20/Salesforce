<%- include('../partials/layout-start') %>

<%- include('../partials/page-header', { icon: 'bi-sliders', heading: 'Settings', sub: 'Operational switches. Not catalogue values — those live in version control.' }) %>

<section class="glass-section pb-5">
<div class="container">
  <%- include('./_tabs', { current: 'settings' }) %>
  <%- include('../partials/flash') %>

  <div class="row g-4">
    <div class="col-lg-7">
      <div class="glass-card">
        <div class="card-body">
          <form method="post" action="/admin/settings">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <%
              const fieldError = function (key) {
                const e = errors.find(function (x) { return x.key === key; });
                return e ? e.msg : null;
              };
              const general = Object.entries(definitions).filter(function ([, def]) { return !def.group; });
              const social = Object.entries(definitions).filter(function ([, def]) { return def.group === 'social'; });
            %>
            <% if (errors.length) { %>
              <div class="alert alert-danger" role="alert">
                <p class="mb-1">Nothing was saved:</p>
                <ul class="mb-0"><% errors.forEach(function (e) { %><li><%= e.msg %></li><% }); %></ul>
              </div>
            <% } %>

            <% general.forEach(function ([key, def]) { %>
              <div class="mb-4">
                <% if (def.type === 'boolean') { %>
                  <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch"
                           id="<%= key %>" name="<%= key %>" <%= values[key] ? 'checked' : '' %>>
                    <label class="form-check-label fw-semibold" for="<%= key %>"><%= def.label %></label>
                  </div>
                <% } else { %>
                  <label class="form-label fw-semibold" for="<%= key %>"><%= def.label %></label>
                  <input class="form-control" type="text" id="<%= key %>" name="<%= key %>"
                         value="<%= values[key] %>" maxlength="<%= def.maxLength || 300 %>">
                <% } %>
                <div class="form-text"><%= def.help %></div>
              </div>
            <% }); %>

            <% if (social.length) { %>
              <hr class="my-4">
              <h2 class="h6"><i class="bi bi-share me-1" aria-hidden="true"></i>Social links</h2>
              <p class="small text-muted-2">
                The Hub's own accounts, shown as icons in the footer. An empty field shows no
                icon, so a link to an account that was never opened never reaches a page. Each
                must be an https address on that platform's own host.
              </p>
              <% social.forEach(function ([key, def]) { const err = fieldError(key); %>
                <div class="mb-3">
                  <label class="form-label" for="<%= key %>"><i class="bi <%= def.icon %> me-1" aria-hidden="true"></i><%= def.label %></label>
                  <input class="form-control<%= err ? ' is-invalid' : '' %>" type="url" inputmode="url" id="<%= key %>" name="<%= key %>"
                         value="<%= values[key] %>" maxlength="<%= def.maxLength %>" placeholder="https://…"
                         <% if (err) { %>aria-invalid="true" aria-describedby="<%= key %>-error"<% } %>>
                  <% if (err) { %><div class="invalid-feedback" id="<%= key %>-error"><%= err %></div><% } %>
                </div>
              <% }); %>
            <% } %>

            <button class="btn btn-primary" type="submit">Save</button>
          </form>
        </div>
      </div>
    </div>

    <div class="col-lg-5">
      <div class="glass-card">
        <div class="card-body">
          <h2 class="h6">What is not here, and why</h2>
          <p class="small text-muted-2">
            Roles, cloud modules, phase percentages, day rates and prices are not settings.
            They live in <code>config/</code> under version control, where a change has an
            author, a diff and a review. A quote that moved because someone edited a number
            through a form, with no record of who or when, is a quote nobody can defend.
          </p>
          <p class="small text-muted-2 mb-0">
            The rate index's privacy floor is an environment variable for the same reason —
            lowering it is a deployment decision, not a checkbox that makes a sparse index
            look fuller.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
</section>

<%- include('../partials/layout-end') %>
