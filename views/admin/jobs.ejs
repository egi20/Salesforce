<%- include('../partials/layout-start') %>

<%- include('../partials/page-header', { icon: 'bi-briefcase', heading: 'Jobs' }) %>

<section class="glass-section pb-5">
<div class="container">
  <%- include('../partials/flash') %>

  <ul class="nav nav-pills mb-3">
    <% ['open','draft','paused','filled','closed'].forEach(function (s) { %>
      <li class="nav-item"><a class="nav-link <%= status === s ? 'active' : '' %>" href="/admin/jobs?status=<%= s %>"><%= s %></a></li>
    <% }); %>
  </ul>

  <% if (jobs.length === 0) { %>
    <div class="empty-state glass-card"><i class="bi bi-briefcase"></i>No <%= status %> jobs.</div>
  <% } else { %>
    <div class="table-responsive glass-card">
      <table class="table align-middle mb-0">
        <thead><tr><th>Role</th><th>Company</th><th>Posted</th><th class="text-end">Applicants</th></tr></thead>
        <tbody>
          <% jobs.forEach(function (j) { %>
            <tr>
              <td><a href="/jobs/<%= j.slug %>"><%= j.title %></a>
                <div class="small text-muted-2"><%= roleLabel(j.role) %></div></td>
              <td class="text-muted-2"><%= j.company_name || '—' %></td>
              <td class="small text-muted-2"><%= j.published_at ? new Date(j.published_at).toISOString().slice(0, 10) : '—' %></td>
              <td class="text-end"><%= j.application_count %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <%- include('../partials/pagination') %>
  <% } %>
</div>
</section>

<%- include('../partials/layout-end') %>
