<%- include('../partials/layout-start') %>

<%
  /*
   * Rate & Salary Index.
   *
   * TWO KINDS OF FIGURE, ALWAYS LABELLED: "Benchmark my rate" is our EDITORIAL model
   * (config/rateModel.js, shown in full under Methodology); everything marked "Community
   * data" comes from what people told us, through utils/rateAggregation.js and its floor —
   * one figure per person per month, nothing published below the threshold, gaps never drawn
   * as zeros. Job figures are what companies publish on open adverts.
   *
   * Several GET forms share this page; each carries the others' state as hidden fields
   * (`keepExcept`), built only from validated values.
   */
  const eur = function (n) { return n == null ? '—' : '€' + Math.round(n).toLocaleString('en-GB'); };
  const hidden = function (prefixes) { return keepExcept(prefixes); };
  const signedIn = Boolean(currentUser);
  const canShare = Boolean(currentUser && currentUser.isConsultant);
%>

<section class="hub-hero rates-hero">
  <div class="container text-center">
    <span class="hub-hero-badge mb-3 d-inline-flex"><i class="bi bi-graph-up"></i> RATE &amp; SALARY INDEX</span>
    <h1>Rate &amp; Salary Index</h1>
    <p class="lead mx-auto">Benchmark your day rate with our editorial model, and explore rates contributed by consultants and offered in job postings.</p>
    <ul class="rates-pills list-unstyled">
      <li><i class="bi bi-people"></i> <strong><%= contributors.toLocaleString('en-GB') %></strong> contributor<%= contributors === 1 ? '' : 's' %></li>
      <% if (!heroSummary.suppressed) { %>
        <li><i class="bi bi-currency-euro"></i> <strong><%= eur(heroSummary.median) %></strong> median day rate</li>
      <% } %>
    </ul>
    <p class="rates-hero-note">Computed from current platform data · one figure per person per month · <a href="#methodology">How this stays honest</a></p>
  </div>
</section>

<section class="glass-section tax-section">
<div class="container">
  <%- include('../partials/flash') %>

  <div class="row g-4">
    <%# ---------------- LEFT: the editorial benchmark ---------------- %>
    <div class="col-lg-6" id="benchmark">
      <div class="rates-card">
        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
          <h2 class="h4 mb-0"><i class="bi bi-calculator text-primary"></i> Benchmark my rate</h2>
          <span class="rates-tag rates-tag-editorial">Editorial model</span>
        </div>
        <p class="small text-muted-2 mb-3">Editorial model — Salesforce Hub's baseline rates adjusted for your inputs. Separate from the community data alongside.</p>

        <form method="get" action="/rates#benchmark" class="rates-bench-form">
          <% hidden(['b_']).forEach(function (kv) { %><input type="hidden" name="<%= kv[0] %>" value="<%= kv[1] %>"><% }); %>
          <div class="mb-3">
            <label class="form-label" for="b-role">Primary role</label>
            <select class="form-select" id="b-role" name="b_role" required>
              <option value="">Select your role</option>
              <% const benchRole = state.b_role || state.role; %>
              <% roleCategories.forEach(function (cat) { %>
                <optgroup label="<%= cat.category %>">
                  <% cat.roles.forEach(function (r) { %><option value="<%= r.value %>" <%= benchRole === r.value ? 'selected' : '' %>><%= r.label %></option><% }); %>
                </optgroup>
              <% }); %>
            </select>
          </div>
          <div class="row g-3 mb-3">
            <div class="col-sm-6">
              <label class="form-label" for="b-exp">Years of experience</label>
              <select class="form-select" id="b-exp" name="b_exp">
                <% model.EXPERIENCE.forEach(function (e) { %><option value="<%= e.value %>" <%= (state.b_exp || 'senior') === e.value ? 'selected' : '' %>><%= e.label %></option><% }); %>
              </select>
            </div>
            <div class="col-sm-6">
              <label class="form-label" for="b-region">Region</label>
              <select class="form-select" id="b-region" name="b_region">
                <% model.REGIONS.forEach(function (r) { %><option value="<%= r.value %>" <%= (state.b_region || 'western-europe') === r.value ? 'selected' : '' %>><%= r.label %></option><% }); %>
              </select>
            </div>
            <div class="col-sm-6">
              <label class="form-label" for="b-certs">Salesforce certifications</label>
              <input class="form-control" id="b-certs" name="b_certs" type="number" min="0" max="<%= model.CERTIFICATIONS.max %>" step="1" value="<%= state.b_certs || '0' %>">
              <div class="form-text">Counted up to <%= model.CERTIFICATIONS.max %>.</div>
            </div>
            <div class="col-sm-6">
              <label class="form-label" for="b-skills">Additional skills</label>
              <input class="form-control" id="b-skills" name="b_skills" type="number" min="0" max="<%= model.SKILLS.max %>" step="1" value="<%= state.b_skills || '0' %>">
              <div class="form-text">Integration, data, AI… counted up to <%= model.SKILLS.max %>.</div>
            </div>
          </div>
          <fieldset class="mb-3">
            <legend class="form-label">Work arrangement</legend>
            <div class="btn-group w-100 rates-segmented" role="group">
              <% model.ARRANGEMENTS.forEach(function (a) { %>
                <input type="radio" class="btn-check" name="b_mode" id="b-mode-<%= a.value %>" value="<%= a.value %>" <%= (state.b_mode || 'remote') === a.value ? 'checked' : '' %>>
                <label class="btn btn-outline-primary" for="b-mode-<%= a.value %>"><%= a.label %></label>
              <% }); %>
            </div>
          </fieldset>
          <div class="row g-3 mb-4">
            <div class="col-sm-6">
              <label class="form-label" for="b-industry">Industry</label>
              <select class="form-select" id="b-industry" name="b_industry">
                <% model.INDUSTRIES.forEach(function (i) { %><option value="<%= i.value %>" <%= (state.b_industry || 'general') === i.value ? 'selected' : '' %>><%= i.label %></option><% }); %>
              </select>
            </div>
            <div class="col-sm-6">
              <label class="form-label" for="b-contract">Contract type</label>
              <select class="form-select" id="b-contract" name="b_contract">
                <% model.CONTRACT_TYPES.forEach(function (c) { %><option value="<%= c.value %>" <%= (state.b_contract || 'time-materials') === c.value ? 'selected' : '' %>><%= c.label %></option><% }); %>
              </select>
            </div>
          </div>
          <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-primary" type="submit"><i class="bi bi-calculator"></i> Calculate rate</button>
            <%# Both need a calculated scenario and scripting; without either they are not shown. %>
            <button class="btn btn-outline-primary" type="button" data-rates-save hidden <%= bench ? '' : 'disabled' %> title="Copies a link that reopens this scenario. Nothing is stored."><i class="bi bi-bookmark"></i> Save scenario</button>
            <button class="btn btn-outline-primary" type="button" data-rates-print hidden <%= bench ? '' : 'disabled' %> title="Opens your browser's print dialog — choose Save as PDF."><i class="bi bi-filetype-pdf"></i> Export PDF</button>
          </div>
          <p class="small text-success mt-2 mb-0" data-rates-saved role="status" hidden>Link copied — it reopens this scenario. Nothing was stored.</p>
        </form>

        <% if (bench) { %>
          <div class="rates-result" id="benchmark-result">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h3 class="h6 mb-0"><%= roleLabel(bench.inputs.role) %> · <%= bench.steps.experience.label %> · <%= bench.steps.region.label %></h3>
              <span class="rates-confidence rates-confidence-<%= benchConfidence.toLowerCase() %>" title="From how many people stand behind the community comparison"><%= benchConfidence %> confidence</span>
            </div>
            <div class="row g-2 text-center mb-3">
              <div class="col-4"><div class="rates-tile"><span>Min</span><strong><%= eur(bench.min) %></strong><small>/day</small></div></div>
              <div class="col-4"><div class="rates-tile is-main"><span>Recommended</span><strong><%= eur(bench.recommended) %></strong><small>/day</small></div></div>
              <div class="col-4"><div class="rates-tile"><span>Max</span><strong><%= eur(bench.max) %></strong><small>/day</small></div></div>
            </div>

            <h4 class="rates-subhead">Your position vs market <span class="rates-tag">Community data</span></h4>
            <% if (benchBar) { %>
              <div class="rates-position" role="img" aria-label="Community P25 <%= eur(benchBar.market.p25) %>, median <%= eur(benchBar.market.median) %>, P75 <%= eur(benchBar.market.p75) %>; recommended <%= eur(bench.recommended) %>">
                <span class="rates-position-band" style="left:<%= benchBar.p25 %>%;width:<%= (benchBar.p75 - benchBar.p25).toFixed(1) %>%"></span>
                <span class="rates-position-median" style="left:<%= benchBar.median %>%"></span>
                <span class="rates-position-you" style="left:<%= benchBar.you %>%"><i class="bi bi-caret-down-fill"></i></span>
              </div>
              <div class="d-flex justify-content-between small text-muted-2 mb-1">
                <span>P25 <%= eur(benchBar.market.p25) %></span><span>Median <%= eur(benchBar.market.median) %></span><span>P75 <%= eur(benchBar.market.p75) %></span>
              </div>
              <p class="small text-muted-2 mb-3"><%= benchMarket.contributors %> contributors · <%= roleLabel(bench.inputs.role) %>, <%= seniorityLabel(bench.inputs.experience) %>, contract, last 12 months. ▼ is the recommended rate.</p>
            <% } else { %>
              <p class="small text-muted-2 mb-3"><i class="bi bi-dash-circle"></i> Not enough community data — <%= benchMarket ? benchMarket.contributors : 0 %> of the <%= minSample %> contributors needed for <%= roleLabel(bench.inputs.role) %>, <%= seniorityLabel(bench.inputs.experience) %>.</p>
            <% } %>

            <div class="row g-2 text-center mb-2">
              <div class="col-4"><div class="rates-mini"><span>Monthly</span><strong><%= eur(bench.year.monthly) %></strong></div></div>
              <div class="col-4"><div class="rates-mini"><span>Annual</span><strong><%= eur(bench.year.annual) %></strong></div></div>
              <div class="col-4"><div class="rates-mini"><span>Equiv. salary</span><strong><%= eur(bench.year.equivalentSalary) %></strong></div></div>
            </div>
            <p class="small text-muted-2"><%= bench.year.billableDays %> billable days a year after <%= bench.year.nonBillableDays %> days of holiday, illness, bench, admin and training. <a href="/rates/calculator?dayRate=<%= bench.recommended %>&role=<%= encodeURIComponent(bench.inputs.role) %>&seniority=<%= bench.inputs.experience %>">Change the assumptions → Contract rate calculator</a></p>

            <div class="rates-note rates-note-tip">
              <i class="bi bi-lightbulb"></i>
              <p class="mb-0"><strong>Tip:</strong>
                <% if (benchBar && bench.recommended < benchBar.market.p25) { %>
                  The model puts you below most contributors in this group. If your experience is at the top of its band, the community median is the better anchor.
                <% } else if (benchBar && bench.recommended > benchBar.market.p75) { %>
                  The model puts you above most contributors in this group. Be ready to show what justifies the premium — certifications, industry depth, a reference.
                <% } else { %>
                  Quote the recommended rate and keep the minimum as your floor: negotiate scope or duration before you negotiate the rate.
                <% } %>
              </p>
            </div>
            <div class="rates-note">
              <i class="bi bi-info-circle"></i>
              <p class="mb-0"><strong>Equiv. salary</strong> is the annual revenue at the recommended rate less the running costs a contractor pays and an employee does not (insurance, accounting, software, certification: <%= eur(bench.year.costs) %> a year by default) — the gross salary that would leave you with the same money before tax. Pension and benefits are not included.</p>
            </div>

            <details class="rates-working small">
              <summary>How this was calculated</summary>
              <ul class="list-unstyled mb-0">
                <li><span>Base rate, <%= roleLabel(bench.inputs.role) %></span><span><%= eur(bench.steps.base) %></span></li>
                <li><span>× <%= bench.steps.experience.label %></span><span>× <%= bench.steps.experience.multiplier %></span></li>
                <li><span>× <%= bench.steps.region.label %></span><span>× <%= bench.steps.region.multiplier %></span></li>
                <li><span>= Before adjustments</span><span><%= eur(bench.steps.beforeAdjustments) %></span></li>
                <% bench.steps.adjustments.forEach(function (a) { %>
                  <li><span><%= a.label %></span><span><%= a.bps > 0 ? '+' : '' %><%= (a.bps / 100).toFixed(1) %>%</span></li>
                <% }); %>
                <li class="fw-semibold"><span>Recommended, to the nearest €<%= model.ROUND_TO %></span><span><%= eur(bench.recommended) %></span></li>
                <li><span>Min / max: ∓<%= model.SPREAD_BPS / 100 %>%</span><span><%= eur(bench.min) %> – <%= eur(bench.max) %></span></li>
              </ul>
            </details>
          </div>
        <% } else { %>
          <div class="rates-empty-result">
            <i class="bi bi-arrow-up-circle"></i>
            <span>Choose a role and press <strong>Calculate rate</strong> to see a min, recommended and max day rate.</span>
          </div>
        <% } %>
      </div>

      <div class="rates-card rates-keep mt-4">
        <span class="icon-tile icon-navyblue"><i class="bi bi-piggy-bank"></i></span>
        <div>
          <h3 class="h6 mb-1">Now keep more of it</h3>
          <p class="small text-muted-2 mb-2">Keep your clients and your location, and be employed through our Albania entity.
            <% if (programFee) { %>The program fee is <strong><%= programFee %></strong>.<% } %>
            Your home-country tax obligations still apply.</p>
          <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-sm btn-primary" href="/tax-optimization">Tax optimization</a>
            <a class="btn btn-sm btn-outline-primary" href="/tax-optimization/enquire">Talk to us</a>
          </div>
        </div>
      </div>
    </div>

    <%# ---------------- RIGHT: community charts ---------------- %>
    <div class="col-lg-6">
      <div class="rates-card mb-4" id="trend">
        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
          <h2 class="h5 mb-0">Market rate trend</h2>
          <span class="rates-tag">Community data</span>
        </div>
        <form method="get" action="/rates#trend" class="row g-2 align-items-end mb-3 rates-autosubmit">
          <% hidden(['t_']).forEach(function (kv) { %><input type="hidden" name="<%= kv[0] %>" value="<%= kv[1] %>"><% }); %>
          <div class="col-sm-6">
            <label class="form-label small mb-1" for="t-role">Role</label>
            <select class="form-select form-select-sm" id="t-role" name="t_role">
              <option value="">All roles</option>
              <% roleCategories.forEach(function (cat) { %>
                <optgroup label="<%= cat.category %>">
                  <% cat.roles.forEach(function (r) { %><option value="<%= r.value %>" <%= state.t_role === r.value ? 'selected' : '' %>><%= r.label %></option><% }); %>
                </optgroup>
              <% }); %>
            </select>
          </div>
          <div class="col-sm-6">
            <label class="form-label small mb-1" for="t-window">Period</label>
            <select class="form-select form-select-sm" id="t-window" name="t_window">
              <% Object.keys(trendWindows).forEach(function (k) { %><option value="<%= k %>" <%= tWindow === k ? 'selected' : '' %>><%= trendWindows[k].label %></option><% }); %>
            </select>
          </div>
          <noscript><div class="col-12"><button class="btn btn-sm btn-outline-primary" type="submit">Show</button></div></noscript>
        </form>
        <% const g = trendChart; %>
        <svg class="rates-chart" viewBox="0 0 <%= g.width %> <%= g.height %>" role="img" aria-label="Median contract day rate per <%= tWindow === '12m' ? 'month' : (tWindow === '12w' ? 'week' : 'day') %>, with contributor counts; periods with fewer than <%= minSample %> contributors are gaps">
          <% g.yTicks.forEach(function (t) { %>
            <line class="grid" x1="<%= g.plot.x %>" x2="<%= g.plot.x + g.plot.width %>" y1="<%= t.y %>" y2="<%= t.y %>"></line>
            <text class="axis" x="<%= g.plot.x - 8 %>" y="<%= t.y + 4 %>" text-anchor="end">€<%= t.label %></text>
          <% }); %>
          <% g.cTicks.forEach(function (t) { %>
            <text class="axis axis-count" x="<%= g.plot.x + g.plot.width + 8 %>" y="<%= t.y + 4 %>"><%= t.label %></text>
          <% }); %>
          <% g.bars.forEach(function (b) { %>
            <rect class="count-bar<%= b.gap ? ' is-gap' : '' %>" x="<%= b.x %>" y="<%= b.y %>" width="<%= b.width %>" height="<%= b.height %>"><title><%= b.period %>: <%= b.contributors %> contributor<%= b.contributors === 1 ? '' : 's' %><%= b.gap ? ' — not enough to publish' : '' %></title></rect>
          <% }); %>
          <% g.segments.forEach(function (seg) { %>
            <% if (seg.length > 1) { %><polyline class="median-line" points="<%= seg.map(function (p) { return p.x + ',' + p.y; }).join(' ') %>"></polyline><% } %>
            <% seg.forEach(function (p) { %><circle class="median-dot" cx="<%= p.x %>" cy="<%= p.y %>" r="3.5"><title><%= p.period %>: median €<%= p.value %> (<%= p.contributors %> contributors)</title></circle><% }); %>
          <% }); %>
          <% g.xLabels.forEach(function (l) { %>
            <text class="axis" x="<%= l.x %>" y="<%= g.height - 10 %>" text-anchor="middle"><%= l.label %></text>
          <% }); %>
          <% if (!g.hasData) { %>
            <text class="axis empty" x="<%= g.width / 2 %>" y="<%= g.plot.y + g.plot.height / 2 %>" text-anchor="middle">No period has <%= minSample %> contributors yet</text>
          <% } %>
        </svg>
        <div class="rates-legend small">
          <span><i class="lg-line"></i> Median day rate (€)</span>
          <span><i class="lg-bar"></i> Contributors (right axis)</span>
        </div>
        <p class="small text-muted-2 mt-2 mb-0">A period with fewer than <%= minSample %> contributors is a gap, not a zero: drawing a line through missing data would invent it. Its contributor count is still shown.</p>
      </div>

      <div class="rates-card" id="by-role-chart">
        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
          <h2 class="h5 mb-0">Rates by role</h2>
          <span class="rates-tag">Community data</span>
        </div>
        <p class="small text-muted-2">Contract day rates, last 12 months. Only roles with at least <%= minSample %> contributors.</p>
        <% if (ratesByRole.length) { %>
          <% const peak = Math.max.apply(null, ratesByRole.map(function (r) { return r.p75; })); %>
          <div class="rates-bars">
            <% ratesByRole.forEach(function (r) { %>
              <div class="rates-bar-row">
                <a class="rates-bar-label" href="/rates?role=<%= r.role %>#community"><%= roleLabel(r.role) %></a>
                <div class="rates-bar-group" role="img" aria-label="P25 <%= eur(r.p25) %>, median <%= eur(r.median) %>, P75 <%= eur(r.p75) %>, <%= r.contributors %> contributors">
                  <span class="b-p25" style="width:<%= (r.p25 / peak * 100).toFixed(1) %>%"></span>
                  <span class="b-median" style="width:<%= (r.median / peak * 100).toFixed(1) %>%"></span>
                  <span class="b-p75" style="width:<%= (r.p75 / peak * 100).toFixed(1) %>%"></span>
                </div>
                <span class="rates-bar-figure"><%= eur(r.median) %> <small>(<%= r.contributors %>)</small></span>
              </div>
            <% }); %>
          </div>
          <div class="rates-legend small mt-2">
            <span><i class="lg-p25"></i> P25</span><span><i class="lg-median"></i> Median</span><span><i class="lg-p75"></i> P75</span>
          </div>
        <% } else { %>
          <div class="empty-state"><i class="bi bi-bar-chart"></i> No role has <%= minSample %> contributors yet.</div>
        <% } %>
      </div>
    </div>
  </div>
</div>
</section>

<%# ---------------- 3. COMMUNITY RATE INDEX ---------------- %>
<section class="tax-section tax-section-alt" id="community">
<div class="container">
  <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <div>
      <h2 class="sow-block-title mb-1">Community rate index</h2>
      <p class="text-muted-2 mb-0">Share your rate — anonymous by design: only groups of <%= minSample %>+ are ever shown.</p>
    </div>
    <span class="rates-tag">Community data</span>
  </div>

  <div class="rates-card mb-4" id="share">
    <% if (shareErrors.length) { %>
      <div class="alert alert-danger" role="alert"><ul class="mb-0 ps-3"><% shareErrors.forEach(function (e) { %><li><%= e %></li><% }); %></ul></div>
    <% } %>
    <form method="post" action="/rates/submit" class="row g-2 align-items-end rates-share">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% const sf = shareForm; %>
      <div class="col-lg-3 col-md-6">
        <label class="form-label small mb-1" for="s-role">Role</label>
        <select class="form-select" id="s-role" name="role" required <%= canShare ? '' : 'disabled' %>>
          <option value="">Choose</option>
          <% roleCategories.forEach(function (cat) { %>
            <optgroup label="<%= cat.category %>">
              <% cat.roles.forEach(function (r) { %><option value="<%= r.value %>" <%= (sf.role || state.role) === r.value ? 'selected' : '' %>><%= r.label %></option><% }); %>
            </optgroup>
          <% }); %>
        </select>
      </div>
      <div class="col-lg-2 col-md-6">
        <label class="form-label small mb-1" for="s-engagement">Engagement</label>
        <select class="form-select" id="s-engagement" name="engagement_type" data-amount-label="#s-amount-label" <%= canShare ? '' : 'disabled' %>>
          <option value="contract" <%= sf.engagement_type !== 'permanent' ? 'selected' : '' %>>Contract</option>
          <option value="permanent" <%= sf.engagement_type === 'permanent' ? 'selected' : '' %>>Permanent</option>
        </select>
      </div>
      <div class="col-lg-2 col-md-4">
        <label class="form-label small mb-1" for="s-amount" id="s-amount-label"><%= sf.engagement_type === 'permanent' ? 'Annual salary (EUR)' : 'Day rate (EUR)' %></label>
        <input class="form-control" id="s-amount" name="amount" type="number" min="1" step="any" inputmode="decimal" required value="<%= sf.amount || '' %>" <%= canShare ? '' : 'disabled' %>>
      </div>
      <div class="col-lg-1 col-md-3">
        <label class="form-label small mb-1" for="s-years">Years exp.</label>
        <input class="form-control" id="s-years" name="years" type="number" min="0" max="60" step="1" required value="<%= sf.years || '' %>" <%= canShare ? '' : 'disabled' %>>
      </div>
      <div class="col-lg-2 col-md-5">
        <label class="form-label small mb-1" for="s-country">Country <span class="text-muted-2">(optional)</span></label>
        <select class="form-select" id="s-country" name="country" <%= canShare ? '' : 'disabled' %>>
          <option value="">Prefer not to say</option>
          <%- include('_country_options', { groups: countryGroups, selected: sf.country || '', withRest: true }) %>
        </select>
      </div>
      <div class="col-lg-2">
        <% if (canShare) { %>
          <button class="btn btn-primary w-100" type="submit"><i class="bi bi-share"></i> Share my rate</button>
        <% } else if (!signedIn) { %>
          <a class="btn btn-primary w-100" href="/auth/login?redirect=%2Frates%23share">Sign in to share</a>
        <% } else { %>
          <a class="btn btn-outline-primary w-100" href="/profile/settings">Add the consultant role</a>
        <% } %>
      </div>
    </form>
    <p class="small text-muted-2 mt-2 mb-0">Your figure counts towards this month and is never shown on its own. Sharing again this month replaces it.<% if (!canShare) { %> Shared by consultants with a verified email.<% } %></p>
  </div>

  <form class="rates-card mb-3" method="get" action="/rates#community">
    <% hidden(['role', 'seniority', 'engagement_type', 'country']).forEach(function (kv) { %><input type="hidden" name="<%= kv[0] %>" value="<%= kv[1] %>"><% }); %>
    <div class="row g-2 align-items-end">
      <div class="col-md-4">
        <label class="form-label small mb-1" for="r-role">Role</label>
        <select class="form-select" id="r-role" name="role">
          <option value="">All roles</option>
          <% roleCategories.forEach(function (cat) { %>
            <optgroup label="<%= cat.category %>">
              <% cat.roles.forEach(function (r) { %><option value="<%= r.value %>" <%= filters.role === r.value ? 'selected' : '' %>><%= r.label %></option><% }); %>
            </optgroup>
          <% }); %>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small mb-1" for="r-seniority">Seniority</label>
        <select class="form-select" id="r-seniority" name="seniority">
          <option value="">All</option>
          <% seniorities.forEach(function (s) { %><option value="<%= s %>" <%= filters.seniority === s ? 'selected' : '' %>><%= seniorityLabel(s) %></option><% }); %>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small mb-1" for="r-engagement">Type</label>
        <select class="form-select" id="r-engagement" name="engagement_type">
          <option value="contract" <%= filters.engagementType === 'contract' ? 'selected' : '' %>>Contract</option>
          <option value="permanent" <%= filters.engagementType === 'permanent' ? 'selected' : '' %>>Permanent</option>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label small mb-1" for="r-country">Country</label>
        <select class="form-select" id="r-country" name="country">
          <option value="">All countries</option>
          <%- include('_country_options', { groups: countryGroups, selected: filters.country, withRest: true }) %>
        </select>
      </div>
      <div class="col-md-1"><button class="btn btn-primary w-100" type="submit">Go</button></div>
    </div>
  </form>

  <% const unit = filters.engagementType === 'contract' ? '/day' : '/year'; %>
  <p class="small mb-3">
    <strong><%= filters.role ? roleLabel(filters.role) : 'All roles' %><%= filters.seniority ? ' · ' + seniorityLabel(filters.seniority) : '' %><%= filters.country ? ' · ' + countryName(filters.country) : '' %> · <%= filters.engagementType === 'contract' ? 'Contract' : 'Permanent' %>:</strong>
    <% if (summary.suppressed) { %>
      not published — <%= summary.contributors %> of the <%= minSample %> contributors needed.
    <% } else { %>
      median <strong><%= eur(summary.median) %><%= unit %></strong> · P25–P75 <%= eur(summary.p25) %>–<%= eur(summary.p75) %> · <%= summary.contributors %> contributors
    <% } %>
  </p>

  <div class="rates-card">
    <ul class="nav nav-pills mb-3" role="tablist">
      <li class="nav-item" role="presentation"><button class="nav-link active" id="tab-by-role" data-bs-toggle="pill" data-bs-target="#pane-by-role" type="button" role="tab" aria-controls="pane-by-role" aria-selected="true">By role</button></li>
      <li class="nav-item" role="presentation"><button class="nav-link" id="tab-by-exp" data-bs-toggle="pill" data-bs-target="#pane-by-exp" type="button" role="tab" aria-controls="pane-by-exp" aria-selected="false">By experience</button></li>
      <li class="nav-item" role="presentation"><button class="nav-link" id="tab-by-region" data-bs-toggle="pill" data-bs-target="#pane-by-region" type="button" role="tab" aria-controls="pane-by-region" aria-selected="false">By region</button></li>
    </ul>
    <div class="tab-content">
      <% const indexTable = function (rows, labelOf, hrefOf) { return { rows: rows, labelOf: labelOf, hrefOf: hrefOf }; }; %>
      <div class="tab-pane fade show active" id="pane-by-role" role="tabpanel" aria-labelledby="tab-by-role" tabindex="0">
        <%- include('_index_table', { t: indexTable(byRole, function (r) { return roleLabel(r.role); }, function (r) { return '/rates?role=' + encodeURIComponent(r.role) + '#community'; }), first: 'Role', unit: unit, minSample: minSample, eur: eur }) %>
      </div>
      <div class="tab-pane fade" id="pane-by-exp" role="tabpanel" aria-labelledby="tab-by-exp" tabindex="0">
        <%- include('_index_table', { t: indexTable(bySeniority, function (r) { return seniorityLabel(r.seniority, true); }, null), first: 'Experience', unit: unit, minSample: minSample, eur: eur }) %>
      </div>
      <div class="tab-pane fade" id="pane-by-region" role="tabpanel" aria-labelledby="tab-by-region" tabindex="0">
        <%- include('_index_table', { t: indexTable(byRegion, function (r) { return regionLabels.get(r.region); }, null), first: 'Region', unit: unit, minSample: minSample, eur: eur }) %>
        <p class="small text-muted-2 mt-2 mb-0">Figures shared without a country are counted in the other tabs but not here.</p>
      </div>
    </div>
    <p class="rates-asked small mb-0">
      <i class="bi bi-send"></i>
      <% if (!asked.suppressed) { %>
        Asked on applications: <strong><%= eur(asked.mean) %>/day</strong> on average across contract applications by <%= asked.people %> consultants in the last 12 months.
      <% } else { %>
        Asked on applications: not shown until at least <%= minSample %> consultants have put a day rate on a contract application in the last 12 months (<%= asked.people %> so far).
      <% } %>
    </p>
  </div>
</div>
</section>

<%# ---------------- 4. DAY RATE BUDGETS ---------------- %>
<section class="tax-section glass-section" id="budgets">
<div class="container">
  <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <div>
      <h2 class="sow-block-title mb-1">Day rate budgets (contract jobs)</h2>
      <p class="text-muted-2 mb-0">What companies publish on open contract adverts, in EUR per day. A hidden rate is never counted.</p>
    </div>
    <span class="rates-tag rates-tag-jobs">Job postings</span>
  </div>
  <div class="rates-card">
    <form method="get" action="/rates#budgets" class="row g-2 align-items-end mb-3 rates-autosubmit">
      <% hidden(['j_']).forEach(function (kv) { %><input type="hidden" name="<%= kv[0] %>" value="<%= kv[1] %>"><% }); %>
      <div class="col-sm-6 col-lg-4">
        <label class="form-label small mb-1" for="j-role">Role</label>
        <select class="form-select form-select-sm" id="j-role" name="j_role">
          <option value="">All roles</option>
          <% roleCategories.forEach(function (cat) { %>
            <optgroup label="<%= cat.category %>">
              <% cat.roles.forEach(function (r) { %><option value="<%= r.value %>" <%= state.j_role === r.value ? 'selected' : '' %>><%= r.label %></option><% }); %>
            </optgroup>
          <% }); %>
        </select>
      </div>
      <div class="col-sm-6 col-lg-3">
        <label class="form-label small mb-1" for="j-days">Posted in the last</label>
        <select class="form-select form-select-sm" id="j-days" name="j_days">
          <% jobWindows.forEach(function (w) { %><option value="<%= w.value %>" <%= jDays === w.value ? 'selected' : '' %>><%= w.label %></option><% }); %>
        </select>
      </div>
      <noscript><div class="col-auto"><button class="btn btn-sm btn-outline-primary" type="submit">Show</button></div></noscript>
    </form>
    <% if (budgets.length) { %>
      <% const top = Math.max.apply(null, budgets.map(function (b) { return b.medianMax; })); %>
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0 rates-table">
          <thead><tr><th>Role</th><th class="w-50">Budget range (median of each end)</th><th class="text-end">Min</th><th class="text-end">Max</th><th class="text-end">Postings</th></tr></thead>
          <tbody>
            <% budgets.forEach(function (b) { %>
              <tr>
                <td><a href="/jobs?role=<%= b.role %>"><%= roleLabel(b.role) %></a></td>
                <td><div class="rates-range"><span style="left:<%= (b.medianMin / top * 100).toFixed(1) %>%;width:<%= Math.max(1, (b.medianMax - b.medianMin) / top * 100).toFixed(1) %>%"></span></div></td>
                <td class="text-end"><%= eur(b.medianMin) %></td>
                <td class="text-end"><%= eur(b.medianMax) %></td>
                <td class="text-end"><%= b.postings %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="empty-state"><i class="bi bi-briefcase"></i> No open contract job with a published day rate<%= state.j_role ? ' for ' + roleLabel(state.j_role) : '' %> in this period yet. <a href="/jobs">Browse jobs</a></div>
    <% } %>
  </div>
</div>
</section>

<%# ---------------- 5. ANNUAL SALARIES ---------------- %>
<section class="tax-section tax-section-alt" id="salaries">
<div class="container">
  <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <div>
      <h2 class="sow-block-title mb-1">Annual salaries (permanent positions)</h2>
      <p class="text-muted-2 mb-0">From the salary ranges companies publish on open permanent adverts.</p>
    </div>
    <span class="rates-tag rates-tag-jobs">Job postings</span>
  </div>
  <% if (salaries.postings) { %>
    <div class="row g-3 mb-3">
      <div class="col-md-4"><div class="rates-card text-center"><span class="rates-stat-label">Average minimum</span><strong class="rates-stat"><%= eur(salaries.avgMin) %></strong><small class="text-muted-2">≈ <%= eur(salaries.perDayMin) %>/day</small></div></div>
      <div class="col-md-4"><div class="rates-card text-center"><span class="rates-stat-label">Average maximum</span><strong class="rates-stat"><%= eur(salaries.avgMax) %></strong><small class="text-muted-2">≈ <%= eur(salaries.perDayMax) %>/day</small></div></div>
      <div class="col-md-4"><div class="rates-card text-center"><span class="rates-stat-label">Range</span><strong class="rates-stat"><%= eur(salaries.rangeMin) %> – <%= eur(salaries.rangeMax) %></strong><small class="text-muted-2"><%= salaries.postings %> posting<%= salaries.postings === 1 ? '' : 's' %></small></div></div>
    </div>
    <div class="rates-card">
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0 rates-table">
          <thead><tr><th>Experience level</th><th class="text-end">Average min</th><th class="text-end">Average max</th><th class="text-end">Postings</th></tr></thead>
          <tbody>
            <% salaries.bySeniority.forEach(function (s) { %>
              <tr><td><%= seniorityLabel(s.seniority, true) %></td><td class="text-end"><%= eur(s.avgMin) %></td><td class="text-end"><%= eur(s.avgMax) %></td><td class="text-end"><%= s.postings %></td></tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <p class="small text-muted-2 mt-2 mb-0">≈ €/day divides by the <%= salaries.paidDays %> days a year an employee is paid for (working days less holiday, as in the contract rate calculator).</p>
    </div>
  <% } else { %>
    <div class="rates-card"><div class="empty-state"><i class="bi bi-building"></i> No open permanent job with a published salary yet. <a href="/jobs?engagement_type=permanent">Browse permanent jobs</a></div></div>
  <% } %>
</div>
</section>

<%# ---------------- 6. RATE BENCHMARKS BY ROLE ---------------- %>
<section class="tax-section glass-section" id="roles">
<div class="container">
  <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <h2 class="sow-block-title mb-0">Rate benchmarks by role</h2>
    <a href="/rates#community">All roles →</a>
  </div>
  <div class="rates-chips">
    <% roleCategories.forEach(function (cat) { %>
      <% cat.roles.forEach(function (r) { %><a class="rates-chip<%= filters.role === r.value ? ' is-active' : '' %>" href="/rates?role=<%= r.value %>#community"><%= r.label %></a><% }); %>
    <% }); %>
  </div>
</div>
</section>

<%# ---------------- 7. METHODOLOGY ---------------- %>
<section class="tax-section tax-section-alt" id="methodology">
<div class="container">
  <h2 class="sow-block-title text-center mb-4">Methodology &amp; data quality</h2>
  <div class="row justify-content-center"><div class="col-lg-9">
    <div class="accordion tax-faq" id="method">
      <% const methods = [
        ['One figure per person per month', ['Every figure counts one PERSON, not one submission. Sharing again in the same month replaces your earlier figure for that role and experience level, and where somebody has several figures in a group, their own median stands in for them — so nobody can move a group by submitting twice.']],
        ['The ' + minSample + '-person threshold', ['A group with fewer than ' + minSample + ' people is not published. Its count is shown, its figures are not, so the page can say "2 contributors, not enough to show" rather than pretending the group is empty — and so nobody\'s pay can be read off a group of one or two.']],
        ['Gaps, not zeros', ['In the trend, a period below the threshold is a gap in the line. It is never drawn as zero and never bridged, because a line through a month with too few contributors invents a figure for it.']],
        ['Median and percentiles, not averages', ['The headline is the MEDIAN — the middle person — with P25 and P75 for the spread. An average lets one very high or very low figure move the number for everybody. Percentiles are nearest-rank, so every value shown is one somebody actually gave.']],
        ['How this stays honest', ['Figures an administrator establishes are wrong — most often an annual salary typed into a day-rate field — are excluded from every calculation and can never be quietly corrected. Contract figures above €5,000 a day and permanent figures below €5,000 a year are refused when shared, for the same reason. Amounts in other currencies are converted at a fixed rate frozen when they were given, so a published figure never changes because an exchange rate moved.']],
        ['Job postings', ['Day rate budgets and salaries come from open adverts whose company chose to show the figure; a hidden rate is never counted. Each figure has its posting count beside it. "Asked on applications" is the average of the day rates consultants put on contract applications, one figure per consultant, shown only from ' + minSample + ' consultants.']]
      ]; %>
      <% methods.forEach(function (m, i) { %>
        <div class="accordion-item">
          <h3 class="accordion-header" id="m-h-<%= i %>"><button class="accordion-button <%= i === 0 ? '' : 'collapsed' %>" type="button" data-bs-toggle="collapse" data-bs-target="#m-<%= i %>" aria-expanded="<%= i === 0 %>" aria-controls="m-<%= i %>"><%= m[0] %></button></h3>
          <div id="m-<%= i %>" class="accordion-collapse collapse <%= i === 0 ? 'show' : '' %>" aria-labelledby="m-h-<%= i %>" data-bs-parent="#method">
            <div class="accordion-body"><% m[1].forEach(function (p) { %><p class="mb-0"><%= p %></p><% }); %></div>
          </div>
        </div>
      <% }); %>
      <div class="accordion-item">
        <h3 class="accordion-header" id="m-h-model"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#m-model" aria-expanded="false" aria-controls="m-model">The editorial model and its adjustments</button></h3>
        <div id="m-model" class="accordion-collapse collapse" aria-labelledby="m-h-model" data-bs-parent="#method">
          <div class="accordion-body small">
            <p>Benchmark my rate is our own published judgement, not community data, and the two are never blended. Recommended = base rate for the role × experience × region × (1 + the adjustments below), to the nearest €<%= model.ROUND_TO %>; min and max are ∓<%= model.SPREAD_BPS / 100 %>%. Monthly, annual and equivalent salary use the contract rate calculator's year: <a href="/rates/calculator">see its assumptions</a>.</p>
            <div class="row g-3">
              <div class="col-md-6">
                <h4 class="h6">Experience</h4>
                <ul class="rates-method-list"><% model.EXPERIENCE.forEach(function (e) { %><li><span><%= e.label %></span><span>× <%= e.multiplier %></span></li><% }); %></ul>
                <h4 class="h6">Region</h4>
                <ul class="rates-method-list"><% model.REGIONS.forEach(function (r) { %><li><span><%= r.label %></span><span>× <%= r.multiplier %></span></li><% }); %></ul>
                <h4 class="h6">Certifications and skills</h4>
                <ul class="rates-method-list">
                  <li><span>Each certification (up to <%= model.CERTIFICATIONS.max %>)</span><span>+<%= (model.CERTIFICATIONS.bpsEach / 100).toFixed(1) %>%</span></li>
                  <li><span>Each additional skill (up to <%= model.SKILLS.max %>)</span><span>+<%= (model.SKILLS.bpsEach / 100).toFixed(1) %>%</span></li>
                </ul>
              </div>
              <div class="col-md-6">
                <h4 class="h6">Work arrangement</h4>
                <ul class="rates-method-list"><% model.ARRANGEMENTS.forEach(function (a) { %><li><span><%= a.label %></span><span><%= a.bps > 0 ? '+' : '' %><%= (a.bps / 100).toFixed(1) %>%</span></li><% }); %></ul>
                <h4 class="h6">Industry</h4>
                <ul class="rates-method-list"><% model.INDUSTRIES.forEach(function (a) { %><li><span><%= a.label %></span><span><%= a.bps > 0 ? '+' : '' %><%= (a.bps / 100).toFixed(1) %>%</span></li><% }); %></ul>
                <h4 class="h6">Contract type</h4>
                <ul class="rates-method-list"><% model.CONTRACT_TYPES.forEach(function (a) { %><li><span><%= a.label %></span><span><%= a.bps > 0 ? '+' : '' %><%= (a.bps / 100).toFixed(1) %>%</span></li><% }); %></ul>
              </div>
            </div>
            <p class="mb-0">Confidence reflects how many people stand behind the community comparison for the same role and experience: High from <%= model.CONFIDENCE[0].minContributors %>, Medium from <%= model.CONFIDENCE[1].minContributors %>, otherwise Low.</p>
          </div>
        </div>
      </div>
    </div>
  </div></div>
</div>
</section>

<script src="/js/rates-page.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>" defer></script>

<%- include('../partials/layout-end') %>
