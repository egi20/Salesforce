<a class="skip-link" href="#main">Skip to content</a>
<nav class="navbar navbar-expand-lg navbar-hub sticky-top" aria-label="Main">
  <div class="container">
    <a class="navbar-brand d-inline-flex align-items-center gap-2" href="/">
      <%# Decorative: the wordmark beside it already names the site, so a screen reader %>
      <%# announcing both would read it twice. %>
      <span class="brand-tile" aria-hidden="true">
        <img src="/images/logo-mark.svg" alt="" width="30" height="30" class="brand-mark">
      </span>
      <span>Salesforce <span class="cloud">Hub</span></span>
    </a>
    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
            aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="mainNav">
      <%
        /*
         * Grouped into hubs rather than one flat row.
         *
         * A flat list grows until nothing in it is findable. Grouping by WHO the item is
         * for — someone looking for work, someone hiring — means a person only ever reads
         * the half that is theirs. Items behind a sign-in appear only when signed in;
         * showing them to a stranger and then bouncing them to a login is a worse
         * experience than not offering them.
         */
        const path = currentPath;
        const startsWith = (p) => path === p || path.startsWith(p + '/');
        /*
         * `/jobs` is a consultant page and `/jobs/new` is a company one, so the prefix
         * cannot decide alone: posting a role lit up "Consultant Hub", which is the menu
         * the author is not in. The company-side paths under /jobs are named, and the
         * consultant test excludes them.
         */
        const companyJobPaths = ['/jobs/new'];
        const isCompanyJobPath = companyJobPaths.some((p) => startsWith(p));
        /*
         * Rates and tax moved to Services, so they no longer light up Consultant Hub. The
         * document generator is a /services/ page but a tool rather than an engagement
         * model, so it belongs to Services too, and the company test excludes it.
         */
        const isConsultantArea = startsWith('/consultant-hub') || startsWith('/cv-generator') || (!isCompanyJobPath && startsWith('/jobs'))
          || (currentUser && (startsWith('/profile/consultant') || startsWith('/profile/settings')));
        const isServicesArea = startsWith('/quotes') || startsWith('/rates') || startsWith('/tax-optimization')
          || startsWith('/services/document-generator');
        const isCompanyArea = !isServicesArea && (isCompanyJobPath || startsWith('/companies-hub')
          || startsWith('/consultants') || startsWith('/companies') || startsWith('/recruiters')
          || startsWith('/services')
          || (currentUser && (startsWith('/dashboard/jobs')
            || startsWith('/dashboard/applicants') || startsWith('/applications'))));
      %>

      <ul class="navbar-nav mx-lg-auto align-items-lg-center">
        <li class="nav-item">
          <%# Home IS the community feed, so the forum and stories live under it rather than %>
          <%# under a Community menu of their own — the sister site's layout. The challenges are %>
          <%# reached from the account menu and the footer, and do not light up Home. %>
          <a class="nav-link <%= path === '/' || startsWith('/community') || startsWith('/success-stories') ? 'active' : '' %>" href="/"><i class="bi bi-house"></i> Home</a>
        </li>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle <%= isConsultantArea ? 'active' : '' %>" href="#" role="button"
             data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
            <i class="bi bi-person-badge"></i> Consultant Hub <i class="bi bi-chevron-down nav-caret" aria-hidden="true"></i>
          </a>
          <ul class="dropdown-menu shadow-sm">
            <li><a class="dropdown-item" href="/consultant-hub"><i class="bi bi-grid"></i> Consultant Hub</a></li>
            <li><a class="dropdown-item" href="/jobs"><i class="bi bi-briefcase"></i> Find Jobs</a></li>
            <%# A visitor builds a profile by signing up; a consultant edits the one they have. %>
            <li><a class="dropdown-item" href="<%= currentUser ? '/profile/settings' : '/auth/register' %>"><i class="bi bi-person-gear"></i> Build Profile</a></li>
            <li><a class="dropdown-item" href="/cv-generator"><i class="bi bi-file-earmark-person"></i> CV Generator</a></li>
            <% if (currentUser && currentUser.isConsultant) { %>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="/dashboard/applications"><i class="bi bi-send"></i> Your applications</a></li>
              <li><a class="dropdown-item" href="/dashboard/saved"><i class="bi bi-bookmark"></i> Saved jobs</a></li>
              <li><a class="dropdown-item" href="/rates#share"><i class="bi bi-plus-circle"></i> Contribute your rate</a></li>
              <li><a class="dropdown-item" href="/profile/consultant/download/package"><i class="bi bi-file-earmark-arrow-down"></i> Your CV and rate card</a></li>
            <% } %>
          </ul>
        </li>

        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle <%= isCompanyArea ? 'active' : '' %>" href="#" role="button"
             data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
            <i class="bi bi-building"></i> Companies Hub <i class="bi bi-chevron-down nav-caret" aria-hidden="true"></i>
          </a>
          <ul class="dropdown-menu shadow-sm">
            <%# The company and agency directories are in the footer: a hiring visitor %>
            <%# comes for talent and a quote, and two more lines here buried both. %>
            <li><a class="dropdown-item" href="/companies-hub"><i class="bi bi-grid"></i> Companies Hub</a></li>
            <li><a class="dropdown-item" href="/consultants"><i class="bi bi-people"></i> Browse Talent</a></li>
            <li><a class="dropdown-item" href="/quotes/new#wizard"><i class="bi bi-calculator"></i> Get SOW Quote</a></li>
            <li><hr class="dropdown-divider"></li>
            <%# How an engagement is shaped. Each one ends at a page that already exists. %>
            <li><a class="dropdown-item" href="/services/staff-augmentation"><i class="bi bi-people"></i> Staff Augmentation</a></li>
            <li><a class="dropdown-item" href="/services/project-based"><i class="bi bi-kanban"></i> Project-Based</a></li>
            <li><a class="dropdown-item" href="/services/managed-services"><i class="bi bi-gear"></i> Managed Services</a></li>
            <% if (currentUser && (currentUser.isCompany || currentUser.isRecruiter)) { %>
              <li><hr class="dropdown-divider"></li>
              <%# Posting and its pipeline are `isCompany` in routes/jobs.js and %>
              <%# routes/dashboard.js, so offering them to a recruiter-only account was %>
              <%# offering a door the guard closes. %>
              <% if (currentUser.isCompany) { %>
                <li><a class="dropdown-item" href="/jobs/new"><i class="bi bi-plus-square"></i> Post a role</a></li>
                <li><a class="dropdown-item" href="/dashboard/jobs"><i class="bi bi-briefcase"></i> Your roles</a></li>
                <li><a class="dropdown-item" href="/dashboard/applicants"><i class="bi bi-kanban"></i> Applicants</a></li>
                <li><a class="dropdown-item" href="/profile/company"><i class="bi bi-building-gear"></i> Company profile</a></li>
              <% } %>
              <% if (currentUser.isRecruiter) { %>
                <li><a class="dropdown-item" href="/recruiters/dashboard"><i class="bi bi-speedometer2"></i> Recruiter dashboard</a></li>
                <li><a class="dropdown-item" href="/recruiters/profile"><i class="bi bi-building-gear"></i> Agency profile</a></li>
              <% } %>
            <% } %>
          </ul>
        </li>

        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle <%= isServicesArea ? 'active' : '' %>" href="#" role="button"
             data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
            <i class="bi bi-tools"></i> Services <i class="bi bi-chevron-down nav-caret" aria-hidden="true"></i>
          </a>
          <ul class="dropdown-menu shadow-sm">
            <%# Named to match the sister platforms. The label is all that matches: the page %>
            <%# introduces a specialist and calculates nothing, and it must stay that way. %>
            <li><a class="dropdown-item" href="/tax-optimization"><i class="bi bi-signpost-split"></i> Tax Optimization</a></li>
            <%# The calculator is linked from the top of /rates, so one entry reaches both. %>
            <li><a class="dropdown-item" href="/rates"><i class="bi bi-graph-up"></i> Rate &amp; Salary Index</a></li>
            <li><a class="dropdown-item" href="/quotes/new"><i class="bi bi-file-earmark-ruled"></i> SOW Generator</a></li>
            <li><a class="dropdown-item" href="/services/document-generator"><i class="bi bi-file-earmark-text"></i> Document Generator</a></li>
            <% if (currentUser) { %>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="/quotes"><i class="bi bi-folder2-open"></i> Your quotes</a></li>
            <% } %>
          </ul>
        </li>

        <li class="nav-item">
          <%# "About" points at /about. /faq answers the questions somebody already has; it %>
          <%# was standing in for a page about who this is, and it is a different page. %>
          <a class="nav-link <%= startsWith('/about') || startsWith('/faq') ? 'active' : '' %>" href="/about"><i class="bi bi-info-circle"></i> About</a>
        </li>
      </ul>

      <%
        /*
         * <details>/<summary> rather than a JS-toggled dropdown: the browser opens and
         * closes the panel natively, so with scripting off the search field is still one
         * click away instead of permanently hidden. The form inside still just GETs
         * /search — no token, because a search changes nothing.
         */
      %>
      <details class="nav-search me-lg-3 my-2 my-lg-0">
        <summary class="nav-search-toggle" aria-label="Search"><i class="bi bi-search"></i></summary>
        <form class="nav-search-panel shadow-sm" method="get" action="/search" role="search">
          <label class="visually-hidden" for="navSearch">Search the Hub</label>
          <input class="form-control nav-search-input" id="navSearch" name="q" type="search" maxlength="120"
                 value="<%= currentPath === '/search' && query && query.q ? query.q : '' %>"
                 placeholder="Search jobs, consultants, companies…" aria-label="Search the Hub">
          <p class="nav-search-hint">Search jobs, consultants, companies and community posts</p>
        </form>
      </details>

      <ul class="navbar-nav align-items-lg-center">
        <% if (currentUser) { %>
          <%
            const profileHref = currentUser.isCompany ? '/profile/company'
              : currentUser.isRecruiter ? '/recruiters/profile'
              : '/profile/settings';
          %>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button"
               data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
              <img class="avatar" style="width:30px;height:30px"
                   src="<%= currentUser.profilePicture || '/images/avatar-placeholder-nav.svg' %>" alt="">
              <span class="nav-user-name"><%= currentUser.name %></span>
            </a>
            <div class="dropdown-menu dropdown-menu-end shadow-sm account-menu" id="accountMenu">
              <div class="account-menu-header">
                <img class="avatar" style="width:48px;height:48px"
                     src="<%= currentUser.profilePicture || '/images/avatar-placeholder-nav.svg' %>" alt="">
                <div class="account-menu-identity">
                  <div class="account-menu-name"><%= currentUser.name %></div>
                  <div class="account-menu-email"><%= currentUser.email %></div>
                  <div class="account-menu-badges">
                    <% if (currentUser.isConsultant) { %><span class="badge-hub cloud">CONSULTANT</span><% } %>
                    <% if (currentUser.isCompany) { %><span class="badge-hub cloud">COMPANY</span><% } %>
                    <% if (currentUser.isRecruiter) { %><span class="badge-hub cloud">RECRUITER</span><% } %>
                    <% if (currentUser.isAdmin) { %><span class="badge-hub cloud">ADMIN</span><% } %>
                  </div>
                </div>
              </div>

              <div class="account-menu-notifications">
                <div class="account-menu-notif-head">
                  <span><i class="bi bi-bell"></i> Notifications</span>
                  <span class="account-menu-notif-actions">
                    <a href="/notifications">Show all</a> ·
                    <form method="post" action="/notifications/read-all" class="d-inline" data-no-guard="true">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-link btn-sm p-0 align-baseline">Mark all read</button>
                    </form>
                  </span>
                </div>
                <div id="accountMenuNotifications">
                  <p class="account-menu-notif-empty"><i class="bi bi-bell-slash"></i>No new notifications</p>
                </div>
              </div>

              <div class="account-menu-quicklinks">
                <a href="/dashboard"><i class="bi bi-speedometer2"></i><span>Dashboard</span></a>
                <a href="<%= profileHref %>"><i class="bi bi-person"></i><span>Profile</span></a>
                <a href="/messages"><i class="bi bi-chat-dots"></i><span>Messages
                  <span class="notif-dot d-none" id="messageCount" aria-live="polite"></span></span></a>
                <a href="/profile/settings#account"><i class="bi bi-gear"></i><span>Settings</span></a>
              </div>

              <div class="account-menu-section-label"><i class="bi bi-person-badge"></i> Consultant</div>
              <%# An account without the consultant role is taken to where the role is added. %>
              <a class="dropdown-item" href="/profile/settings"><i class="bi bi-person-gear"></i> Build Profile</a>
              <a class="dropdown-item" href="/dashboard/applications"><i class="bi bi-send"></i> My Applications</a>
              <a class="dropdown-item" href="/cv-generator"><i class="bi bi-file-earmark-person"></i> CV Generator</a>
              <a class="dropdown-item" href="/profile/documents"><i class="bi bi-folder2-open"></i> My documents</a>
              <a class="dropdown-item" href="/dashboard/saved"><i class="bi bi-bookmark"></i> Saved Jobs</a>
              <a class="dropdown-item <%= startsWith('/challenges') ? 'active' : '' %>" href="/challenges"<% if (startsWith('/challenges')) { %> aria-current="page"<% } %>><i class="bi bi-trophy"></i> Challenges</a>

              <% if (currentUser.isCompany) { %>
                <div class="account-menu-section-label"><i class="bi bi-building"></i> Company</div>
                <a class="dropdown-item" href="/profile/company"><i class="bi bi-building-gear"></i> Company Profile</a>
                <a class="dropdown-item" href="/dashboard/jobs"><i class="bi bi-briefcase"></i> Your Roles</a>
                <a class="dropdown-item" href="/jobs/new"><i class="bi bi-plus-square"></i> Post a Role</a>
              <% } %>
              <% if (currentUser.isRecruiter) { %>
                <div class="account-menu-section-label"><i class="bi bi-person-rolodex"></i> Recruiter</div>
                <a class="dropdown-item" href="/recruiters/dashboard"><i class="bi bi-speedometer2"></i> Recruiter Dashboard</a>
                <a class="dropdown-item" href="/recruiters/profile"><i class="bi bi-building-gear"></i> Agency Profile</a>
              <% } %>

              <div class="account-menu-section-label"><i class="bi bi-graph-up-arrow"></i> Referrals</div>
              <a class="dropdown-item" href="/referrals"><i class="bi bi-speedometer2"></i> Agent Dashboard</a>
              <a class="dropdown-item" href="/referrals"><i class="bi bi-people"></i> My Leads</a>

              <% if (currentUser.isAdmin) { %>
                <a class="dropdown-item" href="/admin"><i class="bi bi-shield-lock"></i> Admin Panel</a>
              <% } %>

              <form method="post" action="/auth/logout" data-no-guard="true">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="dropdown-item account-menu-signout" type="submit">
                  <i class="bi bi-box-arrow-right"></i> Sign Out
                </button>
              </form>
            </div>
          </li>
        <% } else { %>
          <%# A matched pair: outlined then filled, both pills, neither wrapping. %>
          <li class="nav-item"><a class="btn btn-outline-primary btn-sm btn-auth" href="/auth/login">Sign In</a></li>
          <li class="nav-item ms-lg-2"><a class="btn btn-primary btn-sm btn-auth" href="/auth/register">Sign Up</a></li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>
