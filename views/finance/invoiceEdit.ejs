<%- include('../partials/layout-start') %>
<%- include('../partials/page-header', { icon: 'bi-receipt', heading: invoice ? 'Edit draft' : 'New invoice' }) %>
<section class="glass-section pb-5"><div class="container">
  <%- include('../partials/flash') %>
  <div class="glass-card"><div class="card-body p-4">
    <form method="post" action="<%= invoice ? '/admin/finance/invoices/' + invoice.id : '/admin/finance/invoices' %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="row g-3 mb-3">
        <div class="col-md-5">
          <label class="form-label" for="client_id">Client</label>
          <select class="form-select" id="client_id" name="client_id" required>
            <option value="">Choose</option>
            <% clients.forEach(function (c) { %>
              <option value="<%= c.id %>" <%= invoice && invoice.client_id === c.id ? 'selected' : '' %>><%= c.name %></option>
            <% }); %>
          </select>
          <div class="form-text"><a href="/admin/finance/clients">Add one</a> if they are not listed.</div>
        </div>
        <div class="col-md-2">
          <label class="form-label" for="currency">Currency</label>
          <select class="form-select" id="currency" name="currency">
            <% currencies.forEach(function (c) { %>
              <option value="<%= c %>" <%= invoice && invoice.currency === c ? 'selected' : '' %>><%= c %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label" for="due_date">Due</label>
          <input class="form-control" id="due_date" name="due_date" type="date"
                 value="<%= invoice && invoice.due_date ? new Date(invoice.due_date).toISOString().slice(0,10) : '' %>">
        </div>
        <div class="col-md-3">
          <label class="form-label" for="reference">Their reference</label>
          <input class="form-control" id="reference" name="reference" maxlength="<%= limits.reference %>"
                 value="<%= invoice && invoice.reference ? invoice.reference : '' %>">
        </div>
      </div>

      <h2 class="h6 mb-2">Lines</h2>
      <%- include('_lineFields', { lines: invoice ? invoice.lines : [] }) %>

      <div class="mb-3">
        <label class="form-label" for="notes">Notes on the invoice</label>
        <textarea class="form-control" id="notes" name="notes" rows="3" maxlength="<%= limits.note %>"><%= invoice && invoice.notes ? invoice.notes : '' %></textarea>
      </div>

      <button class="btn btn-primary" type="submit">Save draft</button>
      <a class="btn btn-link" href="/admin/finance/invoices">Cancel</a>
      <p class="small text-muted-2 mt-3 mb-0">
        A draft carries no number. It gets one when you issue it, and from that moment it
        cannot be edited — only cancelled.
      </p>
    </form>
  </div></div>
</div></section>
<%- include('../partials/layout-end') %>
