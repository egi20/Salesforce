<%- include('../partials/layout-start') %>

<%- include('../partials/page-header', {
  icon: 'bi-check2-square',
  heading: 'Test run',
  sub: new Date(run.ranAt).toISOString().slice(0, 16).replace('T', ' ') + ' UTC' + (run.runByName ? ' · started by ' + run.runByName : '')
}) %>

<section class="glass-section pb-5">
<div class="container">
  <%- include('./_tabs', { current: 'tests' }) %>
  <%- include('../partials/flash') %>

  <p class="mb-3"><a href="/admin/tests"><i class="bi bi-arrow-left" aria-hidden="true"></i> All test cases</a></p>

  <div class="row g-3 mb-4">
    <div class="col-6 col-lg-3"><div class="stat-tile"><div class="value"><%= run.passed %>/<%= run.total %></div><div class="label">passed</div></div></div>
    <div class="col-6 col-lg-3"><div class="stat-tile"><div class="value <%= run.failed ? 'text-danger' : '' %>"><%= run.failed %></div><div class="label">failed</div></div></div>
    <div class="col-6 col-lg-3"><div class="stat-tile"><div class="value"><%= run.skipped %></div><div class="label">skipped, not passed</div></div></div>
    <div class="col-6 col-lg-3"><div class="stat-tile"><div class="value"><%= (run.durationMs / 1000).toFixed(1) %>s</div><div class="label">total request time</div></div></div>
  </div>

  <% if (run.skipped) {
       const reason = run.results.find(function (r) { return r.outcome === 'skipped'; }).error;
  %>
    <div class="alert alert-warning mb-4" role="status">
      <strong><%= run.skipped %> signed-in <%= run.skipped === 1 ? 'case was' : 'cases were' %> not checked.</strong> <%= reason %>
    </div>
  <% } %>

  <div class="glass-card">
    <div class="table-responsive">
      <table class="table table-sm align-middle mb-0">
        <thead><tr><th scope="col">Result</th><th scope="col">Case</th><th scope="col">Expected</th><th scope="col">Got</th><th scope="col">Time</th></tr></thead>
        <tbody>
          <%# Failures first, then skipped, then passes — the reference's order, because the failures are what was asked for. %>
          <% run.results.forEach(function (r) { %>
            <tr>
              <td><span class="badge-hub <%= r.outcome === 'passed' ? 'ok' : r.outcome === 'failed' ? 'danger' : 'muted' %>"><%= r.outcome %></span></td>
              <td>
                <%= r.name %>
                <div class="small text-muted-2"><%= r.category %> · <%= r.method %> <code><%= r.endpoint %></code><%= r.auth_role ? ' · as ' + r.auth_role : '' %></div>
                <% if (r.outcome === 'failed' && r.error_message) { %><div class="small text-danger"><%= r.error_message %></div><% } %>
                <% if (r.response_excerpt) { %>
                  <details class="small mt-1"><summary>What the page said</summary><p class="mb-0 text-muted-2 text-break"><%= r.response_excerpt %></p></details>
                <% } %>
              </td>
              <td class="text-nowrap"><%= r.expected_status.split(',').join(' or ') %></td>
              <td class="text-nowrap <%= r.outcome === 'failed' ? 'text-danger' : '' %>"><%= r.status_code || '—' %></td>
              <td class="text-nowrap small text-muted-2"><%= r.duration_ms %> ms</td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>
</section>

<%- include('../partials/layout-end') %>
