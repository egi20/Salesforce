<%- include('../partials/layout-start') %>

<%- include('../partials/page-header', { icon: 'bi-cash-coin', heading: 'Payments', sub: 'What was charged, and what needs a human.' }) %>

<section class="glass-section pb-5">
<div class="container">
  <%- include('./_tabs', { current: 'payments' }) %>
  <%- include('../partials/flash') %>

  <div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
      <div class="stat-tile">
        <div class="value"><%= formatMinor(totals.paid_minor) %></div>
        <div class="label"><%= totals.paid_count %> settled</div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="stat-tile">
        <div class="value"><%= totals.pending_count %></div>
        <div class="label">pending</div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="stat-tile">
        <div class="value"><%= totals.invoices %></div>
        <div class="label">invoices raised</div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="stat-tile">
        <div class="value"><%= totals.refund_count %></div>
        <div class="label">awaiting refund</div>
      </div>
    </div>
  </div>

  <% if (refunds.length) { %>
    <div class="glass-card mb-4">
      <div class="card-header">
        <h2 class="h6 mb-0"><i class="bi bi-exclamation-triangle"></i> Refunds to issue</h2>
      </div>
      <div class="card-body">
        <p class="small text-muted-2">
          Money that arrived and could not be fulfilled — almost always two checkout tabs against
          one quote, where only one of them could settle it. Refund these in the Stripe dashboard
          against the payment reference below. Nothing here reverses a charge automatically.
        </p>
        <ul class="list-unstyled mb-0">
          <% refunds.forEach(function (p) { %>
            <li class="d-flex flex-wrap justify-content-between gap-2 border-top py-2">
              <span>
                <code><%= p.reference %></code>
                <span class="text-muted-2 small">· <%= p.email %> · <%= p.description %></span>
              </span>
              <strong><%= formatMinor(p.amount_minor, p.currency) %></strong>
              <% if (currentUser.isSuperadmin) { %>
                <%# Records a refund already made in Stripe. It moves no money and reverses no commission. %>
                <form method="post" action="/admin/payments/<%= p.id %>/refunded" class="d-flex gap-2 w-100">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="redirectTo" value="/admin/payments">
                  <input class="form-control form-control-sm" name="note" maxlength="200" placeholder="Stripe refund reference (optional)" aria-label="Refund note">
                  <button class="btn btn-sm btn-outline-primary text-nowrap" type="submit">I refunded it in Stripe</button>
                </form>
              <% } %>
            </li>
          <% }); %>
        </ul>
      </div>
    </div>
  <% } %>

  <div class="glass-card">
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead>
          <tr>
            <th scope="col">Date</th>
            <th scope="col">Buyer</th>
            <th scope="col">Product</th>
            <th scope="col" class="text-end">Amount</th>
            <th scope="col">Status</th>
            <th scope="col">Invoice</th>
          </tr>
        </thead>
        <tbody>
          <% payments.forEach(function (p) { %>
            <tr>
              <td class="small text-muted-2"><%= new Date(p.created_at).toLocaleDateString('en-GB') %></td>
              <td class="small"><%= p.email %></td>
              <td class="small"><%= p.product %> <span class="text-muted-2">#<%= p.subject_id %></span></td>
              <td class="text-end fw-semibold"><%= formatMinor(p.amount_minor, p.currency) %></td>
              <td>
                <%
                  const tone = p.status === 'paid' ? 'ok'
                    : p.status === 'pending' ? 'warn'
                    : p.status === 'refunded' ? 'cloud' : 'muted';
                %>
                <span class="badge-hub <%= tone %>"><%= p.status %></span>
                <% if (p.needs_refund) { %><span class="badge-hub danger">refund</span><% } %>
              </td>
              <td class="small"><%= p.invoice_number || '—' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

  <%- include('../partials/pagination') %>
</div>
</section>

<%- include('../partials/layout-end') %>
