<%- include('../partials/layout-start') %>

<%
  /*
   * Document Generator — the SOW pack, for a company buying work.
   *
   * Every claim here is a property of the code: the SOW lines come from SOW_INCLUDED, each tied
   * to a heading the generator writes (a test checks it); the cloud cards come from
   * config/cloudFamilies.js; the sample timeline is computed by the estimator at boot. Nothing
   * on this page can promise more than a download delivers. The consultant's CV has its own
   * page: /cv-generator.
   */
%>
<section class="hub-hero">
  <div class="container">
    <div class="row align-items-center g-4">
      <div class="col-lg-7">
        <span class="hub-hero-badge mb-3"><i class="bi bi-file-earmark-text"></i> SOW QUOTE GENERATOR</span>
        <h1>Get your SOW quote in minutes</h1>
        <p class="lead"><%= model.intro %></p>
        <ul class="cv-hero-tags list-unstyled">
          <li><i class="bi bi-check-circle-fill"></i> Estimates that reconcile</li>
          <li><i class="bi bi-check-circle-fill"></i> Built for Salesforce</li>
          <li><i class="bi bi-check-circle-fill"></i> SOW, Gantt &amp; deck</li>
        </ul>
        <div class="d-flex flex-wrap gap-3 mt-4">
          <a class="btn btn-lg btn-light" href="/quotes/new#wizard"><i class="bi bi-plus-lg"></i> Start new quote</a>
          <%# /quotes needs an account; a visitor following it lands on sign-in and comes back. %>
          <a class="btn btn-lg btn-outline-light" href="<%= currentUser ? '/quotes' : '/auth/login?redirect=%2Fquotes' %>"><i class="bi bi-clock-history"></i> Your quotes</a>
        </div>
      </div>
      <div class="col-lg-5 d-flex justify-content-center">
        <div class="sow-pack-card">
          <span class="sow-pack-icon" aria-hidden="true"><i class="bi bi-file-earmark-text"></i></span>
          <p class="sow-pack-title mb-1">SOW pack</p>
          <p class="sow-pack-files mb-0">.docx · .xlsx · .pptx</p>
          <p class="sow-pack-note mb-0">Statement of work, work breakdown with Gantt and a summary deck — from one estimate.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="glass-section pb-5">
<div class="container">

  <%- include('../partials/sow/how') %>
  <%- include('../partials/sow/clouds') %>
  <%- include('../partials/sow/included', { withPack: true, readyHref: '/quotes/new#wizard', readyLabel: 'Start new quote' }) %>

  <div class="glass-card mb-4"><div class="card-body">
    <div class="d-flex flex-wrap justify-content-between gap-2 mb-1">
      <h2 class="h6 mb-0">What the Gantt looks like</h2>
      <span class="small text-muted-2"><%= sample.weeks %> weeks</span>
    </div>
    <p class="small text-muted-2"><%= sample.scope %> — computed by the same estimator every quote uses.</p>
    <div class="sow-gantt" role="img" aria-label="Sample Gantt chart: <%= sample.timeline.map(function (t) { return t.phase + ', weeks ' + t.startWeek + ' to ' + t.endWeek; }).join('; ') %>">
      <% sample.timeline.forEach(function (t) {
           const left = ((t.startWeek - 1) / sample.weeks) * 100;
           const width = ((t.endWeek - t.startWeek + 1) / sample.weeks) * 100; %>
        <div class="sow-gantt-row">
          <span class="sow-gantt-label"><%= t.phase %></span>
          <span class="sow-gantt-track"><span class="sow-gantt-bar" style="left:<%= left.toFixed(2) %>%;width:<%= width.toFixed(2) %>%" title="<%= t.milestone %>"></span></span>
        </div>
      <% }); %>
      <div class="sow-gantt-row sow-gantt-axis">
        <span class="sow-gantt-label"></span>
        <span class="sow-gantt-track"><span>Week 1</span><span>Week <%= sample.weeks %></span></span>
      </div>
    </div>
  </div></div>

  <% if (model.aside) { %>
    <div class="glass-card"><div class="card-body d-flex flex-wrap align-items-center gap-3">
      <i class="bi bi-file-earmark-person fs-4 text-primary"></i>
      <span class="flex-grow-1"><%= model.aside.text %></span>
      <a class="btn btn-outline-primary btn-sm" href="<%= model.aside.href %>"><%= model.aside.label %></a>
    </div></div>
  <% } %>
</div>
</section>

<%- include('../partials/layout-end') %>
