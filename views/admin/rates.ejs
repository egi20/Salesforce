<%- include('../partials/layout-start') %>

<%- include('../partials/page-header', { icon: 'bi-graph-up', heading: 'Rate submissions', sub: 'The one screen that sets aside the index\'s own aggregation.' }) %>

<section class="glass-section pb-5">
<div class="container">
  <%- include('../partials/flash') %>

  <div class="glass-card mb-4">
    <div class="card-body">
      <h2 class="h6">Read this before voiding anything</h2>
      <p class="small text-muted-2 mb-2">
        Everywhere else, a contributed rate is only ever seen inside an aggregate over at
        least three people. This page shows individual figures next to the people who gave
        them, which is why it is superadmin-only — and why it is worth being sure before
        acting.
      </p>
      <p class="small text-muted-2 mb-0">
        <strong>A high rate is usually a real senior contractor, not a mistake.</strong>
        Void a figure when it is clearly in the wrong unit — an annual salary in a day-rate
        field — not because it is above the average. Voiding excludes it from every
        aggregate and takes back its points; the row stays, so the contribution is still
        auditable and the person cannot simply re-submit for that period. There is
        deliberately no way to correct a value: an aggregate whose inputs can be retyped is
        an aggregate nobody should trust.
      </p>
    </div>
  </div>

  <ul class="nav nav-pills mb-3">
    <li class="nav-item"><a class="nav-link <%= includeVoided ? '' : 'active' %>" href="/admin/rates">Counting</a></li>
    <li class="nav-item"><a class="nav-link <%= includeVoided ? 'active' : '' %>" href="/admin/rates?voided=1">All, including voided</a></li>
  </ul>

  <div class="glass-card">
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead>
          <tr>
            <th scope="col">When</th>
            <th scope="col">Contributor</th>
            <th scope="col">Bucket</th>
            <th scope="col" class="text-end">Amount</th>
            <th scope="col" class="text-end">Bucket mean</th>
            <th scope="col"></th>
          </tr>
        </thead>
        <tbody>
          <% submissions.forEach(function (s) { %>
            <%
              /*
               * A hint, not a verdict. Flagged at four times the bucket's own mean, which
               * is roughly where a day rate typed as a monthly figure lands and well above
               * where genuine seniority does.
               */
              const mean = Number(s.bucket_mean_eur) || 0;
              const suspicious = mean > 0 && Number(s.amount_eur) > mean * 4;
            %>
            <tr class="<%= s.voided_at ? 'text-muted-2' : '' %>">
              <td class="small"><%= new Date(s.created_at).toLocaleDateString('en-GB') %></td>
              <td class="small">
                <%= s.contributor_name || s.email %>
                <% if (s.voided_at) { %><span class="badge-hub muted">voided</span><% } %>
              </td>
              <td class="small">
                <%= roleLabel(s.role) %> · <%= seniorityLabel(s.seniority) %> · <%= s.country %>
                <span class="text-muted-2"><%= s.period %></span>
              </td>
              <td class="text-end fw-semibold">
                <%= Math.round(Number(s.amount_eur)).toLocaleString('en-GB') %> EUR
                <% if (suspicious && !s.voided_at) { %>
                  <span class="badge-hub warn" title="Far above this bucket's mean — worth a look, not proof of anything.">check</span>
                <% } %>
              </td>
              <td class="text-end text-muted-2"><%= mean ? mean.toLocaleString('en-GB') : '—' %></td>
              <td class="text-end">
                <form method="post" action="/admin/moderation/rates/<%= s.id %>" class="d-flex gap-2 justify-content-end">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="hidden" value="<%= s.voided_at ? 'false' : 'true' %>">
                  <input type="hidden" name="redirectTo" value="<%= includeVoided ? '/admin/rates?voided=1' : '/admin/rates' %>">
                  <% if (!s.voided_at) { %>
                    <label class="visually-hidden" for="void-reason-<%= s.id %>">Reason</label>
                    <input class="form-control form-control-sm" id="void-reason-<%= s.id %>" name="reason"
                           type="text" placeholder="Reason" maxlength="200" style="width: 11rem;">
                  <% } %>
                  <button class="btn btn-sm btn-outline-primary" type="submit">
                    <%= s.voided_at ? 'Reinstate' : 'Void' %>
                  </button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

  <%- include('../partials/pagination') %>
</div>
</section>

<%- include('../partials/layout-end') %>
