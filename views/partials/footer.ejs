<footer class="footer-hub">
  <div class="container">
    <%
      /*
       * THE FOOTER MIRRORS THE HEADER, COLUMN FOR COLUMN.
       *
       * It used to group by intent — "Find work", "Hire", "About" — which is a perfectly
       * reasonable taxonomy and a different one from the menu directly above it. Two
       * taxonomies for one site means a page sits under one name at the top and another at
       * the bottom, and somebody who could not find a page in the menu cannot find it here
       * either, because they are looking for the name they already failed to find.
       *
       * So the hub columns carry the SAME names as the dropdowns in `navigation.ejs`. If a
       * name changes there, change it here in the same commit.
       */
      const footerColumns = [
        ['Consultant Hub', [
          ['/jobs', 'Find Jobs'],
          // A visitor builds a profile by signing up; a consultant edits the one they have.
          [currentUser && currentUser.isConsultant ? '/profile/consultant' : '/auth/register', 'Build Profile'],
          ['/services/document-generator', 'CV Generator']
        ]],
        ['Companies Hub', [
          ['/consultants', 'Browse Talent'],
          ['/quotes/new', 'Get SOW Quote'],
          ['/services/staff-augmentation', 'Staff Augmentation'],
          ['/services/project-based', 'Project-Based'],
          ['/services/managed-services', 'Managed Services'],
          // Out of the menu to keep it short, so they live here — not nowhere.
          ['/companies', 'Companies'],
          ['/recruiters', 'Recruitment agencies']
        ]],
        ['Services', [
          ['/tax-advisory', 'Tax Advisory'],
          ['/rates', 'Rate & Salary Index'],
          ['/quotes/new', 'SOW Generator'],
          ['/services/document-generator', 'Document Generator'],
          ['/payments', 'Pricing']
        ]],
        ['Community', [
          ['/community', 'Forum'],
          ['/community?kind=article', 'Articles'],
          ['/success-stories', 'Success Stories'],
          // Signed in only, for the same reason the menu hides them: each answers 401 to a
          // visitor, and a footer link whose only outcome is a login page is a dead link
          // wearing a name.
          ...(currentUser ? [
            ['/community/new?kind=question', 'Ask a Question'],
            ['/community/new?kind=article', 'Share an Article'],
            ['/challenges', 'Daily challenge']
          ] : [])
        ]],
        ['Company', [
          ['/about', 'About Us'],
          ['/faq', 'FAQ'],
          ['/contact', 'Contact'],
          ['/report-issue', 'Report Issue']
        ]],
        ['Legal', [
          ['/legal/privacy', 'Privacy policy'],
          ['/legal/terms', 'Terms of service']
        ]]
      ];
    %>
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="footer-logo" href="/">
          <span class="brand-tile" aria-hidden="true">
            <img src="/images/logo-mark.svg" alt="" width="30" height="30">
          </span>
          <span>Salesforce <span class="brand-accent">Hub</span></span>
        </a>
        <p class="mb-0 footer-blurb">
          The marketplace for the Salesforce ecosystem: contract and permanent roles,
          consultants companies can browse, scope estimates that reconcile, and day-rate
          benchmarks built from figures people contributed.
        </p>
      </div>
      <% footerColumns.forEach(function (col) { %>
        <div>
          <h3><%= col[0] %></h3>
          <ul class="list-unstyled mb-0">
            <% col[1].forEach(function (link) { %>
              <li><a href="<%= link[0] %>"><%= link[1] %></a></li>
            <% }); %>
          </ul>
        </div>
      <% }); %>
    </div>
    <hr class="footer-rule">
    <div class="d-flex flex-wrap justify-content-between small gap-2">
      <span>&copy; <%= new Date().getFullYear() %> <%= appName %>. All rights reserved.</span>
      <span>Built for the Salesforce community</span>
    </div>
    <%# Its own line, never shortened to fit the row above: it is what makes an independent %>
    <%# marketplace using the word "Salesforce" defensible. %>
    <p class="small mb-0 mt-2 footer-disclaimer">Not affiliated with Salesforce, Inc. Product names are trademarks of their respective owners.</p>
  </div>
</footer>

<script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
