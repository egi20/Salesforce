<%- include('../partials/layout-start') %>
<%- include('../partials/page-header', {
  icon: 'bi-person-check',
  heading: 'Placement fees',
  sub: 'What was agreed, and what is owed.'
}) %>
<section class="glass-section pb-5"><div class="container">
  <div class="row justify-content-center"><div class="col-lg-9">
    <%- include('../partials/flash') %>

    <% if (!placements.length) { %>
      <div class="glass-card"><div class="card-body">
        <p class="text-muted-2 mb-0">
          Nothing here. A placement fee appears once one has been agreed with you — it is
          never raised automatically.
        </p>
      </div></div>
    <% } else { %>
      <% const tone = { agreed: 'cloud', paid: 'ok', cancelled: 'muted' }; %>
      <% placements.forEach(function (p) { %>
        <div class="glass-card mb-3"><div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-start mb-2">
            <h2 class="h6 mb-0"><%= p.consultant_name %> — <%= p.job_title %></h2>
            <span class="badge-hub <%= tone[p.status] || '' %>"><%= p.status %></span>
          </div>

          <p class="small text-muted-2 mb-3"><%= p.reference %> · <%= kindLabel(p.placement_kind) %></p>

          <div class="row g-3 mb-3">
            <div class="col-6 col-md-4">
              <div class="stat-tile">
                <div class="value"><%= formatMinor(p.contract_value_minor, p.currency) %></div>
                <div class="label">Contract value</div>
              </div>
            </div>
            <div class="col-6 col-md-4">
              <div class="stat-tile">
                <div class="value"><%= (p.rate_bps / 100).toFixed(2) %>%</div>
                <div class="label">Agreed rate</div>
              </div>
            </div>
            <div class="col-6 col-md-4">
              <div class="stat-tile">
                <%# The STORED figure, never recomputed here: the page, the charge and the %>
                <%# invoice must all read the same number. %>
                <div class="value"><%= formatMinor(p.fee_minor, p.currency) %></div>
                <div class="label">Fee due</div>
              </div>
            </div>
          </div>

          <% if (p.note) { %><p class="small text-muted-2"><%= p.note %></p><% } %>

          <% if (p.status === 'agreed') { %>
            <% if (stripeReady) { %>
              <form method="post" action="/payments/checkout/placement_fee">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="subject_id" value="<%= p.id %>">
                <input type="hidden" name="redirectTo" value="/payments/placements">
                <%# No amount in this form. The resolver re-checks who owns this placement and %>
                <%# answers with the price — see config/payments.js. %>
                <button class="btn btn-primary" type="submit">
                  Pay <%= formatMinor(p.fee_minor, p.currency) %>
                </button>
              </form>
            <% } else { %>
              <p class="small text-muted-2 mb-0">Card payments are not switched on yet. You will be invoiced instead.</p>
            <% } %>
          <% } else if (p.status === 'cancelled') { %>
            <p class="small text-muted-2 mb-0">Cancelled<% if (p.cancel_reason) { %> — <%= p.cancel_reason %><% } %>.</p>
          <% } %>
        </div></div>
      <% }); %>
    <% } %>
  </div></div>
</div></section>
<%- include('../partials/layout-end') %>
