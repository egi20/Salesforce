<%- include('../partials/layout-start') %>

<%- include('../partials/page-header', { icon: 'bi-person-badge', heading: 'Build your consultant profile', sub: 'What companies see when they search Browse Talent. Fill in the sections in any order, and save as you go.' }) %>

<%
  /*
   * ONE PAGE, SIX SECTIONS.
   *
   * Without scripting the sections are one long page with a contents bar at the top; with
   * scripting the bar becomes tabs (public/js/main.js). Either way there is ONE profile form —
   * Basics, Salesforce, Work & rate and Privacy are all saved by the same Save button — and
   * the things that are lists of their own (certifications, projects, experience) are separate
   * forms that save the moment a row is added.
   *
   * Those separate forms cannot be NESTED inside the profile form, which the browser forbids,
   * so they are empty <form> elements after it and their fields join them through the
   * `form="..."` attribute. The same trick gives every remove (×) button a form to submit.
   */
  const nameParts = String(currentUser.name || '').trim().split(/\s+/);
  const firstName = nameParts.shift() || '';
  const lastName = nameParts.join(' ');
  const iso = (d) => (d ? new Date(d).toISOString().slice(0, 10) : '');
  const month = (d) => (d ? new Date(d).toISOString().slice(0, 7) : '');
  const tabs = [
    ['basics', 'Basics', 'bi-person'],
    ['salesforce', 'Salesforce', 'bi-cloud'],
    ['work', 'Work & rate', 'bi-briefcase'],
    ['privacy', 'Privacy', 'bi-shield-lock'],
    ['projects', 'Projects & experience', 'bi-kanban'],
    ['documents', 'Documents', 'bi-file-earmark-text']
  ];
  const levelLabel = { familiar: 'Beginner', proficient: 'Proficient', expert: 'Expert' };
  const languageLabel = { basic: 'Basic', conversational: 'Conversational', professional: 'Professional', native: 'Native' };
  const step = nextSteps[0];
  const skillRows = skills.concat([{}, {}]);
  const languageRows = languages.concat([{}]);
%>

<section class="glass-section pb-5">
<div class="container">
  <%- include('../partials/flash') %>

  <div class="glass-card mb-3">
    <div class="card-body">
      <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-2">
        <div>
          <h2 class="h6 mb-1">Profile <%= profile.completeness %>% complete</h2>
          <p class="small text-muted-2 mb-0">
            <% if (step) { %>
              Next: <strong><%= step.label %></strong> to reach <%= Math.min(100, profile.completeness + step.gain) %>%.
            <% } else { %>
              Everything that counts towards completeness is filled in.
            <% } %>
            <% if (profile.is_public) { %>
              <span class="badge-hub ok ms-1"><i class="bi bi-check2"></i> Listed in Browse Talent</span>
            <% } else if (listingProblems.length) { %>
              <br>To be listed in Browse Talent: <%= listingProblems.join(', ') %>.
            <% } else { %>
              <br>Ready to be listed — switch it on under <a href="#privacy" data-tab-link="privacy">Privacy</a>.
            <% } %>
          </p>
        </div>
        <div class="text-lg-end">
          <button class="btn btn-primary btn-sm" type="button" id="importCvBtn">
            <i class="bi bi-magic"></i> Import from CV
          </button>
          <p class="small text-muted-2 mb-0 mt-1">.docx or .txt — fills the fields for you to check</p>
        </div>
      </div>
      <input class="d-none" id="cvImportFile" type="file" accept=".docx,.txt">
      <p class="small mb-2 d-none" id="cvImportStatus"></p>
      <div class="meter <%= profile.completeness >= minCompleteness ? 'ready' : '' %>">
        <i style="width:<%= profile.completeness %>%"></i>
      </div>
    </div>
  </div>

  <nav class="profile-tabs mb-3" aria-label="Profile sections">
    <% tabs.forEach(function (t) { const done = sectionsDone[t[0]]; %>
      <a class="profile-tab" href="#<%= t[0] %>" data-tab-link="<%= t[0] %>">
        <i class="bi <%= t[2] %>" aria-hidden="true"></i> <%= t[1] %>
        <% if (done) { %><i class="bi bi-check-circle-fill tab-done" aria-label="complete"></i><% } %>
      </a>
    <% }); %>
  </nav>

  <form method="post" action="/profile/consultant" id="consultantProfileForm" data-profile-tabs>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="tab" value="basics" data-current-tab>

    <%# ------------------------------------------------------------------- BASICS %>
    <section class="glass-card profile-section mb-3" id="basics" data-tab="basics">
      <div class="card-body">
        <h2 class="h5 mb-3">Basics</h2>

        <div class="d-flex flex-wrap align-items-center gap-3 mb-4">
          <img class="avatar" style="width:96px;height:96px" src="<%= profile.profile_picture || '/images/avatar-placeholder.svg' %>" alt="">
          <div>
            <div class="d-flex gap-2 mb-1">
              <button class="btn btn-outline-primary btn-sm" type="button" id="changePhotoBtn"><i class="bi bi-upload"></i> Change photo</button>
              <% if (profile.profile_picture) { %>
                <button class="btn btn-outline-danger btn-sm" type="button" id="removePhotoBtn"><i class="bi bi-trash"></i> Remove</button>
              <% } %>
            </div>
            <p class="small text-muted-2 mb-0">JPG, PNG or WebP, up to 5 MB. Square works best.</p>
          </div>
          <input class="d-none" id="photoFile" type="file" accept="image/jpeg,image/png,image/webp,image/gif">
        </div>

        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label" for="given_name">First name *</label>
            <input class="form-control" id="given_name" name="given_name" maxlength="100" required value="<%= firstName %>">
          </div>
          <div class="col-md-6">
            <label class="form-label" for="family_name">Last name *</label>
            <input class="form-control" id="family_name" name="family_name" maxlength="100" required value="<%= lastName %>">
          </div>
          <div class="col-md-6">
            <label class="form-label" for="headline">Professional title</label>
            <input class="form-control" id="headline" name="headline" maxlength="200" value="<%= profile.headline || '' %>" placeholder="Senior CPQ consultant">
          </div>
          <div class="col-md-6">
            <label class="form-label" for="phone">Phone</label>
            <input class="form-control" id="phone" name="phone" type="tel" maxlength="40" value="<%= profile.phone || '' %>">
            <p class="form-text mb-0">Shown only to signed-in hiring accounts, like your email.</p>
          </div>
          <div class="col-md-6">
            <label class="form-label" for="primary_role">Primary role</label>
            <select class="form-select" id="primary_role" name="primary_role">
              <option value="">Choose</option>
              <% roleCategories.forEach(function (cat) { %>
                <optgroup label="<%= cat.category %>">
                  <% cat.roles.forEach(function (r) { %>
                    <option value="<%= r.value %>" <%= profile.primary_role === r.value ? 'selected' : '' %>><%= r.label %></option>
                  <% }); %>
                </optgroup>
              <% }); %>
            </select>
            <p class="form-text mb-0">The same roles companies filter jobs and talent by — it drives your match scores.</p>
          </div>
          <div class="col-md-3">
            <label class="form-label" for="seniority">Seniority</label>
            <select class="form-select" id="seniority" name="seniority">
              <option value="">Choose</option>
              <% ['junior', 'mid', 'senior', 'lead'].forEach(function (s) { %>
                <option value="<%= s %>" <%= profile.seniority === s ? 'selected' : '' %>><%= seniorityLabel(s, { full: true }) %></option>
              <% }); %>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label" for="years_experience">Years of experience</label>
            <input class="form-control" id="years_experience" name="years_experience" type="number" min="0" max="60" value="<%= profile.years_experience || '' %>">
          </div>
          <div class="col-md-6">
            <label class="form-label" for="country">Country</label>
            <select class="form-select" id="country" name="country">
              <option value="">Choose</option>
              <% countries.forEach(function (c) { %>
                <option value="<%= c.code %>" <%= profile.country === c.code ? 'selected' : '' %>><%= c.name %></option>
              <% }); %>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label" for="city">City</label>
            <input class="form-control" id="city" name="city" maxlength="120" value="<%= profile.city || '' %>">
          </div>
          <div class="col-12">
            <label class="form-label" for="bio">Professional bio</label>
            <textarea class="form-control" id="bio" name="bio" rows="7" placeholder="What you deliver, on which clouds, for what kind of client."><%= profile.bio || '' %></textarea>
          </div>
        </div>

        <h3 class="h6 mt-4 mb-2">Languages</h3>
        <datalist id="languageList">
          <% ['English', 'German', 'French', 'Spanish', 'Italian', 'Portuguese', 'Dutch', 'Polish', 'Romanian', 'Albanian', 'Greek', 'Swedish', 'Danish', 'Norwegian', 'Finnish', 'Czech', 'Hungarian', 'Turkish', 'Arabic', 'Hindi', 'Japanese', 'Chinese'].forEach(function (l) { %><option value="<%= l %>"><% }); %>
        </datalist>
        <div data-rows="language">
          <% languageRows.forEach(function (l) { %>
            <div class="row g-2 mb-2 align-items-center" data-row>
              <div class="col-7"><input class="form-control form-control-sm" name="language_name" list="languageList" maxlength="60" value="<%= l.language || '' %>" placeholder="Language" aria-label="Language"></div>
              <div class="col-4">
                <select class="form-select form-select-sm" name="language_level" aria-label="Level">
                  <% languageLevels.forEach(function (lv) { %><option value="<%= lv %>" <%= (l.level || 'professional') === lv ? 'selected' : '' %>><%= languageLabel[lv] %></option><% }); %>
                </select>
              </div>
              <div class="col-1 text-end"><button class="btn btn-sm btn-link text-danger p-0" type="button" data-remove-row aria-label="Remove language">&times;</button></div>
            </div>
          <% }); %>
        </div>
        <button class="btn btn-outline-primary btn-sm" type="button" data-add-row="language"><i class="bi bi-plus"></i> Add language</button>

        <h3 class="h6 mt-4 mb-2">Links</h3>
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label" for="linkedin_url">LinkedIn URL
              <%# "Verified" only when LinkedIn sign-in actually confirmed it — never for a typed link. %>
              <% if (profile.linkedin_verified) { %><span class="badge-hub ok ms-1"><i class="bi bi-patch-check"></i> Confirmed</span><% } %>
            </label>
            <input class="form-control" id="linkedin_url" name="linkedin_url" type="url" maxlength="255" value="<%= profile.linkedin_url || '' %>" placeholder="https://www.linkedin.com/in/…">
          </div>
          <div class="col-md-6">
            <label class="form-label" for="website_url">Website</label>
            <input class="form-control" id="website_url" name="website_url" type="url" maxlength="255" value="<%= profile.website_url || '' %>">
          </div>
        </div>
      </div>
    </section>

    <%# --------------------------------------------------------------- SALESFORCE %>
    <section class="glass-card profile-section mb-3" id="salesforce" data-tab="salesforce">
      <div class="card-body">
        <h2 class="h5 mb-1">Salesforce</h2>
        <p class="small text-muted-2 mb-3">Clouds and skills are what companies search Browse Talent by.</p>

        <h3 class="h6 mb-2">Clouds you work on</h3>
        <div class="row g-1 mb-1">
          <% cloudFamilies.forEach(function (f) { %>
            <div class="col-sm-6 col-lg-4">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="clouds" value="<%= f.value %>" id="cloud-<%= f.value %>" <%= clouds.includes(f.value) ? 'checked' : '' %>>
                <label class="form-check-label" for="cloud-<%= f.value %>"><%= f.label %></label>
              </div>
            </div>
          <% }); %>
        </div>
        <p class="form-text mb-4">At least one is needed to be listed.</p>

        <h3 class="h6 mb-2">Skills</h3>
        <div class="row g-2 small text-muted-2 d-none d-md-flex"><div class="col-md-6">Skill</div><div class="col-md-3">Level</div><div class="col-md-2">Years</div></div>
        <div data-rows="skill">
          <% skillRows.forEach(function (sk) { %>
            <div class="row g-2 mb-2 align-items-center" data-row>
              <div class="col-md-6"><input class="form-control form-control-sm" name="skill_name" maxlength="80" value="<%= sk.name || '' %>" placeholder="e.g. Apex, CPQ, Flow" aria-label="Skill"></div>
              <div class="col-6 col-md-3">
                <select class="form-select form-select-sm" name="skill_level" aria-label="Level">
                  <% skillLevels.forEach(function (lv) { %><option value="<%= lv %>" <%= (sk.level || 'proficient') === lv ? 'selected' : '' %>><%= levelLabel[lv] %></option><% }); %>
                </select>
              </div>
              <div class="col-4 col-md-2"><input class="form-control form-control-sm" name="skill_years" type="number" min="0" max="50" value="<%= sk.years !== null && sk.years !== undefined ? sk.years : '' %>" placeholder="Years" aria-label="Years"></div>
              <div class="col-2 col-md-1 text-end"><button class="btn btn-sm btn-link text-danger p-0" type="button" data-remove-row aria-label="Remove skill">&times;</button></div>
            </div>
          <% }); %>
        </div>
        <button class="btn btn-outline-primary btn-sm mb-4" type="button" data-add-row="skill"><i class="bi bi-plus"></i> Add skill</button>

        <h3 class="h6 mb-2">Certifications</h3>
        <% if (certifications.length) { %>
          <ul class="list-unstyled small mb-3">
            <% certifications.forEach(function (c) { %>
              <li class="d-flex justify-content-between align-items-center border-top py-2">
                <span>
                  <i class="bi bi-patch-check text-success"></i> <%= c.name %>
                  <% if (c.earned_on) { %><span class="text-muted-2">· <%= month(c.earned_on) %></span><% } %>
                  <% if (c.credential_url) { %>· <a href="<%= c.credential_url %>" target="_blank" rel="noopener noreferrer">credential</a><% } %>
                </span>
                <button class="btn btn-sm btn-link text-danger p-0" type="submit" form="removeForm"
                        formaction="/profile/consultant/certifications/<%= c.id %>/delete" aria-label="Remove <%= c.name %>">&times;</button>
              </li>
            <% }); %>
          </ul>
        <% } %>
        <div class="row g-2 align-items-end mb-4">
          <div class="col-md-5">
            <label class="form-label small" for="cert-name">Certification</label>
            <select class="form-select form-select-sm" id="cert-name" name="name" form="certAddForm" required>
              <option value="">Choose from the official list</option>
              <% certificationGroups.forEach(function (g) { %>
                <optgroup label="<%= g.group %>">
                  <% g.items.forEach(function (i) { %><option value="<%= i %>"><%= i %></option><% }); %>
                </optgroup>
              <% }); %>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label small" for="cert-date">Earned</label>
            <input class="form-control form-control-sm" id="cert-date" name="earned_on" type="date" form="certAddForm">
          </div>
          <div class="col-md-4">
            <label class="form-label small" for="cert-url">Trailhead credential link</label>
            <input class="form-control form-control-sm" id="cert-url" name="credential_url" type="url" maxlength="255" form="certAddForm" placeholder="https://trailhead.salesforce.com/…">
          </div>
          <div class="col-12"><button class="btn btn-outline-primary btn-sm" type="submit" form="certAddForm"><i class="bi bi-plus"></i> Add certification</button></div>
        </div>

        <h3 class="h6 mb-2">Trailhead</h3>
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label" for="trailblazer_url">Trailblazer profile link</label>
            <input class="form-control" id="trailblazer_url" name="trailblazer_url" type="url" maxlength="255" value="<%= profile.trailblazer_url || '' %>" placeholder="https://www.salesforce.com/trailblazer/…">
          </div>
          <div class="col-md-3">
            <label class="form-label" for="trailhead_rank">Rank</label>
            <select class="form-select" id="trailhead_rank" name="trailhead_rank">
              <option value="">—</option>
              <% trailheadRanks.forEach(function (r) { %><option value="<%= r %>" <%= profile.trailhead_rank === r ? 'selected' : '' %>><%= r %></option><% }); %>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label" for="trailhead_badges">Badges</label>
            <input class="form-control" id="trailhead_badges" name="trailhead_badges" type="number" min="0" max="10000" value="<%= profile.trailhead_badges !== null && profile.trailhead_badges !== undefined ? profile.trailhead_badges : '' %>">
          </div>
        </div>
        <p class="form-text mb-0">As stated by you. The profile links to Trailhead so a company can check it there.</p>
      </div>
    </section>

    <%# -------------------------------------------------------------- WORK & RATE %>
    <section class="glass-card profile-section mb-3" id="work" data-tab="work">
      <div class="card-body">
        <h2 class="h5 mb-3">Work &amp; rate</h2>

        <div class="row g-3">
          <div class="col-md-6">
            <span class="form-label d-block">Open to</span>
            <div class="form-check form-check-inline">
              <input class="form-check-input" type="checkbox" id="open_to_contract" name="open_to_contract" <%= profile.open_to_contract ? 'checked' : '' %>>
              <label class="form-check-label" for="open_to_contract">Contract</label>
            </div>
            <div class="form-check form-check-inline">
              <input class="form-check-input" type="checkbox" id="open_to_permanent" name="open_to_permanent" <%= profile.open_to_permanent ? 'checked' : '' %>>
              <label class="form-check-label" for="open_to_permanent">Permanent</label>
            </div>
          </div>
          <div class="col-md-3">
            <label class="form-label" for="availability">Availability</label>
            <select class="form-select" id="availability" name="availability">
              <option value="immediate" <%= profile.availability === 'immediate' ? 'selected' : '' %>>Available now</option>
              <option value="two_weeks" <%= profile.availability === 'two_weeks' ? 'selected' : '' %>>Available in 2 weeks</option>
              <option value="one_month" <%= profile.availability === 'one_month' ? 'selected' : '' %>>Available in a month</option>
              <option value="not_available" <%= profile.availability === 'not_available' ? 'selected' : '' %>>Not available</option>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label" for="available_from">Available from</label>
            <input class="form-control" id="available_from" name="available_from" type="date" value="<%= iso(profile.available_from) %>">
          </div>
          <div class="col-md-6">
            <label class="form-label" for="work_mode">Work mode</label>
            <select class="form-select" id="work_mode" name="work_mode">
              <% ['remote', 'hybrid', 'onsite'].forEach(function (m) { %>
                <option value="<%= m %>" <%= profile.work_mode === m ? 'selected' : '' %>><%= workModeLabel(m) %></option>
              <% }); %>
            </select>
          </div>
          <div class="col-md-6 d-flex align-items-end">
            <div class="form-check mb-2">
              <input class="form-check-input" type="checkbox" id="willing_to_travel" name="willing_to_travel" <%= profile.willing_to_travel ? 'checked' : '' %>>
              <label class="form-check-label" for="willing_to_travel">Willing to travel</label>
            </div>
          </div>
          <div class="col-12">
            <span class="form-label d-block">Countries you will work in <span class="text-muted-2 small">(<%= workCountries.length %> chosen)</span></span>
            <input class="form-control form-control-sm mb-2" type="search" placeholder="Search countries…" aria-label="Search countries" data-filter-list="#workCountryList" autocomplete="off">
            <div class="filter-scroll border rounded p-2" id="workCountryList">
              <div data-filter-group>
                <% countries.forEach(function (c) { const id = 'wc-' + c.code; %>
                  <div class="form-check" data-filter-item>
                    <input class="form-check-input" type="checkbox" name="work_countries" value="<%= c.code %>" id="<%= id %>" <%= workCountries.includes(c.code) ? 'checked' : '' %>>
                    <label class="form-check-label" for="<%= id %>"><%= c.name %></label>
                  </div>
                <% }); %>
              </div>
            </div>
          </div>
        </div>

        <h3 class="h6 mt-4 mb-2">Rate</h3>
        <%
          /*
           * NOTHING HERE IS DERIVED FROM ANYTHING ELSE HERE. An hourly rate is not a day rate
           * divided by eight, and a salary is a different engagement, not a converted rate.
           * `step="1"`: `step="10"` once made a rate of 752 an invalid field and silently
           * blocked the whole form.
           */
        %>
        <div class="row g-3">
          <div class="col-md-3">
            <label class="form-label" for="day_rate">Day rate</label>
            <input class="form-control" id="day_rate" name="day_rate" type="number" min="0" step="1" value="<%= profile.day_rate ? Math.round(profile.day_rate) : '' %>">
          </div>
          <div class="col-md-3">
            <label class="form-label" for="hourly_rate">Hourly rate <span class="text-muted-2 small">(optional)</span></label>
            <input class="form-control" id="hourly_rate" name="hourly_rate" type="number" min="0" step="1" value="<%= profile.hourly_rate ? Math.round(profile.hourly_rate) : '' %>">
          </div>
          <div class="col-md-3">
            <label class="form-label" for="annual_salary">Annual salary, permanent</label>
            <input class="form-control" id="annual_salary" name="annual_salary" type="number" min="0" step="1" value="<%= profile.annual_salary ? Math.round(profile.annual_salary) : '' %>">
          </div>
          <div class="col-md-3">
            <label class="form-label" for="currency">Currency</label>
            <select class="form-select" id="currency" name="currency">
              <% ['EUR', 'USD', 'GBP', 'CHF'].forEach(function (c) { %>
                <option value="<%= c %>" <%= profile.currency === c ? 'selected' : '' %>><%= c %></option>
              <% }); %>
            </select>
          </div>
        </div>
        <p class="form-text mb-0">
          Fill in whichever apply; nothing is calculated from anything else. The day rate drives your
          match scores and your rate card. Not sure what to charge?
          <a href="/rates/calculator" target="_blank" rel="noopener">Open the rate calculator <i class="bi bi-box-arrow-up-right"></i></a>
        </p>
      </div>
    </section>

    <%# ------------------------------------------------------------------ PRIVACY %>
    <section class="glass-card profile-section mb-3" id="privacy" data-tab="privacy">
      <div class="card-body">
        <h2 class="h5 mb-3">Privacy</h2>

        <div class="privacy-row">
          <div class="form-check form-switch mb-0">
            <%# Its own form (visibilityForm), so listing changes at once and independently of Save. %>
            <input class="form-check-input" type="checkbox" role="switch" id="is_public" name="is_public" form="visibilityForm"
                   <%= profile.is_public ? 'checked' : '' %> data-submit-on-change>
            <label class="form-check-label fw-semibold" for="is_public">List my profile in Browse Talent</label>
            <button class="btn btn-outline-primary btn-sm ms-2" type="submit" form="visibilityForm" data-no-script-only>Update</button>
          </div>
          <p class="small text-muted-2 mb-0">
            <% if (profile.is_public) { %>
              Companies can find you. Switch off to hide the profile; nothing is deleted.
            <% } else if (listingProblems.length) { %>
              Not listed. First: <%= listingProblems.join(', ') %>.
            <% } else { %>
              Not listed. Ready whenever you are.
            <% } %>
          </p>
        </div>

        <div class="privacy-row">
          <div class="form-check mb-0">
            <input class="form-check-input" type="checkbox" id="rate_visible" name="rate_visible" <%= profile.rate_visible ? 'checked' : '' %>>
            <label class="form-check-label fw-semibold" for="rate_visible">Show my rates on my public profile</label>
          </div>
          <p class="small text-muted-2 mb-0">
            Untick it and every figure reads <strong>“Rate on request”</strong> to everyone but you. They
            still drive your match scores and rate card, and they stop answering the directory's rate
            filter, so nothing can be narrowed down from outside. Saved with the profile.
          </p>
        </div>

        <div class="privacy-row border-0">
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span class="fw-semibold">Hidden from specific companies
              <% if (hiddenCompanyCount) { %><span class="badge-hub ms-1"><%= hiddenCompanyCount %></span><% } %></span>
            <a class="btn btn-outline-primary btn-sm" href="/profile/hidden-companies">Manage</a>
          </div>
          <p class="small text-muted-2 mb-0">Your current employer included: a company you name cannot see your profile, even while it is listed.</p>
        </div>
      </div>
    </section>

    <%# ---------------------------------------------------- PROJECTS & EXPERIENCE %>
    <section class="glass-card profile-section mb-3" id="projects" data-tab="projects">
      <div class="card-body">
        <h2 class="h5 mb-1">Projects</h2>
        <p class="small text-muted-2 mb-3">The engagements themselves — which orgs, which clouds, what shipped. On a contractor's CV this is the substance.</p>

        <% if (projects.length) { %>
          <ul class="list-unstyled small mb-3">
            <% projects.forEach(function (p) { %>
              <li class="d-flex justify-content-between align-items-start border-top py-2">
                <span>
                  <strong><%= p.name %></strong><% if (p.client) { %><span class="text-muted-2"> · <%= p.client %></span><% } %><br>
                  <span class="text-muted-2">
                    <% if (p.cloud) { %><%= moduleLabel(p.cloud) || p.cloud %> · <% } %>
                    <% if (p.role) { %><%= roleLabel(p.role) %> · <% } %>
                    <%= month(p.started_on) %> – <%= p.is_current || !p.ended_on ? 'present' : month(p.ended_on) %>
                  </span>
                </span>
                <button class="btn btn-sm btn-link text-danger p-0" type="submit" form="removeForm"
                        formaction="/profile/consultant/projects/<%= p.id %>/delete" aria-label="Remove <%= p.name %>">&times;</button>
              </li>
            <% }); %>
          </ul>
        <% } %>

        <div class="row g-2 mb-4">
          <div class="col-md-6"><input class="form-control form-control-sm" name="name" form="projAddForm" maxlength="200" required placeholder="Project, e.g. Quote-to-cash rollout" aria-label="Project name"></div>
          <div class="col-md-6"><input class="form-control form-control-sm" name="client" form="projAddForm" maxlength="180" placeholder="Client or industry (optional)" aria-label="Client or industry"></div>
          <div class="col-md-6">
            <select class="form-select form-select-sm" name="cloud" form="projAddForm" aria-label="Cloud or module">
              <option value="">Cloud or module</option>
              <% allModules.forEach(function (m) { %><option value="<%= m.value %>"><%= m.familyLabel %> — <%= m.label %></option><% }); %>
            </select>
          </div>
          <div class="col-md-6">
            <select class="form-select form-select-sm" name="role" form="projAddForm" aria-label="Your role">
              <option value="">Your role on it</option>
              <% roleCategories.forEach(function (cat) { %>
                <optgroup label="<%= cat.category %>">
                  <% cat.roles.forEach(function (r) { %><option value="<%= r.value %>"><%= r.label %></option><% }); %>
                </optgroup>
              <% }); %>
            </select>
          </div>
          <div class="col-6 col-md-3"><input class="form-control form-control-sm" name="started_on" type="date" form="projAddForm" aria-label="Started"></div>
          <div class="col-6 col-md-3"><input class="form-control form-control-sm" name="ended_on" type="date" form="projAddForm" aria-label="Ended"></div>
          <div class="col-md-6 d-flex align-items-center">
            <div class="form-check mb-0">
              <input class="form-check-input" type="checkbox" name="is_current" id="proj-current" form="projAddForm">
              <label class="form-check-label small" for="proj-current">Current project</label>
            </div>
          </div>
          <div class="col-12"><textarea class="form-control form-control-sm" name="description" form="projAddForm" rows="3" placeholder="What you actually did. It goes on your CV as you write it." aria-label="Description"></textarea></div>
          <div class="col-12"><button class="btn btn-outline-primary btn-sm" type="submit" form="projAddForm"><i class="bi bi-plus"></i> Add project</button></div>
        </div>

        <h2 class="h5 mb-3">Work experience</h2>
        <% if (experiences.length) { %>
          <ul class="list-unstyled small mb-3">
            <% experiences.forEach(function (e) { %>
              <li class="d-flex justify-content-between align-items-start border-top py-2">
                <span>
                  <strong><%= e.title %></strong> · <%= e.company %><br>
                  <span class="text-muted-2"><% if (e.location) { %><%= e.location %> · <% } %><%= month(e.started_on) %> – <%= e.is_current ? 'present' : month(e.ended_on) %></span>
                </span>
                <button class="btn btn-sm btn-link text-danger p-0" type="submit" form="removeForm"
                        formaction="/profile/consultant/experience/<%= e.id %>/delete" aria-label="Remove <%= e.title %>">&times;</button>
              </li>
            <% }); %>
          </ul>
        <% } %>
        <div class="row g-2">
          <div class="col-md-6"><input class="form-control form-control-sm" name="title" form="expAddForm" maxlength="180" required placeholder="Role" aria-label="Role"></div>
          <div class="col-md-6"><input class="form-control form-control-sm" name="company" form="expAddForm" maxlength="180" required placeholder="Company" aria-label="Company"></div>
          <div class="col-md-6"><input class="form-control form-control-sm" name="location" form="expAddForm" maxlength="120" placeholder="Location (optional)" aria-label="Location"></div>
          <div class="col-6 col-md-3"><input class="form-control form-control-sm" name="started_on" type="date" form="expAddForm" required aria-label="Started"></div>
          <div class="col-6 col-md-3"><input class="form-control form-control-sm" name="ended_on" type="date" form="expAddForm" aria-label="Ended"></div>
          <div class="col-12">
            <div class="form-check mb-0">
              <input class="form-check-input" type="checkbox" name="is_current" id="exp-current" form="expAddForm">
              <label class="form-check-label small" for="exp-current">Current role</label>
            </div>
          </div>
          <div class="col-12"><textarea class="form-control form-control-sm" name="description" form="expAddForm" rows="3" placeholder="What the role covered (optional)" aria-label="Description"></textarea></div>
          <div class="col-12"><button class="btn btn-outline-primary btn-sm" type="submit" form="expAddForm"><i class="bi bi-plus"></i> Add experience</button></div>
        </div>
      </div>
    </section>

    <%# ---------------------------------------------------------------- DOCUMENTS %>
    <section class="glass-card profile-section mb-3" id="documents" data-tab="documents">
      <div class="card-body">
        <h2 class="h5 mb-1">Documents</h2>
        <p class="small text-muted-2 mb-3">
          A CV and a rate card generated from this profile — nothing is rephrased or invented, so what
          you wrote is what comes out. Made on demand and never stored, so the copy you send is always current.
        </p>
        <div class="d-flex flex-wrap gap-2 mb-4">
          <a class="btn btn-primary" href="/profile/consultant/download/package"><i class="bi bi-download"></i> CV + rate card (.zip)</a>
          <a class="btn btn-outline-primary" href="/profile/consultant/download/cv">CV (.docx)</a>
          <a class="btn btn-outline-primary" href="/profile/consultant/download/rate-card">Rate card (.docx)</a>
          <a class="btn btn-outline-primary" href="/services/document-generator">About the CV generator</a>
        </div>

        <h3 class="h6 mb-2">What's next</h3>
        <ol class="whats-next">
          <li><a href="#" data-click="importCvBtn">Import your CV</a> to fill the fields you have not typed yet.</li>
          <li><a href="/profile/consultant/download/cv">Generate your CV</a> from the finished profile.</li>
          <li><a href="/jobs">Browse jobs</a> — every role shows how well it matches you.</li>
        </ol>
      </div>
    </section>

    <%# Stays at the bottom of the window while the page scrolls. %>
    <div class="profile-savebar">
      <span class="small text-muted-2 me-auto" data-unsaved-note>Certifications, projects and experience save as you add them.</span>
      <a class="btn btn-outline-primary" href="/consultants/<%= profile.user_id %>" target="_blank" rel="noopener"><i class="bi bi-eye"></i> Preview public profile</a>
      <button class="btn btn-primary" type="submit"><i class="bi bi-check2"></i> Save profile</button>
    </div>
  </form>

  <form id="visibilityForm" method="post" action="/profile/consultant/visibility"><input type="hidden" name="_csrf" value="<%= csrfToken %>"></form>
  <form id="certAddForm" method="post" action="/profile/consultant/certifications"><input type="hidden" name="_csrf" value="<%= csrfToken %>"></form>
  <form id="projAddForm" method="post" action="/profile/consultant/projects"><input type="hidden" name="_csrf" value="<%= csrfToken %>"></form>
  <form id="expAddForm" method="post" action="/profile/consultant/experience"><input type="hidden" name="_csrf" value="<%= csrfToken %>"></form>
  <%# Every × names its own target with `formaction`. The default action deliberately goes %>
  <%# nowhere: an empty post to the profile route would save a profile with every field blank. %>
  <form id="removeForm" method="post" action="/profile/consultant/no-target"><input type="hidden" name="_csrf" value="<%= csrfToken %>"></form>
</div>
</section>

<%- include('../partials/layout-end') %>
