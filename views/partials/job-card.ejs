<%
  /*
   * One job card for every list: the board, the feed, search, a company page, the dashboard.
   *
   * The card is an <article> whose TITLE is the link, stretched over the card — not one big
   * <a> — because a save button inside a link is a control inside a control: invalid, and a
   * click on the star would also open the job.
   *
   * Optional locals: `match` ({ score, reasons }) from the recommender, and `savedIds` (a
   * Set) — the star is offered only where the page passed one, so a list that never asked
   * for saved state does not show every job as unsaved.
   */
  const m = typeof match !== 'undefined' ? match : null;
  const saveState = typeof savedIds !== 'undefined' && savedIds ? savedIds : null;
  const isSaved = saveState ? saveState.has(job.id) : false;
  const rateText = formatRateRange(job);
  const place = jobLocation(job);
  const posted = postedAgo(job.published_at);
  const snippet = job.description_snippet ? toPlainText(job.description_snippet, 180) : '';
  // The role badge repeats the title when the title already names the role.
  const roleText = roleLabel(job.role);
  const roleInTitle = roleText && String(job.title || '').toLowerCase().includes(roleText.toLowerCase());
  const backTo = typeof returnUrl !== 'undefined' ? returnUrl : currentPath;
%>
<article class="glass-card job-card mb-3 <%= job.is_featured ? 'job-featured' : '' %>">
  <div class="card-body d-flex gap-3">
    <% if (job.company_logo) { %>
      <img class="logo-tile flex-shrink-0" src="<%= job.company_logo %>" alt="" loading="lazy">
    <% } else { %>
      <span class="logo-initials <%= companyTone(job.company_name) %> flex-shrink-0" aria-hidden="true"><%= companyInitials(job.company_name || 'Confidential') %></span>
    <% } %>
    <div class="flex-grow-1 min-w-0">
      <div class="d-flex justify-content-between align-items-start gap-2">
        <h3 class="mb-1 h6">
          <a class="stretched-link text-reset text-decoration-none" href="/jobs/<%= job.slug %>"><%= job.title %></a>
        </h3>
        <div class="job-card-side d-flex align-items-center gap-2 flex-shrink-0">
          <% if (m) { %>
            <span class="badge-hub match-badge" title="How well this role matches your profile"><%= m.score %>% match</span>
          <% } %>
          <% if (job.status && job.status !== 'open') { %>
            <span class="badge-hub muted"><%= job.status %></span>
          <% } %>
          <% if (saveState) { %>
            <% if (currentUser) { %>
              <form method="post" action="/jobs/<%= job.slug %>/save" class="job-save" data-save-job>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="saved" value="<%= isSaved ? 'true' : 'false' %>">
                <input type="hidden" name="redirectTo" value="<%= backTo %>">
                <button type="submit" class="btn-save <%= isSaved ? 'is-saved' : '' %>"
                        aria-pressed="<%= isSaved ? 'true' : 'false' %>"
                        aria-label="<%= isSaved ? 'Remove from saved jobs' : 'Save this job' %>"
                        title="<%= isSaved ? 'Saved' : 'Save' %>">
                  <i class="bi <%= isSaved ? 'bi-bookmark-star-fill' : 'bi-bookmark-star' %>" aria-hidden="true"></i>
                </button>
              </form>
            <% } else { %>
              <a class="btn-save" href="/auth/login?redirect=<%= encodeURIComponent(backTo) %>" aria-label="Sign in to save this job" title="Sign in to save">
                <i class="bi bi-bookmark-star" aria-hidden="true"></i>
              </a>
            <% } %>
          <% } %>
        </div>
      </div>
      <p class="small text-muted-2 mb-2">
        <%= job.company_name || 'Confidential' %><% if (place) { %> · <%= place %><% } %><% if (posted) { %> · <%= posted %><% } %>
      </p>
      <% if (snippet) { %>
        <p class="job-card-snippet small mb-2"><%= snippet %></p>
      <% } %>
      <% if (m && m.reasons && m.reasons.length) { %>
        <div class="d-flex flex-wrap gap-1 mb-2">
          <% m.reasons.forEach(function (r) { %><span class="badge-hub ok"><i class="bi bi-check2"></i> <%= r %></span><% }); %>
        </div>
      <% } %>
      <div class="d-flex flex-wrap gap-1">
        <%
          /*
           * A paid position in a list is LABELLED as one. The warm left edge alone would
           * be decoration a colour-blind reader cannot act on, and an unlabelled paid
           * placement is not an honest list.
           */
        %>
        <% if (job.is_featured) { %>
          <span class="badge-hub featured"><i class="bi bi-stars"></i> Featured</span>
        <% } %>
        <% if (!roleInTitle) { %><span class="badge-hub cloud"><%= roleText %></span><% } %>
        <span class="badge-hub"><%= seniorityLabel(job.seniority) %></span>
        <% if (job.work_mode !== 'remote') { %><span class="badge-hub"><%= workModeLabel(job.work_mode) %></span><% } %>
        <span class="badge-hub"><%= engagementLabel(job.engagement_type) %></span>
        <% if (rateText) { %><span class="badge-hub ok"><%= rateText %></span><% } %>
        <% if (job.duration_months) { %><span class="badge-hub"><%= job.duration_months %> months</span><% } %>
      </div>
    </div>
  </div>
</article>
