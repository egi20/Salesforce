<%- include('../partials/layout-start') %>

<%
  /*
   * Document Generator — the SOW pack, for a company buying work.
   *
   * Every claim here is a property of the code: the SOW lines come from SOW_INCLUDED, each tied
   * to a heading the generator writes (a test checks it); the cloud cards come from
   * config/cloudFamilies.js; the sample timeline is computed by the estimator at boot. Nothing
   * on this page can promise more than a download delivers. The consultant's CV has its own
   * page: /cv-generator.
   */
  const brandingHref = currentUser && currentUser.isCompany ? '/profile/company/template' : '/auth/register';
%>
<section class="hub-hero">
  <div class="container">
    <div class="row align-items-center g-4">
      <div class="col-lg-7">
        <span class="hub-hero-badge mb-3"><i class="bi bi-file-earmark-text"></i> SOW QUOTE GENERATOR</span>
        <h1>Get your SOW quote in minutes</h1>
        <p class="lead"><%= model.intro %></p>
        <ul class="cv-hero-tags list-unstyled">
          <li><i class="bi bi-check-circle-fill"></i> Estimates that reconcile</li>
          <li><i class="bi bi-check-circle-fill"></i> Built for Salesforce</li>
          <li><i class="bi bi-check-circle-fill"></i> SOW, Gantt &amp; deck</li>
        </ul>
        <div class="d-flex flex-wrap gap-3 mt-4">
          <a class="btn btn-lg btn-light" href="/quotes/new"><i class="bi bi-plus-lg"></i> Start new quote</a>
          <%# /quotes needs an account; a visitor following it lands on sign-in and comes back. %>
          <a class="btn btn-lg btn-outline-light" href="<%= currentUser ? '/quotes' : '/auth/login?redirect=%2Fquotes' %>"><i class="bi bi-clock-history"></i> Your quotes</a>
        </div>
      </div>
      <div class="col-lg-5 d-flex justify-content-center">
        <div class="sow-pack-card">
          <span class="sow-pack-icon" aria-hidden="true"><i class="bi bi-file-earmark-text"></i></span>
          <p class="sow-pack-title mb-1">SOW pack</p>
          <p class="sow-pack-files mb-0">.docx · .xlsx · .pptx</p>
          <p class="sow-pack-note mb-0">Statement of work, work breakdown with Gantt and a summary deck — from one estimate.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="glass-section pb-5">
<div class="container">

  <section aria-labelledby="how" class="mb-5">
    <h2 class="h4 text-center mb-4" id="how">How it works</h2>
    <ol class="row g-3 list-unstyled cv-steps">
      <li class="col-sm-6 col-lg-3"><div class="glass-card h-100 text-center"><div class="card-body">
        <span class="cv-step-n">1</span><h3 class="h6">Client info</h3>
        <p class="small text-muted-2 mb-0">Who the work is for, the project, the industry and the size of the business.</p>
      </div></div></li>
      <li class="col-sm-6 col-lg-3"><div class="glass-card h-100 text-center"><div class="card-body">
        <span class="cv-step-n">2</span><h3 class="h6">Scope</h3>
        <p class="small text-muted-2 mb-0">Clouds and modules, AppExchange add-ons and integrations — with a running total as you choose.</p>
      </div></div></li>
      <li class="col-sm-6 col-lg-3"><div class="glass-card h-100 text-center"><div class="card-body">
        <span class="cv-step-n">3</span><h3 class="h6">Review estimate</h3>
        <p class="small text-muted-2 mb-0">Man-days, phases, team, budget and timeline, reconciled line by line before you see them.</p>
      </div></div></li>
      <li class="col-sm-6 col-lg-3"><div class="glass-card h-100 text-center"><div class="card-body">
        <span class="cv-step-n">4</span><h3 class="h6">Download the pack</h3>
        <p class="small text-muted-2 mb-0">SOW, work breakdown and deck, generated on the spot with <a href="<%= brandingHref %>">your branding</a>.</p>
      </div></div></li>
    </ol>
  </section>

  <section aria-labelledby="clouds" class="mb-5">
    <h2 class="h4 text-center mb-1" id="clouds">Supported Salesforce clouds</h2>
    <p class="text-center text-muted-2 mb-4">Every module carries its own effort in days — the same catalogue the estimate is built from.</p>
    <div class="row g-3">
      <% cloudGroups.forEach(function (g, i) { %>
        <div class="col-md-4">
          <div class="sow-cloud-card h-100">
            <div class="sow-cloud-head tone-<%= i + 1 %>"><i class="bi <%= g.icon %>" aria-hidden="true"></i> <%= g.label %></div>
            <ul class="list-unstyled mb-0">
              <% g.families.forEach(function (f) { %>
                <li><span><%= f.label %></span> <span class="text-muted-2 small"><%= f.modules.length %> module<%= f.modules.length === 1 ? '' : 's' %></span></li>
              <% }); %>
            </ul>
          </div>
        </div>
      <% }); %>
    </div>
  </section>

  <section aria-labelledby="included" class="mb-5">
    <div class="row g-4 align-items-stretch">
      <div class="col-lg-8">
        <div class="glass-card h-100"><div class="card-body">
          <h2 class="h4 mb-3" id="included">What's included</h2>
          <div class="row g-4">
            <div class="col-md-6">
              <h3 class="h6 text-uppercase small fw-bold text-muted-2 mb-2">Statement of work (.docx)</h3>
              <ul class="sow-contents list-unstyled mb-0">
                <% model.included.sow.forEach(function (item) { %>
                  <li class="<%= item.optional ? 'is-optional' : '' %>">
                    <i class="bi <%= item.optional ? 'bi-plus-circle' : 'bi-check-circle-fill' %>" aria-hidden="true"></i>
                    <span><%= item.label %><% if (item.note) { %> <span class="text-muted-2">— <%= item.note %></span><% } %></span>
                  </li>
                <% }); %>
              </ul>
            </div>
            <div class="col-md-6">
              <h3 class="h6 text-uppercase small fw-bold text-muted-2 mb-2">Also in the pack</h3>
              <ul class="sow-contents list-unstyled mb-3">
                <% model.included.pack.forEach(function (item) { %>
                  <li>
                    <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                    <span><%= item.label %> <span class="text-muted-2">— <%= item.note %></span></span>
                  </li>
                <% }); %>
              </ul>
              <p class="small text-muted-2 mb-0"><i class="bi bi-plus-circle"></i> marks a section that appears only when you add it.</p>
            </div>
          </div>
        </div></div>
      </div>
      <div class="col-lg-4">
        <div class="sow-ready h-100">
          <span class="sow-pack-icon" aria-hidden="true"><i class="bi bi-rocket-takeoff"></i></span>
          <h2 class="h5 mb-2">Ready to get started?</h2>
          <p class="mb-4">An estimate takes a few minutes. The three documents are free with it.</p>
          <a class="btn btn-light btn-lg w-100" href="/quotes/new"><i class="bi bi-plus-lg"></i> Start new quote</a>
        </div>
      </div>
    </div>
  </section>

  <div class="glass-card mb-4"><div class="card-body">
    <div class="d-flex flex-wrap justify-content-between gap-2 mb-1">
      <h2 class="h6 mb-0">What the Gantt looks like</h2>
      <span class="small text-muted-2"><%= sample.weeks %> weeks</span>
    </div>
    <p class="small text-muted-2"><%= sample.scope %> — computed by the same estimator every quote uses.</p>
    <div class="sow-gantt" role="img" aria-label="Sample Gantt chart: <%= sample.timeline.map(function (t) { return t.phase + ', weeks ' + t.startWeek + ' to ' + t.endWeek; }).join('; ') %>">
      <% sample.timeline.forEach(function (t) {
           const left = ((t.startWeek - 1) / sample.weeks) * 100;
           const width = ((t.endWeek - t.startWeek + 1) / sample.weeks) * 100; %>
        <div class="sow-gantt-row">
          <span class="sow-gantt-label"><%= t.phase %></span>
          <span class="sow-gantt-track"><span class="sow-gantt-bar" style="left:<%= left.toFixed(2) %>%;width:<%= width.toFixed(2) %>%" title="<%= t.milestone %>"></span></span>
        </div>
      <% }); %>
      <div class="sow-gantt-row sow-gantt-axis">
        <span class="sow-gantt-label"></span>
        <span class="sow-gantt-track"><span>Week 1</span><span>Week <%= sample.weeks %></span></span>
      </div>
    </div>
  </div></div>

  <% if (model.aside) { %>
    <div class="glass-card"><div class="card-body d-flex flex-wrap align-items-center gap-3">
      <i class="bi bi-file-earmark-person fs-4 text-primary"></i>
      <span class="flex-grow-1"><%= model.aside.text %></span>
      <a class="btn btn-outline-primary btn-sm" href="<%= model.aside.href %>"><%= model.aside.label %></a>
    </div></div>
  <% } %>
</div>
</section>

<%- include('../partials/layout-end') %>
