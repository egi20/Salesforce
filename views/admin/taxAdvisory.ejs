<%- include('../partials/layout-start') %>

<%- include('../partials/page-header', {
  icon: 'bi-signpost-split',
  heading: 'Tax advisory enquiries',
  sub: 'Somebody asked a private question. Read it, route it, close it, and let it be deleted.'
}) %>

<section class="glass-section pb-5">
<div class="container">
  <%- include('../partials/flash') %>

  <%
    const topicLabel = (v) => (topics.find((t) => t.value === v) || { label: v }).label;
    const arrangementLabel = (v) => (arrangements.find((a) => a.value === v) || { label: v }).label;
  %>

  <div class="glass-card mb-4">
    <div class="card-body">
      <h2 class="h6">What this queue is, and what it is not</h2>
      <ul class="small text-muted-2 mb-0">
        <li>
          There is no saving on any of these records, because nothing here calculates one.
          What somebody keeps depends on their jurisdiction, their entity and their VAT
          position, and a figure that looks like tax advice but is a guess is worse than
          no figure.
        </li>
        <li>
          <strong>Introduced</strong> is the point the Hub's involvement ends. Anything
          after it happens between the enquirer and the specialist, under their terms.
        </li>
        <li>
          <strong>Closing</strong> releases the one-open-enquiry-per-address reservation,
          so the same person can come back later without hitting a duplicate.
        </li>
        <li>
          Every move is written to an append-only history with who made it and when.
        </li>
      </ul>
    </div>
  </div>

  <div class="glass-card mb-4">
    <div class="card-body">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
          <h2 class="h6 mb-1">Retention</h2>
          <p class="small text-muted-2 mb-0">
            The form promises deletion after <%= retentionDays %> days.
            <strong><%= duePurge %></strong> record<%= duePurge === 1 ? ' is' : 's are' %> past that now.
          </p>
        </div>
        <form method="post" action="/admin/tax-advisory/purge" class="mb-0">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-outline-danger btn-sm" type="submit" <%= duePurge === 0 ? 'disabled' : '' %>>
            <i class="bi bi-trash"></i> Delete them now
          </button>
        </form>
      </div>
    </div>
  </div>

  <form class="glass-card mb-4" method="get" action="/admin/tax-advisory">
    <div class="card-body">
      <div class="row g-2 align-items-end">
        <div class="col-md-3">
          <label class="form-label" for="f-status">Status</label>
          <select class="form-select form-select-sm" id="f-status" name="status">
            <option value="">Any</option>
            <% statuses.forEach(function (s) { %>
              <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-3">
          <label class="form-label" for="f-topic">Topic</label>
          <select class="form-select form-select-sm" id="f-topic" name="topic">
            <option value="">Any</option>
            <% topics.forEach(function (t) { %>
              <option value="<%= t.value %>" <%= filters.topic === t.value ? 'selected' : '' %>><%= t.label %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label" for="f-country">Country</label>
          <input class="form-control form-control-sm" id="f-country" name="country" maxlength="2"
                 value="<%= filters.country %>" placeholder="DE">
        </div>
        <div class="col-md-3">
          <label class="form-label" for="f-q">Name or email</label>
          <input class="form-control form-control-sm" id="f-q" name="q" value="<%= filters.q %>">
        </div>
        <div class="col-md-1">
          <button class="btn btn-primary btn-sm w-100" type="submit">Filter</button>
        </div>
      </div>
    </div>
  </form>

  <% if (!enquiries.length) { %>
    <div class="glass-card"><div class="card-body"><p class="text-muted-2 mb-0">Nothing matches.</p></div></div>
  <% } %>

  <% enquiries.forEach(function (e) { %>
    <div class="glass-card mb-3">
      <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-2">
          <div>
            <h2 class="h6 mb-1">
              #<%= e.id %> · <%= e.full_name %>
              <span class="badge-hub"><%= e.status %></span>
            </h2>
            <p class="small text-muted-2 mb-0">
              <a href="mailto:<%= e.email %>"><%= e.email %></a>
              <% if (e.phone) { %> · <%= e.phone %><% } %>
              · <%= e.country %>
              · <%= arrangementLabel(e.arrangement) %>
              · <%= topicLabel(e.topic) %>
            </p>
          </div>
          <div class="small text-muted-2 text-end">
            <div><%= new Date(e.created_at).toISOString().slice(0, 10) %></div>
            <div>consent <%= e.consent_version %></div>
          </div>
        </div>

        <p class="mb-3" style="white-space:pre-wrap"><%= e.question %></p>

        <% if (transitions[e.status] && transitions[e.status].length) { %>
          <form method="post" action="/admin/tax-advisory/<%= e.id %>/status" class="row g-2 align-items-end">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="col-md-3">
              <label class="form-label small" for="status-<%= e.id %>">Move to</label>
              <select class="form-select form-select-sm" id="status-<%= e.id %>" name="status" required>
                <% transitions[e.status].forEach(function (t) { %>
                  <option value="<%= t %>"><%= t %></option>
                <% }); %>
              </select>
            </div>
            <div class="col-md-7">
              <label class="form-label small" for="note-<%= e.id %>">Note (optional)</label>
              <input class="form-control form-control-sm" id="note-<%= e.id %>" name="note" maxlength="500">
            </div>
            <div class="col-md-2">
              <button class="btn btn-outline-primary btn-sm w-100" type="submit">Record</button>
            </div>
          </form>
        <% } else { %>
          <p class="small text-muted-2 mb-0">Closed. It will be deleted <%= retentionDays %> days after it arrived.</p>
        <% } %>
      </div>
    </div>
  <% }); %>

  <%- include('../partials/pagination', { pagination, pageUrl }) %>
</div>
</section>

<%- include('../partials/layout-end') %>
