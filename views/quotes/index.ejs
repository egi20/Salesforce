<%- include('../partials/layout-start') %>

<%- include('../partials/page-header', { heading: 'Quotes', sub: 'Scope estimates you have produced.' }) %>

<div class="container">
  <%- include('../partials/flash') %>

  <% if (stats.length) { %>
    <div class="row g-3 mb-4">
      <% stats.forEach(function (s) { %>
        <div class="col-6 col-lg-3">
          <div class="stat-tile">
            <div class="value"><%= s.count %></div>
            <div class="label"><%= s.status %> · <%= Math.round(Number(s.value)).toLocaleString('en-GB') %></div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>

  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <ul class="nav nav-pills">
      <li class="nav-item"><a class="nav-link <%= status === '' ? 'active' : '' %>" href="/quotes">All</a></li>
      <% statuses.forEach(function (s) { %>
        <li class="nav-item"><a class="nav-link <%= status === s ? 'active' : '' %>" href="/quotes?status=<%= s %>"><%= s %></a></li>
      <% }); %>
    </ul>
    <a class="btn btn-hub" href="/quotes/new"><i class="bi bi-plus-lg"></i> New estimate</a>
  </div>

  <% if (quotes.length === 0) { %>
    <div class="empty-state card-hub">
      <i class="bi bi-calculator"></i>
      <p class="mb-1">No estimates<%= status ? ' in this state' : ' yet' %>.</p>
      <a href="/quotes/new">Produce your first one</a>
    </div>
  <% } else { %>
    <div class="table-responsive card-hub">
      <table class="table align-middle mb-0">
        <thead>
          <tr>
            <th>Reference</th><th>Client</th><th>Project</th>
            <th class="text-end">Days</th><th class="text-end">Budget</th><th class="text-end">Weeks</th>
            <th>Status</th><th>Created</th>
          </tr>
        </thead>
        <tbody>
          <% quotes.forEach(function (q) { %>
            <tr>
              <td><a href="/quotes/<%= q.reference %>"><code><%= q.reference %></code></a></td>
              <td><%= q.client_company %></td>
              <td class="text-muted-2"><%= q.project_name %></td>
              <td class="text-end"><%= q.total_man_days %></td>
              <td class="text-end"><%= Math.round(Number(q.total_budget)).toLocaleString('en-GB') %> <%= q.currency %></td>
              <td class="text-end"><%= q.duration_weeks %></td>
              <td><span class="badge-hub <%= q.status === 'accepted' ? 'ok' : (q.status === 'declined' ? 'danger' : '') %>"><%= q.status %></span></td>
              <td class="small text-muted-2"><%= new Date(q.created_at).toISOString().slice(0, 10) %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <%- include('../partials/pagination') %>
  <% } %>
</div>

<%- include('../partials/layout-end') %>
