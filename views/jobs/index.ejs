<%- include('../partials/layout-start') %>

<%- include('../partials/page-header', { icon: 'bi-briefcase', heading: 'Salesforce jobs and contracts', sub: 'Contract and permanent roles across every cloud, filtered the way you search.' }) %>

<%
  /*
   * ONE form drives the whole board — the big search box, the sidebar and the sort control —
   * through the `form="jobFilters"` attribute, so a search never drops the ticked filters and
   * ticking a filter never drops the search. The save buttons on the cards are forms of their
   * own, which is why the rest are tied to this one by id rather than nested inside it.
   *
   * It works with scripting off: every control submits with the Apply button. public/js/main.js
   * adds applying on change, the role search, and saving without a reload.
   */
  const has = (list, value) => Array.isArray(list) && list.includes(value);
  const popular = facets.slice(0, 8);
%>

<section class="glass-section pb-5">
<div class="container">
  <%- include('../partials/flash') %>

  <div class="job-search glass-card mb-3" role="search">
    <div class="card-body d-flex flex-column flex-md-row gap-2">
      <label class="visually-hidden" for="jobSearch">Search jobs</label>
      <div class="job-search-field flex-grow-1">
        <i class="bi bi-search" aria-hidden="true"></i>
        <input class="form-control form-control-lg" id="jobSearch" name="q" form="jobFilters" type="search" maxlength="120"
               value="<%= filters.q %>" placeholder="Job title, skill or keyword — e.g. CPQ, Apex, Data Cloud">
      </div>
      <button class="btn btn-primary btn-lg px-4" type="submit" form="jobFilters">Search jobs</button>
    </div>
  </div>

  <% if (popular.length > 1) { %>
    <div class="popular-roles d-flex flex-wrap align-items-center gap-2 mb-4">
      <span class="small fw-semibold text-muted-2 me-1">Popular roles:</span>
      <% popular.forEach(function (f) { %>
        <a class="badge-hub cloud text-decoration-none <%= has(filters.role, f.role) ? 'is-active' : '' %>"
           href="/jobs?role=<%= encodeURIComponent(f.role) %>">
          <%= roleLabel(f.role) %><% if (f.count > 1) { %> <span class="opacity-75">(<%= f.count %>)</span><% } %>
        </a>
      <% }); %>
    </div>
  <% } %>

  <div class="row g-4">
    <aside class="col-lg-3">
      <div class="job-sidebar" data-sticky-sidebar>
      <%# On a phone the filters fold behind one button so the roles are not pushed a screen %>
      <%# down; main.js folds it on load there. Without scripting it stays open everywhere. %>
      <details class="filter-disclosure" open data-fold-below="992">
        <summary class="btn btn-outline-primary w-100 mb-3"><i class="bi bi-sliders"></i> Filters<% if (activeFilterCount) { %> (<%= activeFilterCount %>)<% } %></summary>
      <form class="glass-panel filter-panel" id="jobFilters" method="get" action="/jobs" data-auto-apply>
        <div class="filter-panel-body">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="mb-0">Filters</h2>
            <%# Always there, so it is where people look for it; inert when nothing is set. %>
            <% if (activeFilterCount) { %>
              <a class="small fw-semibold" href="/jobs">Clear all (<%= activeFilterCount %>)</a>
            <% } else { %>
              <span class="small text-muted-2" aria-disabled="true">Clear all</span>
            <% } %>
          </div>

          <fieldset class="filter-group">
            <legend>Role</legend>
            <label class="visually-hidden" for="roleSearch">Search roles</label>
            <input class="form-control form-control-sm mb-2" id="roleSearch" type="search" placeholder="Search roles…"
                   data-filter-list="#roleList" autocomplete="off">
            <div class="filter-scroll" id="roleList">
              <% roleCategories.forEach(function (cat) { %>
                <div class="filter-subgroup" data-filter-group>
                  <div class="filter-subhead"><%= cat.category %></div>
                  <% cat.roles.forEach(function (r) { %>
                    <%- include('_check', { name: 'role', value: r.value, id: 'role-' + r.value, label: r.label, count: roleCounts[r.value] || 0, ticked: has(filters.role, r.value), searchable: true }) %>
                  <% }); %>
                </div>
              <% }); %>
            </div>
          </fieldset>

          <fieldset class="filter-group">
            <legend>Country</legend>
            <% if (countryOptions.length === 0) { %>
              <p class="small text-muted-2 mb-0">No open role names a country yet.</p>
            <% } else { %>
              <div class="filter-scroll filter-scroll-sm">
                <% countryOptions.forEach(function (c) { %>
                  <%- include('_check', { name: 'country', value: c.code, id: 'country-' + c.code, label: countryName(c.code), count: c.count, ticked: has(filters.country, c.code) }) %>
                <% }); %>
              </div>
            <% } %>
          </fieldset>

          <fieldset class="filter-group">
            <legend>Seniority</legend>
            <% ['junior', 'mid', 'senior', 'lead'].forEach(function (v) { %>
              <%- include('_check', { name: 'seniority', value: v, id: 'sen-' + v, label: seniorityLabel(v, { full: true }), count: groupCounts.seniority[v] || 0, ticked: has(filters.seniority, v) }) %>
            <% }); %>
          </fieldset>

          <fieldset class="filter-group">
            <legend>Work mode</legend>
            <% ['remote', 'hybrid', 'onsite'].forEach(function (v) { %>
              <%- include('_check', { name: 'work_mode', value: v, id: 'mode-' + v, label: workModeLabel(v), count: groupCounts.work_mode[v] || 0, ticked: has(filters.work_mode, v) }) %>
            <% }); %>
          </fieldset>

          <fieldset class="filter-group">
            <legend>Engagement</legend>
            <% ['contract', 'permanent'].forEach(function (v) { %>
              <%- include('_check', { name: 'engagement_type', value: v, id: 'eng-' + v, label: engagementLabel(v), count: groupCounts.engagement_type[v] || 0, ticked: has(filters.engagement_type, v) }) %>
            <% }); %>
          </fieldset>

          <fieldset class="filter-group">
            <legend>Cloud / module</legend>
            <label class="visually-hidden" for="f-module">Cloud or module</label>
            <select class="form-select form-select-sm" id="f-module" name="module">
              <option value="">Any</option>
              <% cloudFamilies.forEach(function (f) { %>
                <optgroup label="<%= f.label %>">
                  <% f.modules.forEach(function (m) { %>
                    <option value="<%= m.value %>" <%= filters.module === m.value ? 'selected' : '' %>><%= m.label %></option>
                  <% }); %>
                </optgroup>
              <% }); %>
            </select>
          </fieldset>

          <fieldset class="filter-group">
            <legend>Posted</legend>
            <% postedWindows.forEach(function (w) { const id = 'posted-' + (w.value || 'any'); %>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="posted" value="<%= w.value %>" id="<%= id %>" <%= filters.posted === w.value ? 'checked' : '' %>>
                <label class="form-check-label" for="<%= id %>"><%= w.label %></label>
              </div>
            <% }); %>
          </fieldset>

          <fieldset class="filter-group mb-0">
            <legend>Minimum day rate</legend>
            <label class="visually-hidden" for="f-rate">Minimum day rate</label>
            <input class="form-control form-control-sm" id="f-rate" name="rate_min" type="number" min="0" step="1"
                   value="<%= filters.rate_min %>" placeholder="Any">
          </fieldset>
        </div>

        <%# For the no-script case only: with scripting every change applies itself, and %>
        <%# main.js removes this. %>
        <div class="filter-panel-actions" data-no-script-only>
          <button class="btn btn-primary w-100" type="submit">Show <%= pagination.total %> role<%= pagination.total === 1 ? '' : 's' %></button>
        </div>
      </form>
      </details>

      <div class="glass-card cv-promo mt-3 d-none d-lg-block">
        <div class="card-body">
          <span class="icon-tile icon-tile-sm icon-navyblue mb-2"><i class="bi bi-file-earmark-person"></i></span>
          <h2 class="h6 mb-1">Stand out in applications</h2>
          <p class="small text-muted-2 mb-3">A formatted CV and rate card, generated from your profile in one click — free.</p>
          <a class="btn btn-outline-primary btn-sm w-100"
             href="<%= currentUser && currentUser.isConsultant ? '/cv-generator' : '/cv-generator' %>">Build my free CV</a>
        </div>
      </div>
      </div>
    </aside>

    <div class="col-lg-9">
      <% if (recommended && recommended.jobs.length) { %>
        <section class="recommended mb-4" aria-labelledby="recommendedHeading">
          <div class="d-flex justify-content-between align-items-baseline mb-2">
            <h2 class="h5 mb-0" id="recommendedHeading"><i class="bi bi-stars"></i> Recommended for you</h2>
            <a class="small" href="/profile/settings">Based on your profile</a>
          </div>
          <div class="row g-3">
            <% recommended.jobs.forEach(function (r) { %>
              <div class="col-xl-6">
                <%- include('../partials/job-card', { job: r.job, match: { score: r.score, reasons: r.reasons } }) %>
              </div>
            <% }); %>
          </div>
        </section>
      <% } else if (recommended && recommended.profileIncomplete) { %>
        <div class="alert alert-info d-flex align-items-center gap-2 mb-4">
          <i class="bi bi-stars"></i>
          <span>Add your main role to your profile and we will show the roles that match you best.
            <a href="/profile/settings#basics">Complete your profile</a></span>
        </div>
      <% } else if (currentUser && !currentUser.isConsultant && pagination.page === 1) { %>
        <div class="match-teaser glass-card mb-4">
          <div class="card-body d-flex flex-column flex-md-row align-items-md-center gap-3">
            <span class="icon-tile icon-tile-sm icon-navyblue flex-shrink-0"><i class="bi bi-stars"></i></span>
            <p class="mb-0 flex-grow-1"><strong>Recommendations are for consultant profiles.</strong> Add the consultant role to this account and every role gets a match score against your profile.</p>
            <a class="btn btn-outline-primary btn-sm flex-shrink-0" href="/profile/settings">Set up a consultant profile</a>
          </div>
        </div>
      <% } else if (!currentUser && pagination.page === 1) { %>
        <div class="match-teaser glass-card mb-4">
          <div class="card-body d-flex flex-column flex-md-row align-items-md-center gap-3">
            <span class="icon-tile icon-tile-sm icon-navyblue flex-shrink-0"><i class="bi bi-stars"></i></span>
            <p class="mb-0 flex-grow-1"><strong>See the roles that match you.</strong> Build a free profile and every role gets a match score against your role, seniority, skills and rate.</p>
            <a class="btn btn-primary btn-sm flex-shrink-0" href="/auth/register">Sign up free</a>
          </div>
        </div>
      <% } %>

      <%# The list and everything describing it, faded while a new filter loads (main.js). %>
      <div class="job-results" data-results aria-live="polite">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <p class="mb-0 text-muted-2"><strong><%= pagination.total %></strong> role<%= pagination.total === 1 ? '' : 's' %> found</p>
        <div class="d-flex align-items-center gap-2">
          <label class="form-label mb-0 small" for="sort">Sort</label>
          <select class="form-select form-select-sm" id="sort" name="sort" form="jobFilters" data-auto-apply-field>
            <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>Newest</option>
            <option value="rate_desc" <%= sort === 'rate_desc' ? 'selected' : '' %>>Highest rate</option>
            <option value="rate_asc" <%= sort === 'rate_asc' ? 'selected' : '' %>>Lowest rate</option>
          </select>
        </div>
      </div>

      <%
        /*
         * What is narrowing the list, where the list is: somebody who scrolled past the sidebar
         * can see it and undo one filter at a time. Each × is a plain link to the same page
         * minus that one value, so it works without scripting.
         */
      %>
      <% if (activeChips.length) { %>
        <div class="active-filters d-flex flex-wrap align-items-center gap-2 mb-3" aria-label="Active filters">
          <% activeChips.forEach(function (c) { %>
            <a class="filter-chip" href="<%= c.href %>" aria-label="Remove filter: <%= c.label %>">
              <%= c.label %> <i class="bi bi-x-lg" aria-hidden="true"></i>
            </a>
          <% }); %>
          <a class="small fw-semibold ms-1" href="/jobs">Clear all</a>
        </div>
      <% } else { %>
        <div class="mb-3"></div>
      <% } %>

      <% if (jobs.length === 0) { %>
        <div class="empty-state glass-card">
          <i class="bi bi-search"></i>
          <% if (activeChips.length) { %>
            <p class="fw-semibold mb-1">No roles match <%= activeChips.length === 1 ? 'this filter' : 'these ' + activeChips.length + ' filters' %>.</p>
            <p class="small mb-3">Remove one of the filters above to widen the search, or start again from every open role.</p>
            <a class="btn btn-primary btn-sm" href="/jobs">Clear filters</a>
          <% } else { %>
            <p class="fw-semibold mb-1">There are no open roles right now.</p>
            <p class="small mb-0">New roles appear here as soon as companies publish them.</p>
          <% } %>
        </div>
      <% } else { %>
        <% jobs.forEach(function (job) { %><%- include('../partials/job-card', { job: job }) %><% }); %>
        <%- include('../partials/pagination') %>
      <% } %>
      </div>
    </div>
  </div>
</div>
</section>

<%- include('../partials/layout-end') %>
