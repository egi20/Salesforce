<%- include('../partials/layout-start') %>

<%- include('../partials/page-header', { icon: 'bi-person-badge', heading: 'Build Your Professional Profile', sub: 'Create a compelling profile that showcases your expertise.' }) %>

<section class="glass-section pb-5">
<div class="container">
  <%- include('../partials/flash') %>

  <div class="glass-card mb-4">
    <div class="card-body">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-2">
        <div>
          <h2 class="h6 mb-1">Profile completeness — <%= profile.completeness %>%</h2>
          <p class="small text-muted-2 mb-0">
            <%= profile.completeness >= minCompleteness
                ? 'Complete enough to be listed publicly.'
                : 'Reach ' + minCompleteness + '% to be listed in the directory.' %>
          </p>
        </div>
        <form method="post" action="/profile/consultant/visibility" class="d-flex align-items-center gap-2">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" role="switch" id="is_public" name="is_public"
                   <%= profile.is_public ? 'checked' : '' %> onchange="this.form.submit()">
            <label class="form-check-label" for="is_public">Listed in the directory</label>
          </div>
        </form>
      </div>
      <div class="meter <%= profile.completeness >= minCompleteness ? 'ready' : '' %>">
        <i style="width:<%= profile.completeness %>%"></i>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-lg-8">
      <%
        const nameParts = String(currentUser.name || '').trim().split(/\s+/);
        const firstName = nameParts.shift() || '';
        const lastName = nameParts.join(' ');
      %>
      <form method="post" action="/profile/consultant" class="glass-card mb-4" id="consultantProfileForm">
        <div class="card-body">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-1">
            <h2 class="h6 mb-0"><i class="bi bi-person-badge"></i> Consultant Profile</h2>
            <button class="btn btn-outline-primary btn-sm" type="button" id="importCvBtn">
              <i class="bi bi-magic"></i> Import from CV
            </button>
          </div>
          <p class="small text-muted-2 mb-3">Add or update your professional details as a consultant.</p>
          <input class="d-none" id="cvImportFile" type="file" accept=".docx,.txt">
          <p class="small text-muted-2 mb-3 d-none" id="cvImportStatus"></p>

          <hr>
          <h2 class="h6 mb-3"><i class="bi bi-camera"></i> Profile Photo</h2>
          <div class="d-flex flex-wrap align-items-center gap-3 mb-4">
            <img class="avatar" style="width:96px;height:96px"
                 src="<%= profile.profile_picture || '/images/avatar-placeholder.svg' %>" alt="">
            <div>
              <div class="d-flex gap-2 mb-1">
                <button class="btn btn-outline-primary btn-sm" type="button" id="changePhotoBtn">
                  <i class="bi bi-upload"></i> Change Photo
                </button>
                <% if (profile.profile_picture) { %>
                  <button class="btn btn-outline-danger btn-sm" type="button" id="removePhotoBtn">
                    <i class="bi bi-trash"></i> Remove
                  </button>
                <% } %>
              </div>
              <p class="small text-muted-2 mb-0">JPG, PNG, WebP or GIF. Max 5MB. Recommended: 400&times;400px</p>
            </div>
          </div>
          <input class="d-none" id="photoFile" type="file" accept="image/*">

          <hr>
          <div class="row g-2 mb-3">
            <div class="col-md-6">
              <label class="form-label" for="given_name">Your First Name *</label>
              <input class="form-control" id="given_name" name="given_name" maxlength="100" required value="<%= firstName %>">
            </div>
            <div class="col-md-6">
              <label class="form-label" for="family_name">Your Last Name *</label>
              <input class="form-control" id="family_name" name="family_name" maxlength="100" required value="<%= lastName %>">
            </div>
          </div>

          <div class="row g-2 mb-3">
            <div class="col-md-6">
              <label class="form-label" for="phone">Phone</label>
              <input class="form-control" id="phone" name="phone" type="tel" maxlength="40" value="<%= profile.phone || '' %>">
            </div>
            <div class="col-md-6">
              <label class="form-label" for="headline">Title</label>
              <input class="form-control" id="headline" name="headline" maxlength="200"
                     value="<%= profile.headline || '' %>" placeholder="Senior CPQ consultant, 8 years, remote across EU">
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label" for="bio">Bio</label>
            <textarea class="form-control" id="bio" name="bio" rows="8"><%= profile.bio || '' %></textarea>
          </div>

          <div class="row g-2 mb-3">
            <div class="col-md-6">
              <label class="form-label" for="primary_role">Primary role</label>
              <select class="form-select" id="primary_role" name="primary_role">
                <option value="">Choose</option>
                <% roleCategories.forEach(function (cat) { %>
                  <optgroup label="<%= cat.category %>">
                    <% cat.roles.forEach(function (r) { %>
                      <option value="<%= r.value %>" <%= profile.primary_role === r.value ? 'selected' : '' %>><%= r.label %></option>
                    <% }); %>
                  </optgroup>
                <% }); %>
              </select>
            </div>
            <div class="col-md-3">
              <label class="form-label" for="seniority">Seniority</label>
              <select class="form-select" id="seniority" name="seniority">
                <option value="">Choose</option>
                <% ['junior','mid','senior','lead'].forEach(function (s) { %>
                  <option value="<%= s %>" <%= profile.seniority === s ? 'selected' : '' %>><%= s %></option>
                <% }); %>
              </select>
            </div>
            <div class="col-md-3">
              <label class="form-label" for="years_experience">Years</label>
              <input class="form-control" id="years_experience" name="years_experience" type="number" min="0" max="60"
                     value="<%= profile.years_experience || '' %>">
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label" for="skills">Skills</label>
            <input class="form-control" id="skills" name="skills"
                   value="<%= skills.map(function (s) { return s.name; }).join(', ') %>"
                   placeholder="Apex, LWC, CPQ, Flow, Data Cloud">
            <p class="form-text">Comma separated. These drive matching and employer filters.</p>
          </div>

          <hr>
          <h2 class="h6 mb-3">Location and availability</h2>

          <div class="row g-2 mb-3">
            <div class="col-md-4">
              <label class="form-label" for="country">Country</label>
              <select class="form-select" id="country" name="country">
                <option value="">Choose</option>
                <% countries.forEach(function (c) { %>
                  <option value="<%= c.code %>" <%= profile.country === c.code ? 'selected' : '' %>><%= c.name %></option>
                <% }); %>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label" for="city">City</label>
              <input class="form-control" id="city" name="city" value="<%= profile.city || '' %>">
            </div>
            <div class="col-md-4">
              <label class="form-label" for="work_mode">Work mode</label>
              <select class="form-select" id="work_mode" name="work_mode">
                <% ['remote','hybrid','onsite'].forEach(function (m) { %>
                  <option value="<%= m %>" <%= profile.work_mode === m ? 'selected' : '' %>><%= m %></option>
                <% }); %>
              </select>
            </div>
          </div>

          <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" id="willing_to_travel" name="willing_to_travel"
                   <%= profile.willing_to_travel ? 'checked' : '' %>>
            <label class="form-check-label" for="willing_to_travel">Willing to travel</label>
          </div>

          <div class="row g-2 mb-3">
            <div class="col-md-3">
              <label class="form-label" for="day_rate">Day rate</label>
              <input class="form-control" id="day_rate" name="day_rate" type="number" min="0" step="10"
                     value="<%= profile.day_rate ? Math.round(profile.day_rate) : '' %>">
            </div>
            <div class="col-md-3">
              <label class="form-label" for="currency">Currency</label>
              <select class="form-select" id="currency" name="currency">
                <% ['EUR','USD','GBP','CHF'].forEach(function (c) { %>
                  <option value="<%= c %>" <%= profile.currency === c ? 'selected' : '' %>><%= c %></option>
                <% }); %>
              </select>
            </div>
            <div class="col-md-3">
              <label class="form-label" for="availability">Availability</label>
              <select class="form-select" id="availability" name="availability">
                <option value="not_available" <%= profile.availability === 'not_available' ? 'selected' : '' %>>Not available</option>
                <option value="immediate" <%= profile.availability === 'immediate' ? 'selected' : '' %>>Immediately</option>
                <option value="two_weeks" <%= profile.availability === 'two_weeks' ? 'selected' : '' %>>Within 2 weeks</option>
                <option value="one_month" <%= profile.availability === 'one_month' ? 'selected' : '' %>>Within a month</option>
              </select>
            </div>
            <div class="col-md-3">
              <label class="form-label" for="available_from">From</label>
              <input class="form-control" id="available_from" name="available_from" type="date"
                     value="<%= profile.available_from ? new Date(profile.available_from).toISOString().slice(0,10) : '' %>">
            </div>
          </div>

          <hr>
          <h2 class="h6 mb-3">Links</h2>
          <div class="row g-2 mb-3">
            <div class="col-md-4">
              <label class="form-label" for="linkedin_url">LinkedIn</label>
              <input class="form-control" id="linkedin_url" name="linkedin_url" type="url" value="<%= profile.linkedin_url || '' %>">
            </div>
            <div class="col-md-4">
              <label class="form-label" for="trailblazer_url">Trailblazer</label>
              <input class="form-control" id="trailblazer_url" name="trailblazer_url" type="url" value="<%= profile.trailblazer_url || '' %>">
            </div>
            <div class="col-md-4">
              <label class="form-label" for="website_url">Website</label>
              <input class="form-control" id="website_url" name="website_url" type="url" value="<%= profile.website_url || '' %>">
            </div>
          </div>

          <button class="btn btn-primary" type="submit">Save profile</button>
          <a class="btn btn-outline-primary" href="/consultants/<%= profile.user_id %>">Preview</a>
        </div>
      </form>
    </div>

    <div class="col-lg-4">
      <div class="glass-card mb-4">
        <div class="card-body">
          <h2 class="h6 mb-2">Certifications</h2>
          <% if (certifications.length) { %>
            <ul class="list-unstyled small mb-3">
              <% certifications.forEach(function (c) { %>
                <li class="d-flex justify-content-between align-items-center mb-1">
                  <span><i class="bi bi-patch-check text-success"></i> <%= c.name %></span>
                  <form method="post" action="/profile/consultant/certifications/<%= c.id %>/delete">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn-sm btn-link text-danger p-0" type="submit" aria-label="Remove">&times;</button>
                  </form>
                </li>
              <% }); %>
            </ul>
          <% } %>
          <form method="post" action="/profile/consultant/certifications">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label class="form-label" for="cert-name">Add a certification</label>
            <select class="form-select mb-2" id="cert-name" name="name" required>
              <option value="">Choose</option>
              <% certificationGroups.forEach(function (g) { %>
                <optgroup label="<%= g.group %>">
                  <% g.items.forEach(function (i) { %><option value="<%= i %>"><%= i %></option><% }); %>
                </optgroup>
              <% }); %>
            </select>
            <input class="form-control form-control-sm mb-2" name="earned_on" type="date" aria-label="Earned on">
            <button class="btn btn-outline-primary w-100 btn-sm" type="submit">Add</button>
          </form>
        </div>
      </div>

      <div class="glass-card">
        <div class="card-body">
          <h2 class="h6 mb-2">Experience</h2>
          <% if (experiences.length) { %>
            <ul class="list-unstyled small mb-3">
              <% experiences.forEach(function (e) { %>
                <li class="d-flex justify-content-between align-items-start mb-2">
                  <span><strong><%= e.title %></strong><br><span class="text-muted-2"><%= e.company %></span></span>
                  <form method="post" action="/profile/consultant/experience/<%= e.id %>/delete">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn-sm btn-link text-danger p-0" type="submit" aria-label="Remove">&times;</button>
                  </form>
                </li>
              <% }); %>
            </ul>
          <% } %>
          <form method="post" action="/profile/consultant/experience">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input class="form-control form-control-sm mb-2" name="title" placeholder="Job title" required>
            <input class="form-control form-control-sm mb-2" name="company" placeholder="Company" required>
            <div class="row g-1 mb-2">
              <div class="col-6"><input class="form-control form-control-sm" name="started_on" type="date" required aria-label="Started"></div>
              <div class="col-6"><input class="form-control form-control-sm" name="ended_on" type="date" aria-label="Ended"></div>
            </div>
            <div class="form-check mb-2">
              <input class="form-check-input" type="checkbox" name="is_current" id="is_current">
              <label class="form-check-label small" for="is_current">Current role</label>
            </div>
            <button class="btn btn-outline-primary w-100 btn-sm" type="submit">Add</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4 mt-1">
    <div class="col-lg-7">
      <div class="glass-card">
        <div class="card-body">
          <h2 class="h6 mb-1">Delivery history</h2>
          <p class="small text-muted-2">
            The engagements themselves, as distinct from who employed you. On a contractor's
            CV this is the substance — which orgs, which clouds, what shipped — and through an
            agency the employer line is often the same name every time.
          </p>

          <% if (projects.length) { %>
            <ul class="list-unstyled small mb-3">
              <% projects.forEach(function (p) { %>
                <li class="d-flex justify-content-between align-items-start border-top py-2">
                  <span>
                    <strong><%= p.name %></strong>
                    <% if (p.client) { %><span class="text-muted-2"> · <%= p.client %></span><% } %>
                    <br>
                    <span class="text-muted-2">
                      <% if (p.cloud) { %><%= moduleLabel(p.cloud) || p.cloud %> · <% } %>
                      <% if (p.role) { %><%= roleLabel(p.role) %> · <% } %>
                      <%= p.started_on ? new Date(p.started_on).toISOString().slice(0, 7) : '' %>
                      <% if (p.ended_on) { %>– <%= new Date(p.ended_on).toISOString().slice(0, 7) %><% } else { %>– present<% } %>
                    </span>
                  </span>
                  <form method="post" action="/profile/consultant/projects/<%= p.id %>/delete">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn-sm btn-link text-danger p-0" type="submit" aria-label="Remove">&times;</button>
                  </form>
                </li>
              <% }); %>
            </ul>
          <% } %>

          <form method="post" action="/profile/consultant/projects">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="row g-2 mb-2">
              <div class="col-md-7">
                <label class="visually-hidden" for="proj-name">Engagement</label>
                <input class="form-control form-control-sm" id="proj-name" name="name"
                       placeholder="What it was, e.g. Quote-to-cash rollout" maxlength="200" required>
              </div>
              <div class="col-md-5">
                <label class="visually-hidden" for="proj-client">Client</label>
                <input class="form-control form-control-sm" id="proj-client" name="client"
                       placeholder="Client (optional)" maxlength="180">
              </div>
            </div>
            <div class="row g-2 mb-2">
              <div class="col-md-6">
                <label class="visually-hidden" for="proj-cloud">Cloud or module</label>
                <select class="form-select form-select-sm" id="proj-cloud" name="cloud">
                  <option value="">Cloud or module</option>
                  <% allModules.forEach(function (m) { %>
                    <option value="<%= m.value %>"><%= m.familyLabel %> — <%= m.label %></option>
                  <% }); %>
                </select>
              </div>
              <div class="col-md-6">
                <label class="visually-hidden" for="proj-role">Your role</label>
                <select class="form-select form-select-sm" id="proj-role" name="role">
                  <option value="">Your role</option>
                  <% roleCategories.forEach(function (cat) { %>
                    <optgroup label="<%= cat.category %>">
                      <% cat.roles.forEach(function (r) { %>
                        <option value="<%= r.value %>"><%= r.label %></option>
                      <% }); %>
                    </optgroup>
                  <% }); %>
                </select>
              </div>
            </div>
            <div class="row g-2 mb-2">
              <div class="col-6"><input class="form-control form-control-sm" name="started_on" type="date" aria-label="Started"></div>
              <div class="col-6"><input class="form-control form-control-sm" name="ended_on" type="date" aria-label="Ended"></div>
            </div>
            <div class="mb-2">
              <label class="visually-hidden" for="proj-description">What you did</label>
              <textarea class="form-control form-control-sm" id="proj-description" name="description" rows="3"
                        placeholder="What you actually did. This goes on the CV as you write it — nothing rewrites it."></textarea>
            </div>
            <button class="btn btn-outline-primary btn-sm" type="submit">Add engagement</button>
          </form>
        </div>
      </div>
    </div>

    <div class="col-lg-5">
      <div class="glass-card">
        <div class="card-body">
          <span class="icon-tile icon-navy mb-3"><i class="bi bi-file-earmark-arrow-down"></i></span>
          <h2 class="h6">Your documents</h2>
          <p class="small text-muted-2">
            A CV and a rate card, rendered from this profile. Nothing is summarised, rephrased or
            invented — what is written here is what comes out, so they are yours to edit freely.
            Generated on demand, never stored: the stale copy is the one you would eventually send.
          </p>
          <a class="btn btn-primary w-100 mb-2" href="/profile/consultant/download/package">
            <i class="bi bi-download"></i> Both, zipped
          </a>
          <div class="d-flex gap-2">
            <a class="btn btn-outline-primary btn-sm flex-grow-1" href="/profile/consultant/download/cv">CV (.docx)</a>
            <a class="btn btn-outline-primary btn-sm flex-grow-1" href="/profile/consultant/download/rate-card">Rate card (.docx)</a>
          </div>
          <hr>
          <p class="small text-muted-2 mb-0">
            Working out what to charge? The
            <a href="/rates/calculator">rate calculator</a> shows what a day rate is worth over a
            year once holiday, the bench and running costs come out of it.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
</section>

<%- include('../partials/layout-end') %>
