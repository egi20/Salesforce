{
  "name": "salesforce-hub",
  "version": "0.1.0",
  "description": "Salesforce Hub — marketplace, job board and rate index for the Salesforce consulting ecosystem",
  "main": "server.js",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "npm run migrate && node server.js",
    "dev": "nodemon server.js",
    "migrate": "node scripts/migrate.js up",
    "migrate:status": "node scripts/migrate.js status",
    "seed": "node scripts/seed-data.js",
    "wait-for-db": "node scripts/wait-for-db.js",
    "validate-boot": "node scripts/validate-boot.js",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,md}\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "connect-flash": "^0.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.17.3",
    "express-validator": "^7.0.1",
    "geoip-lite": "^2.0.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.5",
    "resend": "^6.9.2",
    "sanitize-html": "^2.17.4",
    "sharp": "^0.34.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^30.2.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.3.3",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testTimeout": 30000,
    "collectCoverageFrom": [
      "routes/**/*.js",
      "models/**/*.js",
      "utils/**/*.js",
      "middleware/**/*.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ]
  },
  "overrides": {
    "htmlparser2": "^9.1.0"
  }
}
