<%- include('../partials/layout-start') %>

<%- include('../partials/page-header', { icon: 'bi-briefcase', heading: 'Your jobs', sub: 'Publish, pause and close the roles you have posted.' }) %>

<section class="glass-section pb-5">
<div class="container">
  <%- include('../partials/flash') %>

  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <ul class="nav nav-pills">
      <% ['open','draft','paused','filled','closed'].forEach(function (s) { %>
        <li class="nav-item">
          <a class="nav-link <%= status === s ? 'active' : '' %>" href="/dashboard/jobs?status=<%= s %>"><%= s %></a>
        </li>
      <% }); %>
    </ul>
    <div class="d-flex gap-2">
      <a class="btn btn-outline-primary" href="/dashboard/applicants">Applicant board</a>
      <a class="btn btn-primary" href="/jobs/new">Post a role</a>
    </div>
  </div>

  <% if (jobs.length === 0) { %>
    <div class="empty-state glass-card"><i class="bi bi-briefcase"></i>No <%= status %> roles.</div>
  <% } else { %>
    <div class="glass-card mb-3">
      <div class="card-body">
        <form method="post" action="/jobs/bulk-status" class="d-flex flex-wrap align-items-end gap-2">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="status_filter" value="<%= status %>">
          <!--
            The interlock. This is the count the screen is showing right now. If the
            filtered set has changed by the time this is submitted, the server aborts
            with a 409 instead of acting on rows that were never displayed.
          -->
          <input type="hidden" name="expected_count" value="<%= expectedCount %>">
          <div>
            <label class="form-label mb-1" for="bulk-status">Bulk action on all <%= expectedCount %> <%= status %> role(s)</label>
            <select class="form-select" id="bulk-status" name="status">
              <option value="paused">Pause them</option>
              <option value="open">Publish them</option>
              <option value="closed">Close them</option>
            </select>
          </div>
          <button class="btn btn-outline-primary" type="submit">Apply</button>
        </form>
      </div>
    </div>

    <div class="table-responsive glass-card">
      <table class="table align-middle mb-0">
        <thead>
          <tr><th>Role</th><th>Status</th><th>Applicants</th><th class="text-end">Views</th><th></th></tr>
        </thead>
        <tbody>
          <% jobs.forEach(function (job) { %>
            <tr>
              <td>
                <a href="/jobs/<%= job.slug %>"><%= job.title %></a>
                <div class="small text-muted-2"><%= roleLabel(job.role) %> · <%= seniorityLabel(job.seniority) %></div>
              </td>
              <td><span class="badge-hub"><%= job.status %></span></td>
              <%
                /*
                 * THE ONLY WAY INTO THE PIPELINE WAS A BARE NUMBER.
                 *
                 * `/applications/job/:slug` has always existed — a filtered list, the status
                 * transitions and an event log — but the link to it was the applicant count
                 * rendered as a plain digit in a table cell. It was read as a statistic, and
                 * the feature was reported as missing. A count is not an affordance: what
                 * you can do with it has to be written on it.
                 */
              %>
              <td>
                <% if (job.application_count > 0) { %>
                  <a class="btn btn-sm btn-primary" href="/applications/job/<%= job.slug %>">
                    Review <%= job.application_count %> applicant<%= job.application_count === 1 ? '' : 's' %>
                  </a>
                <% } else { %>
                  <span class="small text-muted-2">None yet</span>
                <% } %>
              </td>
              <td class="text-end text-muted-2"><%= job.view_count || 0 %></td>
              <td class="text-end"><a class="btn btn-sm btn-outline-primary" href="/jobs/<%= job.slug %>/edit">Edit</a></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <%- include('../partials/pagination') %>
  <% } %>
</div>
</section>

<%- include('../partials/layout-end') %>
