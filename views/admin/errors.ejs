<%- include('../partials/layout-start') %>

<%- include('../partials/page-header', { icon: 'bi-exclamation-triangle', heading: 'Error log' }) %>

<section class="glass-section pb-5">
<div class="container">
  <%- include('./_tabs', { current: 'errors' }) %>
  <%- include('../partials/flash') %>

  <% if (errors.length) { %>
    <p class="text-end mb-2">
      <%# Without stack traces, and with formula-like cells neutralised (utils/csv.js). %>
      <a class="btn btn-sm btn-outline-primary" href="/admin/errors/export.csv"><i class="bi bi-download"></i> Export CSV</a>
    </p>
  <% } %>
  <% if (errors.length === 0) { %>
    <div class="empty-state glass-card"><i class="bi bi-check-circle"></i>No errors recorded.</div>
  <% } else { %>
    <div class="glass-card">
      <div class="accordion accordion-flush" id="errAcc">
        <% errors.forEach(function (e, i) { %>
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#err<%= i %>">
                <span class="badge-hub danger me-2"><%= e.status_code %></span>
                <span class="text-truncate"><%= e.message %></span>
                <span class="ms-auto small text-muted-2"><%= new Date(e.created_at).toISOString().slice(0, 16).replace('T', ' ') %></span>
              </button>
            </h2>
            <div id="err<%= i %>" class="accordion-collapse collapse" data-bs-parent="#errAcc">
              <div class="accordion-body">
                <p class="small mb-1"><strong><%= e.method %></strong> <code><%= e.path %></code></p>
                <% if (e.user_id) { %><p class="small mb-1">User #<%= e.user_id %></p><% } %>
                <% if (e.stack) { %><pre class="small bg-light p-2 rounded" style="white-space:pre-wrap"><%= e.stack %></pre><% } %>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
    <%- include('../partials/pagination') %>

    <% if (currentUser && currentUser.isSuperadmin) { %>
      <div class="glass-card mt-4">
        <div class="card-body">
          <h2 class="h6">Housekeeping</h2>
          <p class="small text-muted-2">
            The table grows without bound, and an error log too big to load is an error log
            nobody reads. This is the one action on this screen that cannot be undone, which
            is why the retention window is a fixed choice rather than a number you type — an
            <code>INTERVAL 0 DAY</code> would take everything.
          </p>
          <form method="post" action="/admin/errors/purge" class="d-flex gap-2 align-items-end">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div>
              <label class="form-label" for="days">Delete entries older than</label>
              <select class="form-select" id="days" name="days">
                <option value="30">30 days</option>
                <option value="90" selected>90 days</option>
                <option value="180">180 days</option>
                <option value="365">365 days</option>
              </select>
            </div>
            <button class="btn btn-outline-primary" type="submit">Purge</button>
          </form>
        </div>
      </div>
    <% } %>
  <% } %>
</div>
</section>

<%- include('../partials/layout-end') %>
