<%- include('../partials/layout-start') %>

<%- include('../partials/page-header', {
  icon: 'bi-check2-square',
  heading: 'Test run',
  sub: new Date(run.ranAt).toISOString().slice(0, 16).replace('T', ' ') + ' UTC' + (run.runByName ? ' · started by ' + run.runByName : '')
}) %>

<% const failed = run.total - run.passed; %>

<section class="glass-section pb-5">
<div class="container">
  <%- include('./_tabs', { current: 'tests' }) %>
  <%- include('../partials/flash') %>

  <p class="mb-3"><a href="/admin/tests"><i class="bi bi-arrow-left" aria-hidden="true"></i> All test cases</a></p>

  <div class="row g-3 mb-4">
    <div class="col-6 col-lg-4"><div class="stat-tile"><div class="value"><%= run.passed %>/<%= run.total %></div><div class="label">passed</div></div></div>
    <div class="col-6 col-lg-4"><div class="stat-tile"><div class="value <%= failed ? 'text-danger' : '' %>"><%= failed %></div><div class="label">failed</div></div></div>
    <div class="col-6 col-lg-4"><div class="stat-tile"><div class="value"><%= (run.durationMs / 1000).toFixed(1) %>s</div><div class="label">total request time</div></div></div>
  </div>

  <div class="glass-card">
    <div class="table-responsive">
      <table class="table table-sm align-middle mb-0">
        <thead><tr><th scope="col">Result</th><th scope="col">Case</th><th scope="col">Expected</th><th scope="col">Got</th><th scope="col">Time</th></tr></thead>
        <tbody>
          <%# Failures first would reorder the run; the order it ran in is the order it is read in. %>
          <% run.results.forEach(function (r) { %>
            <tr>
              <td><span class="badge-hub <%= r.passed ? 'ok' : 'danger' %>"><%= r.passed ? 'passed' : 'failed' %></span></td>
              <td><%= r.name %><div class="small text-muted-2"><%= r.category %> · <%= r.method %> <code><%= r.endpoint %></code></div></td>
              <td><%= r.expected_status %></td>
              <td class="<%= r.passed ? '' : 'text-danger' %>"><%= r.actual_status || (r.error ? 'error: ' + r.error : '—') %></td>
              <td class="text-nowrap small text-muted-2"><%= r.duration_ms %> ms</td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>
</section>

<%- include('../partials/layout-end') %>
