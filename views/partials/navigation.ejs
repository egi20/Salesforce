<a class="skip-link" href="#main">Skip to content</a>
<nav class="navbar navbar-expand-lg navbar-hub sticky-top" aria-label="Main">
  <div class="container">
    <a class="navbar-brand d-inline-flex align-items-center gap-2" href="/">
      <%# Decorative: the wordmark beside it already names the site, so a screen reader %>
      <%# announcing both would read it twice. %>
      <img src="/images/logo-mark.svg" alt="" width="28" height="28" class="brand-mark" aria-hidden="true">
      <span>Salesforce<span class="cloud">Hub</span></span>
    </a>
    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
            aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="mainNav">
      <%
        /*
         * Grouped into hubs rather than one flat row.
         *
         * A flat list grows until nothing in it is findable. Grouping by WHO the item is
         * for — someone looking for work, someone hiring — means a person only ever reads
         * the half that is theirs. Items behind a sign-in appear only when signed in;
         * showing them to a stranger and then bouncing them to a login is a worse
         * experience than not offering them.
         */
        const path = currentPath;
        const startsWith = (p) => path === p || path.startsWith(p + '/');
        const isConsultantArea = startsWith('/jobs') || startsWith('/rates') || startsWith('/tax-advisory')
          || (currentUser && startsWith('/profile/consultant'));
        const isCompanyArea = startsWith('/consultants') || startsWith('/companies') || startsWith('/recruiters')
          || (currentUser && startsWith('/quotes'));
      %>

      <ul class="navbar-nav mx-lg-auto align-items-lg-center">
        <li class="nav-item">
          <a class="nav-link <%= path === '/' ? 'active' : '' %>" href="/"><i class="bi bi-house"></i> Home</a>
        </li>

        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle <%= isConsultantArea ? 'active' : '' %>" href="#" role="button"
             data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
            <i class="bi bi-person-badge"></i> Consultant Hub
          </a>
          <ul class="dropdown-menu shadow-sm">
            <% if (currentUser) { %>
              <li><a class="dropdown-item" href="/dashboard"><i class="bi bi-speedometer2"></i> Consultant Hub</a></li>
            <% } %>
            <li><a class="dropdown-item" href="/jobs"><i class="bi bi-briefcase"></i> Find Jobs</a></li>
            <% if (currentUser) { %>
              <li><a class="dropdown-item" href="/dashboard/saved"><i class="bi bi-bookmark"></i> Saved Jobs</a></li>
              <li><a class="dropdown-item" href="/profile/consultant"><i class="bi bi-person-gear"></i> Build Profile</a></li>
              <li><a class="dropdown-item" href="/profile/consultant/download/package"><i class="bi bi-file-earmark-arrow-down"></i> CV Generator</a></li>
            <% } %>
          </ul>
        </li>

        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle <%= isCompanyArea ? 'active' : '' %>" href="#" role="button"
             data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
            <i class="bi bi-building"></i> Companies Hub
          </a>
          <ul class="dropdown-menu shadow-sm">
            <% if (currentUser) { %>
              <li><a class="dropdown-item" href="/dashboard"><i class="bi bi-speedometer2"></i> Company Hub</a></li>
            <% } %>
            <li><a class="dropdown-item" href="/consultants"><i class="bi bi-people"></i> Browse Talent</a></li>
            <% if (currentUser) { %>
              <li><a class="dropdown-item" href="/quotes/new"><i class="bi bi-file-earmark-text"></i> Get SOW Quote</a></li>
              <li><a class="dropdown-item" href="/services/staff-augmentation"><i class="bi bi-people"></i> Staff Augmentation</a></li>
              <li><a class="dropdown-item" href="/services/project-based"><i class="bi bi-kanban"></i> Project-Based</a></li>
              <li><a class="dropdown-item" href="/services/managed-services"><i class="bi bi-gear"></i> Managed Services</a></li>
            <% } %>
          </ul>
        </li>

        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle <%= startsWith('/quotes') ? 'active' : '' %>" href="#" role="button"
             data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
            <i class="bi bi-tools"></i> Services
          </a>
          <ul class="dropdown-menu shadow-sm">
            <li><a class="dropdown-item" href="/tax-advisory"><i class="bi bi-signpost-split"></i> Tax Advisory</a></li>
            <li><a class="dropdown-item" href="/rates"><i class="bi bi-graph-up"></i> Rate &amp; Salary Index</a></li>
            <li><a class="dropdown-item" href="/quotes/new"><i class="bi bi-calculator"></i> SOW Generator</a></li>
            <li><a class="dropdown-item" href="/services/document-generator"><i class="bi bi-file-earmark-text"></i> Document Generator</a></li>
            <li><a class="dropdown-item" href="/services/dedupe"><i class="bi bi-layers"></i> Dedupe</a></li>
          </ul>
        </li>

        <li class="nav-item">
          <a class="nav-link <%= startsWith('/faq') ? 'active' : '' %>" href="/faq"><i class="bi bi-info-circle"></i> About</a>
        </li>
      </ul>

      <%
        /*
         * <details>/<summary> rather than a JS-toggled dropdown: the browser opens and
         * closes the panel natively, so with scripting off the search field is still one
         * click away instead of permanently hidden. The form inside still just GETs
         * /search — no token, because a search changes nothing.
         */
      %>
      <details class="nav-search me-lg-3 my-2 my-lg-0">
        <summary class="nav-search-toggle" aria-label="Search"><i class="bi bi-search"></i></summary>
        <form class="nav-search-panel shadow-sm" method="get" action="/search" role="search">
          <label class="visually-hidden" for="navSearch">Search the Hub</label>
          <input class="form-control nav-search-input" id="navSearch" name="q" type="search" maxlength="120"
                 value="<%= currentPath === '/search' && query && query.q ? query.q : '' %>"
                 placeholder="Search jobs, consultants, companies…" aria-label="Search the Hub">
          <p class="nav-search-hint">Search jobs, consultants, companies and community posts</p>
        </form>
      </details>

      <ul class="navbar-nav align-items-lg-center">
        <% if (currentUser) { %>
          <%
            const profileHref = currentUser.isCompany ? '/profile/company'
              : currentUser.isRecruiter ? '/recruiters/profile'
              : '/profile/consultant';
          %>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button"
               data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
              <img class="avatar" style="width:30px;height:30px"
                   src="<%= currentUser.profilePicture || '/images/avatar-placeholder-nav.svg' %>" alt="">
              <span class="d-none d-lg-inline"><%= currentUser.name %></span>
            </a>
            <div class="dropdown-menu dropdown-menu-end shadow-sm account-menu" id="accountMenu">
              <div class="account-menu-header">
                <img class="avatar" style="width:48px;height:48px"
                     src="<%= currentUser.profilePicture || '/images/avatar-placeholder-nav.svg' %>" alt="">
                <div class="account-menu-identity">
                  <div class="account-menu-name"><%= currentUser.name %></div>
                  <div class="account-menu-email"><%= currentUser.email %></div>
                  <div class="account-menu-badges">
                    <% if (currentUser.isConsultant) { %><span class="badge-hub cloud">CONSULTANT</span><% } %>
                    <% if (currentUser.isCompany) { %><span class="badge-hub cloud">COMPANY</span><% } %>
                    <% if (currentUser.isRecruiter) { %><span class="badge-hub cloud">RECRUITER</span><% } %>
                    <% if (currentUser.isPartner) { %><span class="badge-hub cloud">PARTNER</span><% } %>
                    <% if (currentUser.isAdmin) { %><span class="badge-hub cloud">ADMIN</span><% } %>
                  </div>
                </div>
              </div>

              <div class="account-menu-notifications">
                <div class="account-menu-notif-head">
                  <span><i class="bi bi-bell"></i> Notifications</span>
                  <span class="account-menu-notif-actions">
                    <a href="/notifications">Show all</a> ·
                    <form method="post" action="/notifications/read-all" class="d-inline" data-no-guard="true">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-link btn-sm p-0 align-baseline">Mark all read</button>
                    </form>
                  </span>
                </div>
                <div id="accountMenuNotifications">
                  <p class="account-menu-notif-empty"><i class="bi bi-bell-slash"></i>No new notifications</p>
                </div>
              </div>

              <div class="account-menu-quicklinks">
                <a href="/dashboard"><i class="bi bi-speedometer2"></i><span>Dashboard</span></a>
                <a href="<%= profileHref %>"><i class="bi bi-person"></i><span>Profile</span></a>
                <a href="/messages"><i class="bi bi-chat-dots"></i><span>Messages
                  <span class="notif-dot d-none" id="messageCount" aria-live="polite"></span></span></a>
                <a href="/profile/settings"><i class="bi bi-gear"></i><span>Settings</span></a>
              </div>

              <div class="account-menu-section-label"><i class="bi bi-person-badge"></i> Consultant</div>
              <a class="dropdown-item" href="/profile/consultant"><i class="bi bi-person-gear"></i> Build Profile</a>
              <a class="dropdown-item" href="/dashboard/applications"><i class="bi bi-send"></i> My Applications</a>
              <a class="dropdown-item" href="/profile/consultant/download/package"><i class="bi bi-file-earmark-arrow-down"></i> Documents</a>
              <a class="dropdown-item" href="/services/document-generator"><i class="bi bi-file-earmark-text"></i> Document Templates</a>
              <a class="dropdown-item" href="/dashboard/saved"><i class="bi bi-bookmark"></i> Saved Jobs</a>
              <a class="dropdown-item" href="/challenges"><i class="bi bi-trophy"></i> Challenges</a>

              <% if (currentUser.isCompany) { %>
                <div class="account-menu-section-label"><i class="bi bi-building"></i> Company</div>
                <a class="dropdown-item" href="/profile/company"><i class="bi bi-building-gear"></i> Company Profile</a>
                <a class="dropdown-item" href="/dashboard/jobs"><i class="bi bi-briefcase"></i> Your Roles</a>
                <a class="dropdown-item" href="/jobs/new"><i class="bi bi-plus-square"></i> Post a Role</a>
              <% } %>
              <% if (currentUser.isRecruiter) { %>
                <div class="account-menu-section-label"><i class="bi bi-person-rolodex"></i> Recruiter</div>
                <a class="dropdown-item" href="/recruiters/dashboard"><i class="bi bi-speedometer2"></i> Recruiter Dashboard</a>
                <a class="dropdown-item" href="/recruiters/profile"><i class="bi bi-building-gear"></i> Agency Profile</a>
              <% } %>

              <div class="account-menu-section-label"><i class="bi bi-graph-up-arrow"></i> Referrals</div>
              <a class="dropdown-item" href="/referrals"><i class="bi bi-speedometer2"></i> Agent Dashboard</a>
              <a class="dropdown-item" href="/referrals"><i class="bi bi-people"></i> My Leads</a>

              <form method="post" action="/auth/logout" data-no-guard="true">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="dropdown-item account-menu-signout" type="submit">
                  <i class="bi bi-box-arrow-right"></i> Sign Out
                </button>
              </form>
            </div>
          </li>
        <% } else { %>
          <li class="nav-item"><a class="nav-link" href="/auth/login">Sign in</a></li>
          <li class="nav-item ms-lg-2"><a class="btn btn-primary btn-sm" href="/auth/register">Join free</a></li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>
